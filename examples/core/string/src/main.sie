import std.io;
import { String } from std.collections;

fn main() -> i32 {
    // create an empty string
    let str1 = String();

    // append a string literal
    str1 += "hello";

    // print str1
    std.io.println(str1);
    
    // create a string from another
    let str2 = String(str1);

    // print the result of the equality check
    std.io.println("str1 == str2: {}", str1 == str2);
    
    // push a character literal
    str2 += ' ';
    
    // append a string literal
    str2 += "world";
    
    // print str2
    std.io.println(str2);

    // print the result of the equality check
    std.io.println("str1 == str2: {}", str1 == str2);
    
    // create a string from a literal
    let str3 = String("hello world");
    
    // print str3
    std.io.println(str3);

    // create an empty string
    let str4 = String();

    // append a string
    str4 += str3;

    // print str4
    std.io.println(str4);

    // create a string from adding another string and a string literal
    let str5 = str1 + ", world";

    // print str5
    std.io.println(str5);

    // create a string from adding another string and a string literal
    let str6 = "hello" + ", world";

    // print str6
    std.io.println(str6);

    std.io.println("{}", String("hello") == "hello");

    return 0;
}
