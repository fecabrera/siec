import std.io;
import { random, random_between, random_bool, random_probability } from std.random;
import { destructure_float } from std.format;

fn main() -> i32 {
    std.io.println("Random numbers:");
    for (let i: u64 = 0; i < 10; i += 1)
        std.io.println("  {}", random());

    std.io.println("Random numbers between 1 and 100:");
    for (let i: u64 = 0; i < 10; i += 1)
        std.io.println("  {}", random_between(1, 100));
    
    std.io.println("Random boolean:");
    for (let i: u64 = 0; i < 10; i += 1)
        std.io.println("  {}", random_bool());
    
    std.io.println("Random probability:");
    for (let i: u64 = 0; i < 10; i += 1) {
        let value = random_probability();
        let data = destructure_float(value);
        std.io.println("  {}", random_probability());
    }

    return 0;
}
