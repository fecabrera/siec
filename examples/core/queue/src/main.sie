import std.io;
import { Queue, String } from std.collections;

fn main() -> i32 {
    let q1 = Queue<String>();
    
    q1.push(String("hello"));
    q1.push(String("world"));
    
    std.io.println("q1");
    let index: u64 = 0;
    foreach (value : q1) {
        std.io.println("{}: {}", index, value);
        index += 1;
    }

    let q2 = q1.clone();

    std.io.println("q2");
    index = 0;
    foreach (value : q2) {
        std.io.println("{}: {}", index, value);
        index += 1;
    }

    return 0;
}
