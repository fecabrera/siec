import std.io;
import { Decimal } from std.decimal;

fn main(args: char*[]) -> i32 {
    if (args.length != 2) {
		std.io.println(std.io.stderr, "hash: usage: {} x", args[0]);
		return 1;
	}

    let dec = Decimal(args[1]);
    defer dec.destroy();

    std.io.println("{}", dec.hash());

    return 0;
}