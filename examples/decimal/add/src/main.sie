import std.io;
import { Decimal } from std.decimal;

fn main(args: const char*[]) -> i32 {
    if (args.length != 3) {
		std.io.println(std.io.stderr, "add: usage: {} x y", args[0]);
		return 1;
	}

    let a = Decimal(args[1]);
    let b = Decimal(args[2]);
    
    std.io.println("{}", a + b);

    return 0;
}