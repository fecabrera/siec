import Adw;
import Gtk;

fn main(argc: i32, argv: char**) -> i32 {
    let app = Adw.Application("com.example.GtkApplication");
    
    app.connect_activate(() => {
        let window = Adw.ApplicationWindow(app);
        window.set_title("Hello");
        window.set_default_size(600, 400);

        let toolbar_view = Adw.ToolbarView();
        let header_bar = Adw.HeaderBar();
        let button = Gtk.Button("Hello, World!");
        
        button.set_halign(Gtk.Align::CENTER);
        button.set_valign(Gtk.Align::CENTER);
        button.connect_clicked(() => window.close());
        
        toolbar_view.add_top_bar(header_bar);
        toolbar_view.set_content(button);
        
        window.set_content(toolbar_view);
        window.present();
    });

    return app.run(argc, argv);
}
