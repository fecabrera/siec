import std.io;
import { String } from std.collections;
import { format } from std.format;
import { Directory, Path, OpenError } from std.fs;
import { Archive, ArchiveMode } from archive.zip;

fn main(args: const char*[]) -> i32 {
    if (args.length < 2) {
        std.io.println(std.io.stderr, "usage: {} <input> [output]", args[0]);
        return 1;
    }

    // build input and output paths
    let input = String::null_terminated(args[1]);
    let output: String;
    if (args.length < 3) {
        output = format("{}.zip", Path::basename(input).split('.').first()).null_terminate();
    } else {
        output = String::null_terminated(args[2]);
    }

    // open zip archive from path
    let archive = try Archive::open(
        output.as_const_array(),
        ArchiveMode::Create | ArchiveMode::Truncate
    ) except (error) {
        std.io.println(std.io.stderr, "{}: {}", output, error);
        return 1;
    }
    defer archive.close();

    // check if input is dir
    let is_dir = try Path::is_dir(input) except (error) {
        std.io.println(std.io.stderr, "{}: {}", input, error);
        return 1;
    }
    
    if (is_dir) {
        // zip dir
        try zip_dir(archive, input, String::null_terminated("")) except (error) {
            std.io.println(std.io.stderr, "can't zip directory {}: {}", input, error);
            return 1;
        }
    } else {
        // build name
        let basename = Path::basename(input).null_terminate();

        // zip file
        try archive.add_file(input.as_const_array(), basename.as_const_array()) except (error) {
            std.io.println(std.io.stderr, "can't zip file {}: {}", input, error);
            return 1;
        }
    }

    return 0;
}

fn zip_dir(archive: &Archive, source: const &String, dest: const &String) -> Result<i32> {
    let dir = try Directory::open(source.as_const_array()) except (error) {
        std.io.println(std.io.stderr, "can't open directory {}: {}", source, error);
        return Error(1);
    }
    defer dir.close();

    foreach (entry : dir.iterator()) {
        let name = entry.get_const_array();
    
        // ignore . and ..
        if (name == "." or name == "..") continue;

        // build input and output paths
        let fullname = format("{}/{}", source, name).null_terminate();
        let path = dest ? format("{}/{}", dest, name).null_terminate() : String::null_terminated(name);

        // check if it's dir
        let is_dir = try Path::is_dir(fullname) except (error) {
            std.io.println(std.io.stderr, "{}: {}", fullname, error);
            return Error(1);
        }

        std.io.println("{} -> {}", fullname, path);
        
        if (is_dir) {
            // add dir
            try archive.add_dir(path.as_const_array()) except (error) {
                std.io.println(std.io.stderr, "can't add directory {}: {}", fullname, error);
                return Error(1);
            }
            
            // recursive
            try zip_dir(archive, fullname, path);
        } else {
            // add file
            try archive.add_file(fullname.as_const_array(), path.as_const_array()) except (error) {
                std.io.println(std.io.stderr, "can't add file {}: {}", fullname, error);
                return Error(1);
            }
        }
    }

    return Ok();
}
