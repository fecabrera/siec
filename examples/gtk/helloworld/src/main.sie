import gtk;

fn main(argc: i32, argv: char**) -> i32 {
    let app = gtk.Application("com.example.GtkApplication");
    
    app.connect_activate(() => {
        let window = gtk.ApplicationWindow(app);
        window.set_title("Hello");
        window.set_default_size(200, 200);

        let button = gtk.Button("Hello, World!");
        button.set_halign(gtk.GtkAlign::CENTER);
        button.set_valign(gtk.GtkAlign::CENTER);

        button.connect_clicked(() => {
            window.close();
        });

        window.set_child(button);
        window.present();
    });

    return app.run(argc, argv);
}
