import gtk;
import { G_APPLICATION, GApplicationFlags, g_application_run } from gio;
import { G_CALLBACK, g_signal_connect, g_signal_connect_swapped, g_object_unref } from gobject;

fn on_activate(app: gtk.GtkApplication*) {
    let window = gtk.gtk_application_window_new(app);
    gtk.gtk_window_set_title(gtk.GTK_WINDOW(window), "Hello");
    gtk.gtk_window_set_default_size(gtk.GTK_WINDOW(window), 200, 200);

    let button = gtk.gtk_button_new_with_label("Hello, World!");
    gtk.gtk_widget_set_halign(button, gtk.GtkAlign::CENTER);
    gtk.gtk_widget_set_valign(button, gtk.GtkAlign::CENTER);
    
    g_signal_connect_swapped(button, "clicked", G_CALLBACK(gtk.gtk_window_close), window);

    gtk.gtk_window_set_child(gtk.GTK_WINDOW(window), button);
    gtk.gtk_window_present(gtk.GTK_WINDOW(window));
}

fn main(argc: i32, argv: char**) -> i32 {
    let app = gtk.gtk_application_new("com.example.GtkApplication", GApplicationFlags::DEFAULT_FLAGS);
    defer g_object_unref(app);

    g_signal_connect(app, "activate", G_CALLBACK(on_activate), null);

    return g_application_run(G_APPLICATION(app), argc, argv);
}
