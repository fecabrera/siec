import { println } from std.io;
import { String } from std.collections;
import { TOMLObject, TOMLObjectType } from toml;

fn main() -> i32 {
    let obj = TOMLObject(TOMLObjectType::Table);
    defer obj.destroy();

    let v1 = TOMLObject(TOMLObjectType::Integer);
    v1.int = 5;

    obj.tab.set("hello", v1);
    
    let v2 = TOMLObject(TOMLObjectType::Array);
    obj.tab.set("world", v2);

    println("{}", obj);

    return 0;
}
