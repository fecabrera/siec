import { println } from std.io;
import { Decimal } from std.decimal;
import { String } from std.collections;
import { TOMLObject, TOMLObjectType } from toml;

fn main() -> i32 {
    let obj = TOMLObject::table();
    defer obj.destroy();

    obj.tab.set("hello", TOMLObject::integer(5));
    
    let v = TOMLObject::array();
    v.arr.push(TOMLObject::string("abc"));
    v.arr.push(TOMLObject::float("3.14159"));
    
    obj.tab.set("world", v);
    obj.tab.set("def", TOMLObject::bool(true));

    println("{}", obj);

    return 0;
}
