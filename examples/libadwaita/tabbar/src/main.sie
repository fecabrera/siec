import adwaita;
import gtk;

fn main(argc: i32, argv: char**) -> i32 {
    let app = adwaita.Application("com.example.GtkApplication");
    
    app.connect_activate(() => {
        let window = adwaita.ApplicationWindow(app);
        window.set_title("Hello");
        window.set_default_size(800, 600);

        let toolbar_view = adwaita.ToolbarView();
        let tab_bar = adwaita.TabBar();
        let tab_view = adwaita.TabView();
        let header_bar = adwaita.HeaderBar();
        
        let tab1 = tab_view.append(gtk.Label("Tab 1"));
        tab1.set_title("Tab 1");

        let tab2 = tab_view.append(gtk.Label("Tab 2"));
        tab2.set_title("Tab 2");
        
        tab_bar.set_autohide(false);
        tab_bar.set_view(tab_view);

        header_bar.set_title_widget(gtk.Widget(tab_bar.get_handle() as gtk.GtkWidget*));
        toolbar_view.add_top_bar(header_bar);
        toolbar_view.set_content(gtk.Widget(tab_view.get_handle() as gtk.GtkWidget*));
        
        window.set_content(toolbar_view);
        window.present();
    });

    return app.run(argc, argv);
}
