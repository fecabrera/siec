import gtk;
import adwaita;

fn main(argc: i32, argv: char**) -> i32 {
    let app = adwaita.Application("com.example.GtkApplication");
    
    app.connect_activate(() => {
        let window = adwaita.ApplicationWindow(app);
        window.set_title("Hello");
        window.set_default_size(800, 600);

        // sidebar
        let sidebar_view = adwaita.ToolbarView();

        let sidebar_header = adwaita.HeaderBar();
        sidebar_view.add_top_bar(sidebar_header);

        let sidebar = adwaita.Sidebar();
        sidebar_view.set_content(sidebar);

        // content
        let content_view = adwaita.ToolbarView();

        let content_header = adwaita.HeaderBar();
        content_view.add_top_bar(content_header);
        
        let button = gtk.Button("Hello, World!");
        button.set_halign(gtk.GtkAlign::CENTER);
        button.set_valign(gtk.GtkAlign::CENTER);
        button.connect_clicked(() => {
            window.close();
        });
        content_view.set_content(button);

        // split view
        let split_view = adwaita.NavigationSplitView();

        let sidebar_page = adwaita.NavigationPage(sidebar_view, "Sidebar");
        split_view.set_sidebar(sidebar_page);
        
        let content_page = adwaita.NavigationPage(content_view, "Content");
        split_view.set_content(content_page);
        
        window.set_content(split_view);
        window.present();
    });

    return app.run(argc, argv);
}
