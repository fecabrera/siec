/**
 * Add in place the value of the Decimal to the given Decimal.
 *
 * @param dec The Decimal to add to the current Decimal.
 * @return The result of the addition.
 */
fn Decimal::add_assign(&self, dec: const &Decimal) {
    mpdecimal.mpd_add(self.mpd, self.mpd, dec.mpd, self.ctx);
}

/**
 * Add in place the value of the Decimal to the given value.
 *
 * @param num The value to add to the current Decimal.
 * @return The result of the addition.
 */
fn Decimal::add_assign(&self, num: const i64) {
    mpdecimal.mpd_add_i64(self.mpd, self.mpd, num, self.ctx);
}

