/* The header API (header.h): access the response headers by name or in order */

@include("curl")

struct curl_header {
    name: char*;     /* this might not use the same case */
    value: char*;
    amount: u64;     /* number of headers using this name */
    index: u64;      /* ... of this instance, 0 or higher */
    origin: u32;     /* see the bits below */
    anchor: opaque*; /* handle privately used by libcurl */
}

/* 'origin' bits */
@const CURLH_HEADER  = 1 << 0; /* plain server header */
@const CURLH_TRAILER = 1 << 1; /* trailers */
@const CURLH_CONNECT = 1 << 2; /* CONNECT headers */
@const CURLH_1XX     = 1 << 3; /* 1xx headers */
@const CURLH_PSEUDO  = 1 << 4; /* pseudo headers */

enum CURLHcode {
    CURLHE_OK = 0,
    CURLHE_BADINDEX,      /* header exists but not with this index */
    CURLHE_MISSING,       /* no such header exists */
    CURLHE_NOHEADERS,     /* no headers at all exist (yet) */
    CURLHE_NOREQUEST,     /* no request with this number was used */
    CURLHE_OUT_OF_MEMORY, /* out of memory while processing */
    CURLHE_BAD_ARGUMENT,  /* a function argument was not okay */
    CURLHE_NOT_BUILT_IN,  /* if API was disabled in the build */
}

@extern fn curl_easy_header(easy: CURL*, name: const char*, index: u64, origin: u32, request: i32, hout: curl_header**) -> CURLHcode;
@extern fn curl_easy_nextheader(easy: CURL*, origin: u32, request: i32, prev: curl_header*) -> curl_header*;
