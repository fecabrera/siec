import { String } from std.collections;
import { OpenError, CloseError } from std.fs;
import { ArchiveMode, StatError } from enums;
import {
    ZIP,
    ZIP_ER,
    zip,
    zip_error,
    zip_get_error,
    zip_open,
    zip_close,
    zip_get_name,
    zip_get_num_entries,
} from zip;

/**
 * A ZIP archive.
 */
struct Archive {
    @private handle: zip* = null;       /* The underlying zip handle. */
    @private mode = ArchiveMode::None;  /* The mode of the archive. */

    /**
     * Builds the flags for the archive.
     * 
     * @param mode: The mode of the archive.
     * @returns The libzip flags for the archive.
     */
    @private
    fn build_flags(mode: ArchiveMode) -> i32 {
        let flags: i32 = 0;
        if (mode & ArchiveMode::Create)
            flags |= ZIP::CREATE;
        if ((mode & ArchiveMode::Read) and not (mode & ArchiveMode::Write))
            flags |= ZIP::RDONLY;
        if (mode & ArchiveMode::Truncate)
            flags |= ZIP::TRUNCATE;
        return flags;
    }

    /**
     * Opens a ZIP archive.
     * 
     * @param path: The path to the archive.
     * @param mode: The mode of the archive.
     * @returns The archive.
     */
    fn open(path: const &char[], mode: ArchiveMode) -> Result<Archive, OpenError> {
        let errorp: ZIP_ER;
        let flags = Archive::build_flags(mode);
        let handle = zip_open(path, flags, &errorp);
        if (handle == null) {
            case (errorp) {
            when ZIP_ER::NOENT:
                return Error(OpenError::NotFound);
            when ZIP_ER::EXISTS:
                return Error(OpenError::AlreadyExists);
            when ZIP_ER::NOZIP:
                return Error(OpenError::InvalidFile);
            else:
                return Error(OpenError::SystemError);
            }
        }
        return Ok({handle, mode});
    }

    /**
     * Closes a ZIP archive.
     * 
     * @returns The result of the operation.
     */
    fn close(&self) -> Result<CloseError> {
        if (self.handle == null) return Error(CloseError::AlreadyClosed);

        if (zip_close(self.handle) < 0) {
            let error = zip_get_error(self.handle);
            case (error->zip_err) {
            when ZIP_ER::NOZIP:
                return Error(OpenError::InvalidFile);
            else:
                return Error(CloseError::SystemError);
            }
        }
        
        self.handle = null;
        self.mode = ArchiveMode::None;
        
        return Ok();
    }

    /**
     * Gets the total number of entries in the archive.
     * 
     * @returns The total number of entries.
     */
    fn get_total_entries(&self) -> Result<u64, StatError> {
        if (self.handle == null) return Error(StatError::NotOpen);
        let n = zip_get_num_entries(self.handle, 0);
        if (n < 0) return Error(StatError::SystemError);
        return Ok(n as u64);
    }

    /**
     * Gets the name of the entry at the given index.
     * 
     * @param index: The index of the entry.
     * @returns The name of the entry.
     */
    fn get_entry_name(&self, index: u64) -> Result<String, StatError> {
        if (self.handle == null) return Error(StatError::NotOpen);
        let str = zip_get_name(self.handle, index, 0);
        if (str == null) {
            let error = zip_get_error(self.handle);
            case (error->zip_err) {
            when ZIP_ER::DELETED:
                return Error(StatError::Deleted);
            when ZIP_ER::INVAL:
                return Error(StatError::NotFound);
            else:
                return Error(StatError::SystemError);
            }
        }
        return Ok(String(str));
    }
}
