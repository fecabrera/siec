// example based on:
// https://blog.jyotiprakash.org/file-compression-and-decompression-in-c-using-zlib

import std.io;
import { File, FileMode, OpenError, CloseError } from std.fs;
import unistd;
import zlib;

/* Size in bytes of the input and output staging buffers. Data is streamed
   through zlib CHUNK bytes at a time so files of any size use constant memory. */
@const CHUNK = 16384;

fn main(argc: i32, argv: char**) -> i32 {
    let fnc: fn (&File, &File);

    while (true) {
        let opt = unistd.getopt(argc, argv, ":id");
        if (opt < 0) break;

        case (opt) {
        when 'i':
            fnc = decompress_file;
        when 'd':
            fnc = compress_file;
        else:
            std.io.println(std.io.stderr, "usage: {} [-i | -d] input output", argv[0]);
            return 1;
        }
    }

    if (argc - unistd.optind != 2) {
        std.io.println(std.io.stderr, "usage: {} [-i | -d] input output", argv[0]);
        return 1;
    }

    let input_path = argv[unistd.optind];
    let output_path = argv[unistd.optind + 1];

    let input = File(input_path, FileMode::Read);
    let in_res = input.open();
    if (not in_res.ok) {
        std.io.println(std.io.stderr, "{}: {}", input_path, in_res.error);
        return 1;
    }

    defer {
        input.close();
        input.destroy();
    }
    
    let output = File(output_path, FileMode::Write | FileMode::Create);
    let out_res = output.open();
    if (not out_res.ok) {
        std.io.println(std.io.stderr, "{}: {}", output_path, out_res.error);
        return 1;
    }

    defer {
        output.close();
        output.destroy();
    }

    fnc(input, output);

    return 0;
}

fn compress_file(src: &File, dst: &File) {
    let flush: zlib.z_flush;
    let have: u64;
    let next_in: u8[CHUNK];
    let next_out: u8[CHUNK];
    let strm: zlib.z_stream = {
        zalloc = null,
        zfree = null,
        opaque = null,
    };
        
    let ret = zlib.deflateInit(&strm, zlib.z_level::Z_DEFAULT_COMPRESSION);
    if (ret != zlib.z_status::Z_OK) {
        std.io.println(std.io.stderr, "deflateInit() returned {}: {}", ret, strm.msg);
        return;
    }
    
    defer zlib.deflateEnd(&strm); // cleanup on every exit path

    while (true) {
        let res = src.read(next_in, CHUNK);
        if (not res.ok) {
            std.io.println(std.io.stderr, "read(): {}", res.error);
            return;
        }

        strm.avail_in = res.value as u32;

        flush = res.value ? zlib.z_flush::Z_NO_FLUSH : zlib.z_flush::Z_FINISH;

        strm.next_in = next_in;

        while (true) {
            strm.avail_out = CHUNK;
            strm.next_out = next_out;

            ret = zlib.deflate(&strm, flush);
            have = CHUNK as u64 - strm.avail_out;

            let res = dst.write(next_out, have);
            if (not res.ok) {
                std.io.println(std.io.stderr, "write(): {}", res.error);
                return;
            }
            
            if (res.value as u64 != have)
                return;

            if (strm.avail_out) break; // write done
        }

        if (flush == zlib.z_flush::Z_FINISH) break; // all done
    }
}

fn decompress_file(src: &File, dst: &File) {
    let have: u64;
    let next_in: u8[CHUNK];
    let next_out: u8[CHUNK];
    let strm: zlib.z_stream = {
        zalloc = null,
        zfree = null,
        opaque = null,
    };

    let ret = zlib.inflateInit(&strm);
    if (ret != zlib.z_status::Z_OK) {
        std.io.println(std.io.stderr, "deflateInit() returned {}: {}", ret, strm.msg);
        return;
    }

    defer zlib.inflateEnd(&strm); // cleanup on every exit path

    while (true) {
        let res = src.read(next_in, CHUNK);
        if (not res.ok) {
            std.io.println(std.io.stderr, "read(): {}", res.error);
            return;
        }
        strm.avail_in = res.value as u32;

        if (strm.avail_in == 0) break; // input exhausted
        strm.next_in = next_in;

        while (true) {
            strm.avail_out = CHUNK;
            strm.next_out = next_out;

            ret = zlib.inflate(&strm, zlib.z_flush::Z_NO_FLUSH);

            case (ret) {
            when zlib.z_status::Z_NEED_DICT,
                 zlib.z_status::Z_DATA_ERROR,
                 zlib.z_status::Z_MEM_ERROR:
                 std.io.println(std.io.stderr, "inflate() returned {}", ret);
                 return;
            }

            have = CHUNK as u64 - strm.avail_out;

            let res = dst.write(next_out, have);
            if (not res.ok) {
                std.io.println(std.io.stderr, "write(): {}", res.error);
                return;
            }
            
            if (res.value as u64 != have)
                return;

            if (strm.avail_out) break; // write done
        }
        
        if (ret == zlib.z_status::Z_STREAM_END) break; // all done
    }
}
