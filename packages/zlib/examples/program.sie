// example based on:
// https://blog.jyotiprakash.org/file-compression-and-decompression-in-c-using-zlib

import std.io;
import { Formattable } from std.format;
import { String } from std.collections;
import { File, FileMode, OpenError, CloseError } from std.fs;
import unistd;
import zlib;

/* Size in bytes of the input and output staging buffers. Data is streamed
   through zlib CHUNK bytes at a time so files of any size use constant memory. */
@const CHUNK = 16384;

enum ProgramError {
    ReadError,
    WriteError,
    ShortWrite,
    InitError,
    InflateError,
}

@extend ProgramError: Formattable;

fn ProgramError::format(const &self, modifiers: const &char[]) -> String {
    case (self) {
    when ProgramError::ReadError:
        return String("Read error");
    when ProgramError::WriteError:
        return String("Write error");
    when ProgramError::ShortWrite:
        return String("Short write");
    when ProgramError::InitError:
        return String("Init error");
    when ProgramError::InflateError:
        return String("Inflate error");
    else:
        return String("Unknown error");
    }
}

fn main(argc: i32, argv: char**) -> i32 {
    let fnc: fn (&File, &File) -> Result<ProgramError>;

    while (true) {
        let opt = unistd.getopt(argc, argv, ":id");
        if (opt < 0) break;

        case (opt) {
        when 'i':
            fnc = decompress_file;
        when 'd':
            fnc = compress_file;
        else:
            std.io.println(std.io.stderr, "usage: {} [-i | -d] input output", argv[0]);
            return 1;
        }
    }

    if (argc - unistd.optind != 2) {
        std.io.println(std.io.stderr, "usage: {} [-i | -d] input output", argv[0]);
        return 1;
    }

    let input_path = argv[unistd.optind];
    let output_path = argv[unistd.optind + 1];

    let input = File(input_path, FileMode::Read);
    defer input.destroy();
    
    try input.open() except (err) {
        std.io.println(std.io.stderr, "{}: {}", input_path, err);
        return 1;
    }
    defer input.close();
    
    let output = File(output_path, FileMode::Write | FileMode::Create);
    defer output.destroy();
    
    try output.open() except (err) {
        std.io.println(std.io.stderr, "{}: {}", output_path, err);
        return 1;
    }
    defer output.close();

    try fnc(input, output) except (err) {
        std.io.println(std.io.stderr, "{}", err);
        return 1;
    }

    return 0;
}

fn compress_file(src: &File, dst: &File) -> Result<ProgramError> {
    let flush: zlib.z_flush;
    let have: u64;
    let next_in: u8[CHUNK];
    let next_out: u8[CHUNK];
    let strm: zlib.z_stream = {
        zalloc = null,
        zfree = null,
        opaque = null,
    };
        
    let ret = zlib.deflateInit(&strm, zlib.z_level::Z_DEFAULT_COMPRESSION);
    if (ret != zlib.z_status::Z_OK) {
        std.io.println(std.io.stderr, "deflateInit() returned {}: {}", ret, strm.msg);
        return Error(ProgramError::InitError);
    }
    
    defer zlib.deflateEnd(&strm); // cleanup on every exit path

    while (true) {
        let n = try src.read(next_in, CHUNK) except (err) {
            std.io.println(std.io.stderr, "read(): {}", err);
            return Error(ProgramError::ReadError);
        }

        strm.avail_in = n as u32;

        flush = n ? zlib.z_flush::Z_NO_FLUSH : zlib.z_flush::Z_FINISH;

        strm.next_in = next_in;

        while (true) {
            strm.avail_out = CHUNK;
            strm.next_out = next_out;

            ret = zlib.deflate(&strm, flush);
            have = CHUNK as u64 - strm.avail_out;

            let n = try dst.write(next_out, have) except (err) {
                std.io.println(std.io.stderr, "write(): {}", err);
                return Error(ProgramError::WriteError);
            }
            
            if (n as u64 != have)
                return Error(ProgramError::ShortWrite);

            if (strm.avail_out) break; // write done
        }

        if (flush == zlib.z_flush::Z_FINISH) break; // all done
    }

    return Ok();
}

fn decompress_file(src: &File, dst: &File) -> Result<ProgramError> {
    let have: u64;
    let next_in: u8[CHUNK];
    let next_out: u8[CHUNK];
    let strm: zlib.z_stream = {
        zalloc = null,
        zfree = null,
        opaque = null,
    };

    let ret = zlib.inflateInit(&strm);
    if (ret != zlib.z_status::Z_OK) {
        std.io.println(std.io.stderr, "deflateInit() returned {}: {}", ret, strm.msg);
        return Error(ProgramError::InitError);
    }

    defer zlib.inflateEnd(&strm); // cleanup on every exit path

    while (true) {
        let n = try src.read(next_in, CHUNK) except (err) {
            std.io.println(std.io.stderr, "read(): {}", err);
            return Error(ProgramError::ReadError);
        }
        strm.avail_in = n as u32;

        if (strm.avail_in == 0) break; // input exhausted
        strm.next_in = next_in;

        while (true) {
            strm.avail_out = CHUNK;
            strm.next_out = next_out;

            ret = zlib.inflate(&strm, zlib.z_flush::Z_NO_FLUSH);

            case (ret) {
            when zlib.z_status::Z_NEED_DICT,
                 zlib.z_status::Z_DATA_ERROR,
                 zlib.z_status::Z_MEM_ERROR:
                 std.io.println(std.io.stderr, "inflate() returned {}", ret);
                 return Error(ProgramError::InflateError);
            }

            have = CHUNK as u64 - strm.avail_out;

            let n = try dst.write(next_out, have) except (err) {
                std.io.println(std.io.stderr, "write(): {}", err);
                return Error(ProgramError::WriteError);
            }
            
            if (n as u64 != have)
                return Error(ProgramError::ShortWrite);

            if (strm.avail_out) break; // write done
        }
        
        if (ret == zlib.z_status::Z_STREAM_END) break; // all done
    }

    return Ok();
}
