import { Handler } from Gtk;
import {
    GTK_APPLICATION,
    GTK_WINDOW,
    GtkWidget,
    gtk_window_set_title,
    gtk_window_set_default_size,
    gtk_window_get_default_size,
    gtk_window_set_child,
    gtk_window_present,
    gtk_window_minimize,
    gtk_window_unminimize,
    gtk_window_maximize,
    gtk_window_unmaximize,
    gtk_window_fullscreen,
    gtk_window_unfullscreen,
    gtk_window_close,
} from gtk_bindings;
import { GApplicationFlags } from gio;
import {
    ADW_APPLICATION_WINDOW,
    adw_application_window_new,
    adw_application_window_set_content,
} from adwaita;
import { Application } from application;

struct ApplicationWindow: Handler<GtkWidget> {
    @private handle: GtkWidget*;

    fn init(&self, app: &Application) {
        self.handle = adw_application_window_new(GTK_APPLICATION(app.get_handle()));
    }

    fn get_handle(&self) -> GtkWidget* {
        return self.handle;
    }

    fn get_const_handle(const &self) -> const GtkWidget* {
        return self.handle;
    }

    fn get_content<T: Handler<GtkWidget*>>(&self) -> T {
        return { adw_application_window_get_content(ADW_APPLICATION_WINDOW(self.handle)) };
    }

    fn set_content(&self, obj: &Handler<GtkWidget>) {
        adw_application_window_set_content(ADW_APPLICATION_WINDOW(self.handle), obj.get_handle());
    }

    fn set_title(&self, title: const &char[]) {
        gtk_window_set_title(GTK_WINDOW(self.handle), title);
    }

    fn set_default_size(&self, x: i32, y: i32) {
        gtk_window_set_default_size(GTK_WINDOW(self.handle), x, y);
    }

    fn get_default_size(&self) -> Tuple<i32, i32> {
        let size: Tuple<i32, i32>;
        gtk_window_get_default_size(GTK_WINDOW(self.handle), &size[0], &size[1]);
        return size;
    }

    fn set_child(&self, obj: &Handler<GtkWidget>) {
        gtk_window_set_child(GTK_WINDOW(self.handle), obj.get_handle());
    }

    fn present(&self) {
        gtk_window_present(GTK_WINDOW(self.handle));
    }

    fn minimize(&self) {
        gtk_window_minimize(GTK_WINDOW(self.handle));
    }

    fn unminimize(&self) {
        gtk_window_unminimize(GTK_WINDOW(self.handle));
    }

    fn maximize(&self) {
        gtk_window_maximize(GTK_WINDOW(self.handle));
    }
    
    fn unmaximize(&self) {
        gtk_window_unmaximize(GTK_WINDOW(self.handle));
    }

    fn fullscreen(&self) {
        gtk_window_fullscreen(GTK_WINDOW(self.handle));
    }

    fn unfullscreen(&self) {
        gtk_window_unfullscreen(GTK_WINDOW(self.handle));
    }

    fn close(&self) {
        gtk_window_close(GTK_WINDOW(self.handle));
    }
}
