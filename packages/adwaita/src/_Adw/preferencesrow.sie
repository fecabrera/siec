import { Handler } from Gtk;
import { GtkWidget } from gtk_bindings;
import { gboolean } from glib;
import {
    ADW_PREFERENCES_ROW,
    AdwPreferencesRow,
    adw_preferences_row_new,
    adw_preferences_row_set_title,
    adw_preferences_row_get_use_underline,
    adw_preferences_row_set_use_underline,
    adw_preferences_row_get_title_selectable,
    adw_preferences_row_set_title_selectable,
    adw_preferences_row_get_use_markup,
    adw_preferences_row_set_use_markup,
} from adwaita;

struct PreferencesRow: Handler<GtkWidget> {
    @private handle: GtkWidget*;

    fn init(&self) {
        self.handle = adw_preferences_row_new();
    }

    fn init(&self, handle: GtkWidget*) {
        self.handle = handle;
    }

    fn get_handle(&self) -> GtkWidget* {
        return self.handle;
    }

    fn get_const_handle(const &self) -> const GtkWidget* {
        return self.handle;
    }

    @private
    fn get_adw_preferences_row(&self) -> AdwPreferencesRow* {
        return ADW_PREFERENCES_ROW(self.handle);
    }
    
    fn set_title(&self, title: const &char[]) {
        adw_preferences_row_set_title(self.get_adw_preferences_row(), title);
    }
    
    fn get_use_underline(&self) -> bool {
        return adw_preferences_row_get_use_underline(self.get_adw_preferences_row()) as bool;
    }
    
    fn set_use_underline(&self, use_underline: bool) {
        adw_preferences_row_set_use_underline(self.get_adw_preferences_row(), use_underline as gboolean);
    }
    
    fn get_title_selectable(&self) -> bool {
        return adw_preferences_row_get_title_selectable(self.get_adw_preferences_row()) as bool;
    }
    
    fn set_title_selectable(&self, title_selectable: bool) {
        adw_preferences_row_set_title_selectable(self.get_adw_preferences_row(), title_selectable as gboolean);
    }
    
    fn get_use_markup(&self) -> bool {
        return adw_preferences_row_get_use_markup(self.get_adw_preferences_row()) as bool;
    }
    
    fn set_use_markup(&self, use_markup: bool) {
        adw_preferences_row_set_use_markup(self.get_adw_preferences_row(), use_markup as gboolean);
    }
}