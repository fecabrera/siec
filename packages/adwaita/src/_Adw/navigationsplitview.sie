import { Handler } from Gtk;
import { GtkWidget } from gtk_bindings;
import {
    AdwNavigationSplitView,
    ADW_NAVIGATION_SPLIT_VIEW,
    adw_navigation_split_view_new,
    adw_navigation_split_view_set_content,
    adw_navigation_split_view_set_sidebar,
} from adwaita;
import { NavigationPage } from navigationpage;

struct NavigationSplitView: Handler<GtkWidget> {
    @private handle: GtkWidget*;

    fn init(&self) {
        self.handle = adw_navigation_split_view_new();
    }

    fn init(&self, handle: GtkWidget*) {
        self.handle = handle;
    }

    fn get_handle(&self) -> GtkWidget* {
        return self.handle;
    }

    fn get_const_handle(const &self) -> const GtkWidget* {
        return self.handle;
    }

    @private
    fn as_navigation_split_view(&self) -> AdwNavigationSplitView* {
        return ADW_NAVIGATION_SPLIT_VIEW(self.handle);
    }

    fn set_content(&self, page: &NavigationPage) {
        adw_navigation_split_view_set_content(self.as_navigation_split_view(), page.get_handle());
    }

    fn set_sidebar(&self, sidebar: &NavigationPage) {
        adw_navigation_split_view_set_sidebar(self.as_navigation_split_view(), sidebar.get_handle());
    }
}