import { mode_t } from _base;

/*
 * [XSI] The symbolic names for file modes for use as values of mode_t
 * shall be defined as described in <sys/stat.h>
 */
/* File type */
@const S_IFMT       = 0xF000;               /* [XSI] type of file mask */
@const S_IFIFO      = 0x1000;               /* [XSI] named pipe (fifo) */
@const S_IFCHR      = 0x2000;               /* [XSI] character special */
@const S_IFDIR      = 0x4000;               /* [XSI] directory */
@const S_IFBLK      = 0x6000;               /* [XSI] block special */
@const S_IFREG      = 0x8000;               /* [XSI] regular */
@const S_IFLNK      = 0xA000;               /* [XSI] symbolic link */
@const S_IFSOCK     = 0xC000;               /* [XSI] socket */
@const S_IFWHT      = 0xE000;               /* OBSOLETE: whiteout */

/* File mode */
/* Read, write, execute/search by owner */
@const S_IRWXU: mode_t  = 0x01C0;           /* [XSI] RWX mask for owner */
@const S_IRUSR: mode_t  = 0x0100;           /* [XSI] R for owner */
@const S_IWUSR: mode_t  = 0x0080;           /* [XSI] W for owner */
@const S_IXUSR: mode_t  = 0x0040;           /* [XSI] X for owner */
/* Read, write, execute/search by group */
@const S_IRWXG: mode_t  = 0x0038;           /* [XSI] RWX mask for group */
@const S_IRGRP: mode_t  = 0x0020;           /* [XSI] R for group */
@const S_IWGRP: mode_t  = 0x0010;           /* [XSI] W for group */
@const S_IXGRP: mode_t  = 0x0008;           /* [XSI] X for group */
/* Read, write, execute/search by others */
@const S_IRWXO: mode_t  = 0x0007;           /* [XSI] RWX mask for other */
@const S_IROTH: mode_t  = 0x0004;           /* [XSI] R for other */
@const S_IWOTH: mode_t  = 0x0002;           /* [XSI] W for other */
@const S_IXOTH: mode_t  = 0x0001;           /* [XSI] X for other */

@const S_ISUID      = 0x0800;               /* [XSI] set user id on execution */
@const S_ISGID      = 0x0400;               /* [XSI] set group id on execution */
@const S_ISVTX      = 0x0200;               /* [XSI] directory restrcted delete */

@const S_ISTXT      = S_ISVTX;              /* sticky bit: not supported */
@const S_IREAD      = S_IRUSR;              /* backward compatability */
@const S_IWRITE     = S_IWUSR;              /* backward compatability */
@const S_IEXEC      = S_IXUSR;              /* backward compatability */