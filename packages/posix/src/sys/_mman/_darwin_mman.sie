import { off_t } from sys.types;

@const PROT_NONE        = 0x00;         /* [MC2] no permissions */
@const PROT_READ        = 0x01;         /* [MC2] pages can be read */
@const PROT_WRITE       = 0x02;         /* [MC2] pages can be written */
@const PROT_EXEC        = 0x04;         /* [MC2] pages can be executed */

/*
 * Flags contain sharing type and options.
 * Sharing types; choose one.
 */
@const MAP_SHARED       = 0x0001;       /* [MF|SHM] share changes */
@const MAP_PRIVATE      = 0x0002;       /* [MF|SHM] changes are private */
@const MAP_COPY         = MAP_PRIVATE;  /* Obsolete */

/*
 * Other flags
 */
@const MAP_FIXED        = 0x0010;       /* [MF|SHM] interpret addr exactly */
@const MAP_RENAME       = 0x0020;       /* Sun: rename private pages to file */
@const MAP_NORESERVE    = 0x0040;       /* Sun: don't reserve needed swap area */
@const MAP_RESERVED0080 = 0x0080;       /* previously unimplemented MAP_INHERIT */
@const MAP_NOEXTEND     = 0x0100;       /* for MAP_FILE, don't change file size */
@const MAP_HASSEMAPHORE = 0x0200;       /* region may contain semaphores */
@const MAP_NOCACHE      = 0x0400;       /* don't cache pages for this mapping */
@const MAP_JIT          = 0x0800;       /* Allocate a region that will be used for JIT purposes */

/*
 * Mapping type
 */
@const MAP_FILE         = 0x0000;       /* map from file (default) */
@const MAP_ANON         = 0x1000;       /* allocated from memory, swap space */
@const MAP_ANONYMOUS    = MAP_ANON;

/*
 * The MAP_RESILIENT_* flags can be used when the caller wants to map some
 * possibly unreliable memory and be able to access it safely, possibly
 * getting the wrong contents rather than raising any exception.
 * For safety reasons, such mappings have to be read-only (PROT_READ access
 * only).
 *
 * MAP_RESILIENT_CODESIGN:
 *      accessing this mapping will not generate code-signing violations,
 *	even if the contents are tainted.
 * MAP_RESILIENT_MEDIA:
 *	accessing this mapping will not generate an exception if the contents
 *	are not available (unreachable removable or remote media, access beyond
 *	end-of-file, ...).  Missing contents will be replaced with zeroes.
 */
@const MAP_RESILIENT_CODESIGN   = 0x2000;   /* no code-signing failures */
@const MAP_RESILIENT_MEDIA      = 0x4000;   /* no backing-store failures */
@const MAP_32BIT                = 0x8000;   /* Return virtual addresses <4G only */

/*
 * Flags used to support translated processes.
 */
@const MAP_TRANSLATED_ALLOW_EXECUTE = 0x20000; /* allow execute in translated processes */

@const MAP_UNIX03                   = 0x40000; /* UNIX03 compliance */
 
@const MAP_TPRO                     = 0x80000; /* Allocate a region that will be protected by TPRO */

/*
 * Process memory locking
 */
@const MCL_CURRENT  = 0x0001;  /* [ML] Lock only current memory */
@const MCL_FUTURE   = 0x0002;  /* [ML] Lock all future memory as well */
 
/*
 * Error return from mmap()
 */
@const MAP_FAILED   = -1 as opaque*;    /* [MF|SHM] mmap failed */


/*
 * msync() flags
 *
 * When making a new MS_*, update tests vm_parameter_validation_[user|kern]
 * and their expected results; they deliberately call VM functions with invalid
 * msync values and you may be turning one of those invalid msyncs valid.
 */
@const MS_ASYNC         = 0x0001;  /* [MF|SIO] return immediately */
@const MS_INVALIDATE    = 0x0002;  /* [MF|SIO] invalidate all cached data */
@const MS_SYNC          = 0x0010;  /* [MF|SIO] msync synchronously */
@const MS_KILLPAGES     = 0x0004;  /* invalidate pages, leave mapped */
@const MS_DEACTIVATE    = 0x0008;  /* deactivate pages, leave mapped */

/*
 * Advice to madvise
 *
 * When making a new MADV_*, update tests vm_parameter_validation_[user|kern]
 * and their expected results; they deliberately call VM functions with invalid
 * madvise values and you may be turning one of those invalid madvises valid.
 */
@const POSIX_MADV_NORMAL        = 0;       /* [MC1] no further special treatment */
@const POSIX_MADV_RANDOM        = 1;       /* [MC1] expect random page refs */
@const POSIX_MADV_SEQUENTIAL    = 2;       /* [MC1] expect sequential page refs */
@const POSIX_MADV_WILLNEED      = 3;       /* [MC1] will need these pages */
@const POSIX_MADV_DONTNEED      = 4;       /* [MC1] dont need these pages */

@const MADV_NORMAL              = POSIX_MADV_NORMAL;
@const MADV_RANDOM              = POSIX_MADV_RANDOM;
@const MADV_SEQUENTIAL          = POSIX_MADV_SEQUENTIAL;
@const MADV_WILLNEED            = POSIX_MADV_WILLNEED;
@const MADV_DONTNEED            = POSIX_MADV_DONTNEED;
@const MADV_FREE                = 5;       /* pages unneeded, discard contents */
@const MADV_ZERO_WIRED_PAGES    = 6;       /* zero the wired pages that have not been unwired before the entry is deleted */
@const MADV_FREE_REUSABLE       = 7;       /* pages can be reused (by anyone) */
@const MADV_FREE_REUSE          = 8;       /* caller wants to reuse those pages */
@const MADV_CAN_REUSE           = 9;
@const MADV_PAGEOUT             = 10;      /* page out now (internal only) */
@const MADV_ZERO                = 11;      /* zero pages without faulting in additional pages */

/*
 * Return bits from mincore
 */
@const MINCORE_INCORE           = 0x1;     /* Page is incore */
@const MINCORE_REFERENCED       = 0x2;     /* Page has been referenced by us */
@const MINCORE_MODIFIED         = 0x4;     /* Page has been modified by us */
@const MINCORE_REFERENCED_OTHER = 0x8;     /* Page has been referenced */
@const MINCORE_MODIFIED_OTHER   = 0x10;     /* Page has been modified */
@const MINCORE_PAGED_OUT        = 0x20;     /* Page has been paged out */
@const MINCORE_COPIED           = 0x40;     /* Page has been copied */
@const MINCORE_ANONYMOUS        = 0x80;     /* Page belongs to an anonymous object */

/* [ML] */
@extern fn mlockall(flags: i32) -> i32;
@extern fn munlockall() -> i32;
/* [MR] */
@extern fn mlock(addr: const opaque*, len: u64) -> i32;
/* [MC3]*/
@extern fn mmap(addr: opaque*, len: u64, prot: i32, flags: i32, fd: i32, offset: off_t) -> opaque*;
/* [MPR] */
@extern fn mprotect(addr: opaque*, size: u64, prot: i32) -> i32;
/* [MF|SIO] */
@extern fn msync(addr: opaque*, len: u64, flags: i32) -> i32;
/* [MR] */
@extern fn munlock(addr: const opaque*, len: u64) -> i32;
/* [MC3]*/
@extern fn munmap(addr: opaque*, len: u64) -> i32;
/* [SHM] */
@extern fn shm_open(name: const char*, oflag: i32, ...) -> i32;
@extern fn shm_unlink(name: const char*) -> i32;
/* [ADV] */
@extern fn posix_madvise(addr: opaque*, size: u64, advice: i32) -> i32;

@extern fn madvise(addr: opaque*, size: u64, advice: i32) -> i32;
@extern fn mincore(addr: const opaque*, size: u64, vec: char*) -> i32;
@extern fn minherit(addr: opaque*, size: u64, inherit: i32) -> i32;