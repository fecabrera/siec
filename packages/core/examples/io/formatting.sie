import std.io;

fn main() -> i32 {
    std.io.println("true:   {}", true);
    std.io.println("false:  {}", false);

    std.io.println("i8:     {}", -1 as i8);
    std.io.println("i16:    {}", -1 as i16);
    std.io.println("i32:    {}", -1 as i32);
    std.io.println("i64:    {}", -1 as i64);

    std.io.println("u8:     {}", 1 as u8);
    std.io.println("u16:    {}", 1 as u16);
    std.io.println("u32:    {}", 1 as u32);
    std.io.println("u64:    {}", 1 as u64);

    std.io.println("char*:  {}", "hello" as char*);
    std.io.println("char[]: {}", "hello" as char[]);
    std.io.println("i32[]:  {}", [1, 2, 3] as i32[]);
    
    return 0;
}