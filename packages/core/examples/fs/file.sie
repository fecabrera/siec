import std.io;
import { File, FileMode, OpenError, CloseError } from std.fs;

fn main(args: char*[]) -> i32 {
    if (args.length != 2) {
        std.io.println(std.io.stderr, "usage: {} file", args[0]);
        return 1;
    }
    
    let file = File(args[1], FileMode::Read);
    defer file.destroy();
    
    let open_res = file.open();
    if (not open_res.ok) {
        std.io.println(std.io.stderr, "{}: {}", args[1], open_res.error);
        return 1;
    }
    
    std.io.println("Opened \"{}\"", args[1]);
    
    let close_res = file.close();
    if (not close_res.ok) {
        std.io.println(std.io.stderr, "{}: {}", args[1], close_res.error);
        return 1;
    }

    std.io.println("Closed \"{}\"", args[1]);

    return 0;
}