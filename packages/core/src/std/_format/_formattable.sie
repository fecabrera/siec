/**
 * Format the bool.
 *
 * @param self The bool to format.
 * @param modifiers The modifiers to format the bool with.
 * @return A String containing the formatted bool.
 */
@extend bool: Formattable { 
    @inline fn format(const &self, modifiers: const &char[]) -> String {
        if (modifiers == "y")
            return String(self ? "y": "n");
        else if (modifiers == "yes")
            return String(self ? "yes": "no");
        else
            return String(self ? "true": "false");
    }
}

/**
 * Format the char.
 *
 * @param self The char to format.
 * @param modifiers The modifiers to format the char with.
 * @return A String containing the formatted char.
 */
@extend char: Formattable {
    @inline fn format(const &self, modifiers: const &char[]) -> String {
        let str = String();
        str.push(self);
        return str;
    } 
}

/**
 * Format the array.
 *
 * @param self The array to format.
 * @param modifiers The modifiers to format the array with.
 * @return A String containing the formatted array.
 */
@template<T: Formattable> {
    @extend T[]: Formattable {
        fn format(const &self, modifiers: const &char[]) -> String {
            let result = String();
            result += '[';
            foreach (el : enumerate(self)) {
                if (el.index) result += ", ";
                result += el.value.format(modifiers);
            }
            result += ']';
            return result;
        }
    }
}

/**
 * Format the iterable of characters.
 *
 * @param self The iterable of characters to format.
 * @param modifiers The modifiers to format the iterable of characters with.
 * @return A String containing the formatted iterable of characters.
 */
@template<T: Iterable<char>>
@override
fn T[]::format(const &self, modifiers: const &char[]) -> String {
    let result = String();
    result += '[';
    foreach (el : enumerate(self)) {
        if (el.index) result += ", ";
        result += '"';
        result += el.value.format(modifiers);
        result += '"';
    }
    result += ']';
    return result;
}

/**
 * Format the character array.
 *
 * @param self The character array to format.
 * @param modifiers The modifiers to format the character array with.
 * @return A String containing the formatted character array.
 */
@override
@inline fn char[]::format(const &self, modifiers: const &char[]) -> String {
    return format_str(self, modifiers);
}
