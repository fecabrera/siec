@include("_int")

import { String } from std.collections;

interface Formattable {
    fn format(const &self, modifiers: const &char[]) -> String;
}

@extend i64: Formattable;

fn i64::format(const &self, modifiers: const &char[]) -> String {
    let neg = false;
    let num = self as u64;
    if (self < 0) {
        neg = true;
        num = (~num) + 1;
    }
    return format_int(num, modifiers, neg);
}

@extend i32: Formattable;

@inline
fn i32::format(const &self, modifiers: const &char[]) -> String {
    return (self as i64).format(modifiers);
}

@extend i16: Formattable;

@inline
fn i16::format(const &self, modifiers: const &char[]) -> String {
    return (self as i64).format(modifiers);
}

@extend i8: Formattable;

@inline
fn i8::format(const &self, modifiers: const &char[]) -> String {
    return (self as i64).format(modifiers);
}

@extend u64: Formattable;

@inline
fn u64::format(const &self, modifiers: const &char[]) -> String {
    return format_int(self, modifiers, false);
}

@extend u32: Formattable;

@inline
fn u32::format(const &self, modifiers: const &char[]) -> String {
    return format_int(self, modifiers, false);
}

@extend u16: Formattable;

@inline
fn u16::format(const &self, modifiers: const &char[]) -> String {
    return format_int(self, modifiers, false);
}

@extend u8: Formattable;

@inline
fn u8::format(const &self, modifiers: const &char[]) -> String {
    return format_int(self, modifiers, false);
}

@extend bool: Formattable;

@inline
fn bool::format(const &self, modifiers: const &char[]) -> String {
    return String(self ? "true": "false");
}

@extend char[]: Formattable;

@inline
fn char[]::format(const &self, modifiers: const &char[]) -> String {
    return String(self);
}
