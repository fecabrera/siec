}

/**
 * Format the u128.
 *
 * @param self The u128 to format.
 * @param modifiers The modifiers to format the u128 with.
 * @return A String containing the formatted u128.
 */
@extend u128: Formattable {
    @inline fn format(const &self, modifiers: const &char[]) -> String {
        return format_int(self, modifiers, false);
    }
}

/**
 * Format the u64.
 *
 * @param self The u64 to format.
 * @param modifiers The modifiers to format the u64 with.
 * @return A String containing the formatted u64.
 */
@extend u64: Formattable {
