@include("_int")
@include("_str")
@include("_float")

import { String } from std.collections;

interface Formattable {
    fn format(const &self, modifiers: const &char[]) -> String;
}

/**
 * Format the f64.
 *
 * @param self The f64 to format.
 * @param modifiers The modifiers to format the f64 with.
 * @return A String containing the formatted f64
 */
@extend f64: Formattable {
    fn format(const &self, modifiers: const &char[]) -> String {
        return format_float(self, modifiers);
    }
}

/**
 * Format the i128.
 *
 * @param self The i128 to format.
 * @param modifiers The modifiers to format the i128 with.
 * @return A String containing the formatted i128.
 */
 @extend i128: Formattable {
    fn format(const &self, modifiers: const &char[]) -> String {
        let neg = false;
        let num = self as u128;
        if (self < 0) {
            neg = true;
            num = (~num) + 1;
        }
        return format_int(num, modifiers, neg);
    }
}

/**
 * Format the i64.
 *
 * @param self The i64 to format.
 * @param modifiers The modifiers to format the i64 with.
 * @return A String containing the formatted i64.
 */
@extend i64: Formattable {
    fn format(const &self, modifiers: const &char[]) -> String {
        let neg = false;
        let num = self as u64;
        if (self < 0) {
            neg = true;
            num = (~num) + 1;
        }
        return format_int(num, modifiers, neg);
    }
}

/**
 * Format the i32.
 *
 * @param self The i32 to format.
 * @param modifiers The modifiers to format the i32 with.
 * @return A String containing the formatted i32.
 */
@extend i32: Formattable {
    @inline fn format(const &self, modifiers: const &char[]) -> String {
        return (self as i64).format(modifiers);
    }
}

