import std.io;
import std.math;
import { String } from std.collections;

@include("_hex");

@const DOUBLE_MANTISSA_BITS = 52;
@const DOUBLE_EXPONENT_BITS = 11;
@const DOUBLE_BIAS = 1023;

@private
struct Decimal64 {
    m: u64;
    e: i64;
}

@private
union prun {
    f: f64;
    bits: u64;
}

@private
struct IEEEDouble {
    m: u64;
    e: i64;
    neg: bool;

    fn init(&self, value: f64) {
        let data: prun;
        data.f = value;
        
        self.m = data.bits % (1 << DOUBLE_MANTISSA_BITS);
        
        data.bits >>= DOUBLE_MANTISSA_BITS;
        self.e = (data.bits % (1 << DOUBLE_EXPONENT_BITS)) as i64;
        
        data.bits >>= DOUBLE_EXPONENT_BITS;
        self.neg = (data.bits & 1) == 1;
    }
}

@static
fn _float_to_decimal(value: f64, p: i64 = 6) -> Decimal64 {
    let ieee = IEEEDouble(value);
    
    let mf: u64;
    let ef: i64;

    // step 1: decode the floating point number
    if (ieee.e == 0) {
        mf = ieee.m;
        ef = 1 - DOUBLE_BIAS - DOUBLE_MANTISSA_BITS;
    } else {
        mf = (1 << DOUBLE_MANTISSA_BITS) | ieee.m;
        ef = ieee.e - DOUBLE_BIAS - DOUBLE_MANTISSA_BITS;
    }

    // step 2: determine the interval of information-preserving outputs.
    let e2 = ef - 2;
    let v = 4 * mf;
    let u = v - ((mf == 0 and ef > 1) ? 1 : 2);
    let w = v + 2;
    
    if (e2 < 0) {
        let e10 = e2.abs().to_unsigned();
        // convert to decimal power base
        let (um, ue) = _mul5div10(u, e10);
        let (wm, we) = _mul5div10(w, e10);
        // find shortest decimal representation; e is the scale
        // exponent so the value is d0 * 10^e (same as the e2 >= 0 path)
        let (d0, e0) = _compute_shortest(um, wm);
        let e = e0 + e2 + we.to_signed();
        return { d0, e };
    } else {
        // convert to decimal power base
        let (um, ue) = _mul2div10(u, e2 as u64);
        let (wm, we) = _mul2div10(w, e2 as u64);
        // find shortest decimal representation
        let (d0, e0) = _compute_shortest(um, wm);
        let e = e0 + we.to_signed();
        return { d0, e };
    }
}

/**
 * Change the base of a decimal from m*5^e to a*10^b
 * 
 * @param m The magnitude in base 5
 * @param e The exponent in base 5
 * @return A tuple (a, b), where a is the magnitude in base 10 and b
 *         the exponent in base 10
 */
@static
fn _mul5div10(m: u128, e: u64) -> Tuple<u64, u64> {
    let n: u64 = 0;
    for (let i: u64 = 0; i < e; i += 1) {
        m *= 5;
        if (i % 3) {
            let s: u128 = m % 10 > 5 ? 1 : 0;
            m /= 10;
            m += s;
            n += 1;
        }
    }
    return (m as u64, n);
}

/**
 * Change the base of a decimal from m*2^e to a*10^b
 * 
 * @param m The magnitude in base 2
 * @param e The exponent in base 2
 * @return A tuple (a, b), where a is the magnitude in base 10 and b
 *         the exponent in base 10
 */
@static
fn _mul2div10(m: u128, e: u64) -> Tuple<u64, u64> {
    let n: u64 = 0;
    for (let i: u64 = 0; i < e; i += 1) {
        m *= 2;
        if ((i % 5) % 2) {
            let s: u128 = m % 10 > 5 ? 1 : 0;
            m /= 10;
            m += s;
            n += 1;
        }
    }
    return (m as u64, n);
}

/**
 * Compute d0*10^e0 where a <= d0*10^e0 <= c through multiple divisions
 * 
 * @param m The lower bound
 * @param e The upper bound
 * @return A tuple (d0, e0) representing d0*10^e0
 */
@static
fn _compute_shortest(a: u64, c: u64) -> Tuple<u64, i64> {
    let all_a_zero = true;
    let i: i64 = 0;
    while (a / 10 < c / 10) {
        all_a_zero = all_a_zero and a % 10 == 0;
        a /= 10;
        c /= 10;
        i += 1;
    }
    if (all_a_zero) {
        while (a % 10 == 0) {
            a /= 10;
            c /= 10;
            i += 1;
        }
    }
    return (c as u64, i);
}

@static
fn _format_big((m, e, neg): Tuple<u64, i64, bool>, modifiers: const &char[]) -> String {
    let tmp = String();
    let str = String();
    
    // for e >= 0 we add zeroes after the magnitude
    // since the number is formatted right to left we add them first
    for (let i: i64 = 0; i < e; i += 1) {
        tmp.push('0');
    }
    
    // format the magnitude from right to left
    let num = m;
    while (true) {
        tmp.push(_hexu[num % 10]);
        num = num / 10;
        if (num == 0) break;
    }

    // if the number is negative we prepend the sign character
    if (neg) str.push('-');
    
    // invert the formatted string
    for(let i: u64 = 0; i < tmp.get_length(); i += 1) {
        str.push(tmp[tmp.get_length() - i - 1]);
    }
    
    return str;
}

@static
fn _format_small((m, e, neg): Tuple<u64, i64, bool>, modifiers: const &char[]) -> String {
    // value = m * 10^e with e < 0: place a decimal point so there are
    // |e| digits after it ('123' / -2 -> '1.23', '1' / -3 -> '0.001')
    let digits = String();
    let tmp = String();

    // format the magnitude from right to left
    let num = m;
    while (true) {
        tmp.push(_hexu[num % 10]);
        num = num / 10;
        if (num == 0) break;
    }

    // invert the formatted string
    for (let i: u64 = 0; i < tmp.get_length(); i += 1) {
        digits.push(tmp[tmp.get_length() - i - 1]);
    }

    let str = String();

    // if the number is negative we prepend the sign character
    if (neg) str.push('-');

    // for e < 0 we add zeroes before the magnitude
    let frac = e.abs();
    let int_digits = digits.get_length().to_signed() - frac;
    if (int_digits <= 0) {
        str.push('0');
        str.push('.');
        for (let i: i64 = 0; i < -int_digits; i += 1) {
            str.push('0');
        }
        for (let i: u64 = 0; i < digits.get_length(); i += 1) {
            str.push(digits[i]);
        }
    } else {
        for (let i: i64 = 0; i < int_digits; i += 1) {
            str.push(digits[i as u64]);
        }
        str.push('.');
        for (let i: i64 = int_digits; i < digits.get_length().to_signed(); i += 1) {
            str.push(digits[i as u64]);
        }
    }

    return str;
}

fn format_float(value: f64, modifiers: const &char[]) -> String {
    let dec = _float_to_decimal(value);
    let neg = value < 0;
    if (dec.e < 0) return _format_small((dec.m, dec.e, neg), modifiers);
    return _format_big((dec.m, dec.e, neg), modifiers);
}