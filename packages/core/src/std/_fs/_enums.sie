import { String } from std.collections;

enum FileMode: i32 {
    None        = 0,
    Read        = 1 << 0,
    Write       = 1 << 1,
    ReadWrite   = FileMode::Read | FileMode::Write,
    Append      = 1 << 2,
    Create      = 1 << 3,
    Truncate    = 1 << 4,
}

enum OpenError {
    SystemError = 1,
    FilesystemError,
    AlreadyOpen,
    AlreadyExists,
    InvalidMode,
    NotFound,
    PermissionDenied,
    InvalidFile,
    Encrypted,
}

enum CloseError {
    SystemError = 1,
    FilesystemError,
    AlreadyClosed,
}

enum StatError {
    SystemError = 1,
    FilesystemError,
    AlreadyClosed,
    NotFound,
    NotOpen,
    PermissionDenied,
}

@extend OpenError: Formattable {
    /**
    * Format the OpenError.
    *
    * @param modifiers Unused.
    * @return The formatted OpenError.
    */
    fn format(const &self, modifiers: const &char[]) -> String {
        case (self) {
        when OpenError::SystemError:
            return String("System error");
        when OpenError::FilesystemError:
            return String("Filesystem error");
        when OpenError::AlreadyOpen:
            return String("Already open");
        when OpenError::AlreadyExists:
            return String("Already exists");
        when OpenError::InvalidMode:
            return String("Invalid mode");
        when OpenError::NotFound:
            return String("Not found");
        when OpenError::PermissionDenied:
            return String("Permission denied");
        when OpenError::InvalidFile:
            return String("Invalid file");
        when OpenError::Encrypted:
            return String("Encrypted");
        else:
            return String("Unknown error");
        }
    }
}

@extend CloseError: Formattable {
    /**
    * Format the CloseError.
    *
    * @param modifiers Unused.
    * @return The formatted CloseError.
    */
    fn format(const &self, modifiers: const &char[]) -> String {
        case (self) {
        when CloseError::SystemError:
            return String("System error");
        when CloseError::FilesystemError:
            return String("Filesystem error");
        when CloseError::AlreadyClosed:
            return String("Already closed");
        else:
            return String("Unknown error");
        }
    }
}

@extend StatError: Formattable {
    /**
    * Format the StatError.
    *
    * @param modifiers Unused.
    * @return The formatted StatError.
    */
    fn format(const &self, modifiers: const &char[]) -> String {
        case (self) {
        when StatError::SystemError:
            return String("System error");
        when StatError::FilesystemError:
            return String("Filesystem error");
        when StatError::AlreadyClosed:
            return String("Already closed");
        when StatError::NotFound:
            return String("Not found");
        when StatError::NotOpen:
            return String("Not open");
        when StatError::PermissionDenied:
            return String("Permission denied");
        else:
            return String("Unknown error");
        }
    }
}
