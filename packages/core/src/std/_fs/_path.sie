import { Formattable } from std.format;
import { stat, S_ISDIR, S_ISREG } from sys.stat;
import { errno, ENOENT, EACCES } from errno;
import { basename, dirname } from libgen;
import { String } from std.collections;
import { StatError } from _enums;

/**
 * A path to a file or directory.
 *
 * @param path The path to the file or directory.
 */
struct Path: Formattable, Destroy {
    @private path: String;

    /**
     * Initialize the path with the given string.
     *
     * @param path The iterable to initialize the path with.
     */
    fn init(&self, path: const &String) {
        self.path = String(path);
    }

    /**
     * Initialize the path with the given null-terminated array
     *
     * @param path The iterable to initialize the path with.
     */
    fn init(&self, path: const &char[]) {
        self.path = String(path);
    }

    /**
     * Initialize the path with the given null-terminated array.
     *
     * @param path The path
     */
    fn init(&self, path: const char*) {
        self.path = String(path);
    }

    /**
     * Destroy the path.
     */
    fn destroy(&self) {
        drop self.path;
    }

    /**
     * Get the underlying array representation of the path.
     *
     * @return The path as a char array.
     */
    fn get_string(&self) -> const &String {
        return self.path.null_terminate();
    }

    /**
     * Get the underlying array representation of the path.
     *
     * @return The path as a char array.
     */
    fn get_const_array(&self) -> const char[] {
        return self.path.null_terminate().as_const_array();
    }

    /**
     * Format the path with the given modifiers.
     *
     * @param modifiers The modifiers to format the path with.
     * @return The formatted path.
     */
    @inline
    fn format(const &self, modifiers: const &char[]) -> String {
        return self.path.format(modifiers);
    }

    /**
     * Get the basename of the path.
     *
     * @param path The path to get the basename of.
     * @return The basename of the path.
     */
    @inline
    fn basename(path: &String) -> String {
        return Path::basename(path.null_terminate().as_array());
    }

    /**
     * Get the basename of the path.
     *
     * Path must be null-terminated.
     *
     * @param path The path to get the basename of.
     * @return The basename of the path.
     */
    @inline
    fn basename(path: &char[]) -> String {
        return String(basename(path));
    }

    /**
     * Get the basename of the path.
     *
     * @return The basename of the path.
     */
    @inline
    fn basename(&self) -> String {
        return Path::basename(self.path);
    }

    /**
     * Get the dirname of the path.
     *
     * @param path The path to get the dirname of.
     * @return The dirname of the path.
     */
    @inline
    fn dirname(path: &String) -> String {
        return Path::dirname(path.null_terminate().as_array());
    }

    /**
     * Get the dirname of the path.
     *
     * Path must be null-terminated.
     *
     * @param path The path to get the dirname of.
     * @return The dirname of the path.
     */
    @inline
    fn dirname(path: &char[]) -> String {
        return String(dirname(path));
    }

    /**
     * Get the dirname of the path.
     *
     * @return The dirname of the path.
     */
    @inline
    fn dirname(&self) -> String {
        return Path::dirname(self.path);
    }

    /**
     * Check if the path is a directory.
     *
     * Path must be null-terminated.
     *
     * @param path The path to check if it is a directory.
     * @return The result of the check.
     */
    fn is_dir(path: &char[]) -> Result<bool, StatError> {
        let st: stat;
        
        if (stat(path, &st) < 0) {
            let errsv = errno;
            case(errsv) {
            when ENOENT:
                return Error(StatError::NotFound);
            when EACCES:
                return Error(StatError::PermissionDenied);
            else:
                return Error(StatError::SystemError);
            }
        }

        return Ok(S_ISDIR(st.st_mode));
    }

    /**
     * Check if the path is a directory.
     *
     * @param path The path to check if it is a directory.
     * @return The result of the check.
     */
    @inline
    fn is_dir(path: &String) -> Result<bool, StatError> {
        return Path::is_dir(path.null_terminate().as_array());
    }

    /**
     * Check if the path is a directory.
     *
     * @return The result of the check.
     */
    @inline
    fn is_dir(&self) -> Result<bool, StatError> {
        return Path::is_dir(self.path);
    }

    /**
     * Check if the path is a regular file.
     *
     * @param path The null-terminated path to check if it is a regular file.
     * @return The result of the check.
     */
    fn is_regular(path: const &char[]) -> Result<bool, StatError> {
        let st: stat;
        
        if (stat(path, &st) < 0) {
            let errsv = errno;
            case(errsv) {
            when ENOENT:
                return Error(StatError::NotFound);
            when EACCES:
                return Error(StatError::PermissionDenied);
            else:
                return Error(StatError::SystemError);
            }
        }

        return Ok(S_ISREG(st.st_mode));
    }

    /**
     * Check if the path is a regular file.
     *
     * @param path The path to check if it is a regular file.
     * @return The result of the check.
     */
    @inline
    fn is_regular(path: &String) -> Result<bool, StatError> {
        return Path::is_regular(path.null_terminate().as_array());
    }

    /**
     * Check if the path is a regular file.
     *
     * @return The result of the check.
     */
    @inline
    fn is_regular(&self) -> Result<bool, StatError> {
        return Path::is_regular(self.path.null_terminate().as_array());
    }
}
