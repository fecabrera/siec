import { String } from std.collections;
import { Formattable } from std.format;

enum IOError {
    SystemError = -1,
    NotOpen,
    PermissionDenied,
    InvalidBuffer,
    InvalidOffset,
}

enum SeekOrigin {
    Start,
    Current,
    End,
}

interface IOReadable {
    fn read(&self, buf: &u8[], count: u64) -> Result<i64, IOError>;
    fn read(&self, buf: &u8[]) -> Result<i64, IOError>;
}

interface IOWritable {
    fn write(&self, buf: const &u8[], count: u64) -> Result<i64, IOError>;
    fn write(&self, buf: const &u8[]) -> Result<i64, IOError>;
}

interface IOSeekable {
    fn seek(&self, offset: i64, origin: SeekOrigin) -> Result<i64, IOError>;
}

fn IOError::format(&self, modifiers: const &char[]) -> String {
    case (self) {
    when IOError::SystemError:
        return String("System error");
    when IOError::NotOpen:
        return String("Not open");
    when IOError::PermissionDenied:
        return String("Permission denied");
    when IOError::InvalidBuffer:
        return String("Invalid buffer");
    when IOError::InvalidOffset:
        return String("Invalid offset");
    else:
        return String("Unknown error");
    }
}