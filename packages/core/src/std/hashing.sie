@include("_hashing/_crc32")
@include("_hashing/_fnv1a")
@include("_hashing/_splitmix64")
@include("_hashing/_hashable");

@template<T: Scalar> {
    @extend T: Hashable {
        @inline
        fn hash(const &self) -> u64 {
            return splitmix64(self);
        }
    }

    @extend T[]: Hashable {
        fn hash(const &self) -> u64 {
            let h = FNV1a();
            foreach (k : self) {
                h.ingest(k as u64);
            }
            return h.hash;
        }
    }
}
