@include("_hashing/_crc32")
@include("_hashing/_fnv1a")
@include("_hashing/_splitmix64")
@include("_hashing/_hashable");

@where<T: Scalar> {
    @extend T: Hashable {
        /**
        * Calculate the hash of the scalar.
        *
        * @return The hash of the scalar.
        */
        @inline
        fn hash(const &self) -> u64 {
            return splitmix64(self);
        }
    }

    @extend T[]: Hashable {
        /**
         * Calculate the hash of the array.
         *
         * @return The hash of the array.
         */
        fn hash(const &self) -> u64 {
            let h = FNV1a();
            foreach (k : self) {
                h.ingest(k as u64);
            }
            return h.get_value();
        }
    }
}
