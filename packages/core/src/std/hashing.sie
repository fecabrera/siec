@include("_hashing/_crc32")
@include("_hashing/_fnv1a")
@include("_hashing/_splitmix64")
@include("_hashing/_hashable");

@inline
fn hash<T>(value: const &Iterable<T>) -> u64 {
    let h = FNV1a();
    foreach (k : value) {
        h.ingest(k as u64);
    }
    return h.hash;
}

@inline
fn hash<T>(value: const &T) -> u64 {
    return splitmix64(value);
}