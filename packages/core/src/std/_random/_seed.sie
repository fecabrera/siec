import { File, FileMode } from std.fs;
import { panic } from std;

fn random_seed(buffer: &u8[]) {
    let file = try File::open("/dev/urandom", FileMode::Read) except (error) {
        panic("Cannot initialize random: {}", error);
    }
    defer file.close();

    try file.read(buffer) except (error) {
        panic("Cannot read from /dev/urandom: {}", error);
    }
}
