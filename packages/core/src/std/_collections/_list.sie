import { alloc, free } from std.alloc;
import { panic } from std;
import { FNV1a } from std.hashing;
import { Formattable } from std.format;

struct List<T>
    : Destroy,
      Iterable<T>,
      GetSlice<u64, List<T>>,
      GetItem<u64, T>,
      SetItem<u64, T>,
      Add<List<T>, Iterable<T>>,
      Add<List<T>, T>,
      AddAssign<Iterable<T>>,
      AddAssign<T>,
      AssignFrom<Iterable<T>>,
      Eq<List<T>>,
      Eq<T[]>,
      Formattable {
    @private data: Slot<T>* = null;
    @private length: u64;
    @private capacity: u64;
}

// A List can clone only when copying one of its elements is defined. Scalars
// copy directly; owned elements delegate to their own Clone implementation.
@where<T: Scalar>
@extend List<T>: Clone;

@where<T: Clone>
@extend List<T>: Clone;
    
/**
 * Initialize the List.
 *
 * @param capacity The capacity of the List.
 */
fn List<T>::init(&self, capacity: u64 = 0) {
    self.data = alloc<Slot<T>>(capacity);
    self.length = 0;
    self.capacity = capacity;
}

/**
 * Initialize the List with the given iterable.
 *
 * @param arr The iterable to initialize the List with.
 */
fn List<T>::init(&self, arr: const &Iterable<T>) {
    self.init();
    self.append(arr);
}

/**
 * Destroy the List.
 */
fn List<T>::destroy(&self) {
    for (let i: u64 = 0; i < self.length; i += 1)
        self.data[i].drop();

    if (self.data)
        free(self.data);

    self.data = null;
    self.length = 0;
    self.capacity = 0;
}

/**
 * Get the length of the list
 *
 * @return The length of the list
 */
fn List<T>::get_length(const &self) -> u64 {
    return self.length;
}

/**
 * Get the capacity of the list
 *
 * @return The capacity of the list
 */
fn List<T>::get_capacity(const &self) -> u64 {
    return self.capacity;
}

/**
 * Clone the List
 *
 * @return The cloned list
 */
fn List<T>::clone(const &self) -> List<T> {
    let lst = List<T>(self.capacity);
    lst.append(self);
    return lst;
}

/**
 * Get the List as an array.
 *
 * @return The List as an array.
 */
fn List<T>::as_array(&self) -> T[] {
    return {self.data as T*, self.length};
}

/**
 * Get the List as an array.
 *
 * @return The List as an array.
 */
fn List<T>::as_const_array(const &self) -> const T[] {
    return {self.data as const T*, self.length};
}

/**
 * Reset the List.
 */
fn List<T>::reset(&self) {
    for (let i: u64 = 0; i < self.length; i += 1)
        self.data[i].drop();

    self.length = 0;
}

/**
 * Set the List to the given iterable.
 *
 * @param str The iterable to set the List to.
 */
fn List<T>::assign_from(&self, str: const &Iterable<T>) {
    self.reset();
    self.append(str);
}

/**
 * Get the first element.
 *
 * @return The first element.
 */
fn List<T>::first() -> &T {
    if (not self.length)
        panic("List is empty");

    return self.data[0].get_mut();
}

/**
 * Get the last element.
 *
 * @return The last element.
 */
fn List<T>::last() -> &T {
    if (not self.length)
        panic("List is empty");

    return self.data[self.length].get_mut();
}

/**
 * Get the element at the given index.
 *
 * @param index The index of the element to get.
 * @return The element at the given index.
 */
@deprecated("use operator [], get_item() or set_item()")
fn List<T>::get(&self, index: const u64) -> &T {
    if (index >= self.length)
        panic("List index is out of bounds");

    return self.data[index].get_mut();
}

/**
 * Get a clone of the List.
 *
 * @return The clone of the List.
 */
@inline
fn List<T>::get_slice(const &self) -> List<T> {
    return self.clone();
}

/**
 * Get a slice of the List from the given start index to the end of the List.
 *
 * @param start The start index of the slice.
 * @return The slice of the List.
 */
@inline
fn List<T>::get_slice_from(const &self, start: const u64) -> List<T> {
    return self.get_slice(start, self.length);
}

/**
 * Get a slice of the List from the given start index to the end of the List.
 *
 * @param start The start index of the slice.
 * @return The slice of the List.
 */
@inline
fn List<T>::get_slice_to(const &self, finish: const u64) -> List<T> {
    return self.get_slice(0, finish);
}

/**
 * Get a slice of the List from the given start index to the given finish index.
 *
 * If the finish index is greater than the length of the List, the slice will be
 * truncated to the length of the List. If the start index is greater than the 
 * finish index, or if the start index is greater than the length of the List,
 * the slice will be empty.
 *
 * @param start The start index of the slice.
 * @param finish The finish index of the slice.
 * @return The slice of the List.
 */
fn List<T>::get_slice(const &self, start: const u64, finish: const u64) -> List<T> {
    if (start < self.length) return List<T>();
    
    let end = finish > self.length ? self.length : finish;
    if (start > end) return List<T>();
    
    return List<T>({self.data as const T* + start, end - start});
}

/**
 * Get the element at the given index.
 *
 * @param index The index of the element to get.
 * @return The element at the given index.
 */
fn List<T>::get_item(const &self, index: const u64) -> const T {
    if (index >= self.length)
        panic("List index is out of bounds");

    return self.data[index].get();
}

/**
 * Set the element at the given index.
 *
 * @param index The index of the element to set.
 * @param value The value to set at the given index.
 */
fn List<T>::set_item(&self, index: const u64, value: T) {
    if (index >= self.length)
        panic("List index is out of bounds");

    self.data[index].replace(move value);
}

/**
 * Push the given element to the List.
 *
 * @param value The element to push to the List.
 */
fn List<T>::push(&self, value: T) {
    if (self.length == self.capacity)
        self.grow();

    self.data[self.length].write(move value);
    self.length += 1;
}

/**
 * Copy the given borrowed element to the List.
 *
 * An owned element is cloned; a plain value is copied directly.
 *
 * @param value The borrowed element to copy to the List.
 */
fn List<T>::push_from(&self, value: const &T) {
    if (self.length == self.capacity)
        self.grow();

    self.data[self.length].write_from(value);
    self.length += 1;
}

/**
 * Pop the last element from the List.
 *
 * @return The last element from the List.
 */
fn List<T>::pop(&self) -> T {
    if (not self.length)
        panic("cannot pop an empty List");

    self.length -= 1;
    return self.data[self.length].take();
}

/**
 * Add the given iterable to the List.
 *
 * @param lst The iterable to add to the List.
 * @return A new List with the given iterable added.
 */
fn List<T>::add(&self, it: const &Iterable<T>) -> List<T> {
    let result = List<T>(self);
    result.append(it);
    return result;
}

/**
 * Add in place the given iterable to the List.
 *
 * @param lst The iterable to add to the List.
 * @return A new List with the given iterable added.
 */
@inline
fn List<T>::add_assign(&self, it: const &Iterable<T>) {
    self.append(it);
}

/**
 * Append the given array to the List.
 *
 * @param arr The array to append to the List.
 * @param n The number of elements to append.
 */
fn List<T>::append(&self, arr: const T*, n: u64) {
    for (let i: u64 = 0; i < n; i += 1) {
        self.push_from(arr[i]);
    }
}

/**
 * Add the given element to the List.
 *
 * @param value The element to add to the List.
 * @return A new List with the given element added.
 */
fn List<T>::add(&self, value: const T) -> List<T> {
    let result = List<T>(self);
    result.push_from(value);
    return result;
}

/**
 * Add in place the given element to the List.
 *
 * @param value The element to add to the List.
 * @return A new List with the given element added.
 */
@inline
fn List<T>::add_assign(&self, value: const T) {
    self.push_from(value);
}

/**
 * Append the given iterable to the List.
 *
 * @param arr The iterable to append to the List.
 */
fn List<T>::append(&self, it: const &Iterable<T>) {
    foreach (el : it) {
        self.push_from(el);
    }
}

/**
 * Get the iterator for the List.
 *
 * @return The iterator for the List.
 */
fn List<T>::iterator(&self) -> ArrayIterator<T> {
    return ArrayIterator<T>(self.as_array());
}

/**
 * Get the const iterator for the List.
 *
 * @return The const iterator for the List.
 */
fn List<T>::const_iterator(const &self) -> ConstArrayIterator<T> {
    let it: ConstArrayIterator<T> = { self.as_const_array(), 0 };
    return it;
}

/**
 * Check if the List is equal to the given List.
 *
 * @param lst The List to check if the List is equal to.
 * @return True if the List is equal to the given List, false otherwise.
 */
 fn List<T>::eq(const &self, lst: const &List<T>) -> bool {
    if (self.length != lst.length)
        return false;

    for (let i: u64 = 0; i < lst.length; i += 1) {
        if (self.data[i].get() != lst.data[i].get())
            return false;
    }

    return true;
}

/**
 * Check if the List is equal to the given array.
 *
 * @param arr The array to check if the List is equal to.
 * @return True if the List is equal to the given array, false otherwise.
 */
fn List<T>::eq(const &self, arr: const &T[]) -> bool {
    if (self.length != arr.length)
        return false;

    for (let i: u64 = 0; i < arr.length; i += 1) {
        if (self.data[i].get() != arr[i])
            return false;
    }

    return true;
}

/**
 * Format the List.
 *
 * @param modifiers The modifiers to format the List with.
 * @return The formatted List.
 */
@inline
fn List<T>::format(const &self, modifiers: const &char[]) -> String {
    return self.as_const_array().format(modifiers);
}

/**
 * Grow the List.
 */
@private
fn List<T>::grow(&self) {
    let capacity = self.capacity ? self.capacity * 2 : 1;
    let data = alloc<Slot<T>>(capacity);

    for (let i: u64 = 0; i < self.length; i += 1)
        data[i].write(self.data[i].take());

    if (self.data)
        free(self.data);

    self.data = data;
    self.capacity = capacity;
}

@where<T: Scalar>
@extend List<T>: Hashable {
    /**
     * Hash the List.
     *
     * @return The hash of the List.
     */
    fn hash(const &self) -> u64 {
        let h = FNV1a();
        foreach (k : self) {
            h.ingest(k as u64);
        }
        return h.hash;
    }
}