import { malloc, free } from stdlib;
import { panic } from std;

struct Stack<T>: Destroy, Clone {
    @private data: Slot<T>*;
    @private top: u64;
    @private capacity: u64;
}

/**
 * Initialize the Stack.
 *
 * @param capacity The capacity of the Stack.
 */
fn Stack<T>::init(&self, capacity: u64 = 0) {
    self.data = malloc(capacity * @sizeof(Slot<T>)) as Slot<T>*;
    self.top = 0;
    self.capacity = capacity;
}

/**
 * Destroy the Stack.
 */
fn Stack<T>::destroy(&self) {
    for (let i: u64 = 0; i < self.top; i += 1)
        self.data[i].drop();

    if (self.data)
        free(self.data);

    self.data = null;
    self.top = 0;
    self.capacity = 0;
}

/**
 * Clones the Stack.
 *
 * @return The cloned Stack.
 */
fn Stack<T>::clone(const &self) -> Stack<T> {
    let s = Stack<T>(self.capacity);
    for (let i: u64 = 0; i < self.top; i += 1) {
        s.push_from(self.data[i].get());
    }
    return s;
}

/**
 * Push the given value to the Stack.
 *
 * @param value The value to push to the Stack.
 */
fn Stack<T>::push(&self, value: T) {
    if (self.top == self.capacity)
        self.grow();

    self.data[self.top].write(move value);
    self.top += 1;
}

/**
 * Copy the given borrowed value to the Stack.
 *
 * An owned value is cloned; a plain value is copied directly.
 *
 * @param value The borrowed value to copy to the Stack.
 */
fn Stack<T>::push_from(&self, value: const &T) {
    if (self.top == self.capacity)
        self.grow();

    self.data[self.top].write_from(value);
    self.top += 1;
}

/**
 * Pop the last element from the Stack.
 *
 * @return The last element from the Stack.
 */
fn Stack<T>::pop(&self) -> T {
    if (not self.top)
        panic("cannot pop an empty Stack");

    self.top -= 1;
    return self.data[self.top].take();
}

/**
 * Get the last element from the Stack.
 *
 * @return The last element from the Stack.
 */
fn Stack<T>::peek(const &self) -> const &T {
    if (not self.top)
        panic("cannot peek an empty Stack");

    return self.data[self.top - 1].get();
}

/**
 * Check if the Stack is empty.
 *
 * @return True if the Stack is empty, false otherwise.
 */
fn Stack<T>::is_empty(const &self) -> bool {
    return self.top == 0;
}

/**
 * Grow the Stack.
 */
@private
fn Stack<T>::grow(&self) {
    let capacity = self.capacity ? self.capacity * 2 : 1;
    let data = malloc(capacity * @sizeof(Slot<T>)) as Slot<T>*;

    for (let i: u64 = 0; i < self.top; i += 1)
        data[i].write(self.data[i].take());

    if (self.data)
        free(self.data);

    self.data = data;
    self.capacity = capacity;
}
