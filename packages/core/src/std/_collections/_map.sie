import { panic } from std;
import { format } from std.format;
import { Hashable } from std.hashing;
import { String } from std.collections;
import { malloc, free } from stdlib;

@private
enum MapEntryState {
    Empty,
    Used,
    Tombstone,
}

enum MapIndexError {
    NotFound,
}

struct KeyValuePair<K, V> {
    key: const K;
    value: V;
}

@private
struct MapEntry<K, V> {
    key: Slot<K>;
    value: Slot<V>;
    state: MapEntryState;
}

struct Map<K: Hashable, V>
    : Destroy,
      Iterable<KeyValuePair<K, V>>,
      Formattable {
    entries: MapEntry<K, V>*;
    size: u64;
    capacity: u64;
}

struct MapIterator<K, V>: Iterator<KeyValuePair<K, V>> {
    entries: MapEntry<K, V>[];
    index: u64;
}

struct ConstMapIterator<K, V>: ConstIterator<KeyValuePair<K, V>> {
    entries: const MapEntry<K, V>[];
    index: u64;
}

/**
 * Initializes a new map with the given capacity.
 *
 * @param capacity The initial capacity of the map.
 */
fn Map<K, V>::init(&self, capacity: u64 = 0) {
    self.entries = malloc(capacity * @sizeof(MapEntry<K, V>)) as MapEntry<K, V>*;
    self.size = 0;
    self.capacity = capacity;

    for (let i: u64 = 0; i < capacity; i += 1) {
        self.entries[i].state = MapEntryState::Empty;
    }
}

/**
 * Destroys the map and frees the memory.
 */
fn Map<K, V>::destroy(&self) {
    for (let i: u64 = 0; i < self.capacity; i += 1) {
        if (self.entries[i].state == MapEntryState::Used) {
            self.entries[i].key.drop();
            self.entries[i].value.drop();
        }
    }

    if (self.entries)
        free(self.entries);

    self.entries = null;
    self.size = 0;
    self.capacity = 0;
}

fn Map<K, V>::format(const &self, modifiers: const &char[]) -> String {
    let str = String();
    str += "{";
    foreach (entry : enumerate(self)) {
        if (entry.index) str += ", ";
        str += format("{}: {}", entry.value.key, entry.value.value);
    }
    str += "}";

    return str;
}

@template<K: Iterable<char>>
@override
fn Map<K, V>::format(const &self, modifiers: const &char[]) -> String {
    let str = String();
    str += "{";
    foreach (entry : enumerate(self)) {
        if (entry.index) str += ", ";
        str += format("\"{}\": {}", entry.value.key, entry.value.value);
    }
    str += "}";

    return str;
}

/**
 * Gets the used entry for the given key.
 *
 * @param key The key to get the entry for.
 * @return The entry for the given key.
 */
@private
fn Map<K: Hashable, V>::get_used_entry(const &self, key: const &K) -> const MapEntry<K, V>* {
    if (not self.capacity)
        return null;

    let entries = self.entries;
    let slot = key.hash() % self.capacity;

    while (self.entries[slot].state != MapEntryState::Empty) {
        if (self.entries[slot].state == MapEntryState::Used) {
            if (self.entries[slot].key.get() == key) {
                return &entries[slot];
            }
        }
        slot = (slot + 1) % self.capacity;
    }

    return null;
}

/**
 * Gets the mutable used entry for the given key.
 *
 * @param key The key to get the entry for.
 * @return The entry for the given key.
 */
@private
fn Map<K: Hashable, V>::get_used_entry_mut(&self, key: const &K) -> MapEntry<K, V>* {
    if (not self.capacity)
        return null;

    let entries = self.entries;
    let slot = key.hash() % self.capacity;

    while (entries[slot].state != MapEntryState::Empty) {
        if (entries[slot].state == MapEntryState::Used) {
            if (entries[slot].key.get() == key)
                return &entries[slot];
        }
        slot = (slot + 1) % self.capacity;
    }

    return null;
}

/**
 * Gets the entry for the given key.
 *
 * @param key The key to get the entry for.
 * @return The entry for the given key.
 */
@private
fn Map<K: Hashable, V>::get_entry(&self, key: const &K) -> MapEntry<K, V>* {
    if (self.size * 10 >= self.capacity * 7)
        self.grow();

    let entries = self.entries;
    let slot = key.hash() % self.capacity;
    let tombstone: MapEntry<K, V>* = null;

    while (self.entries[slot].state != MapEntryState::Empty) {
        if (entries[slot].state == MapEntryState::Used) {
            if (entries[slot].key.get() == key)
                return &entries[slot];
        } else if (not tombstone)
            tombstone = &entries[slot];

        slot = (slot + 1) % self.capacity;
    }

    if (tombstone)
        return tombstone;

    return &entries[slot];
}

/**
 * Gets the value for the given key.
 *
 * @param key The key to get the value for.
 * @param out The output value.
 * @return The result of the operation.
 */
fn Map<K, V>::get(const &self, key: const &K, out: &V) -> Result<MapIndexError> {
    let entry = self.get_used_entry(key);
    if (not entry)
        return Error(MapIndexError::NotFound);

    entry->value.assign_to(out);
    return Ok();
}

/**
 * Sets the value for the given key.
 *
 * @param key The key to set the value for.
 * @param value The value to set.
 */
fn Map<K, V>::set(&self, key: const &K, value: V) {
    let entry = self.get_entry(key);
    if (entry->state == MapEntryState::Used) {
        entry->value.replace(move value);
        return;
    }

    entry->key.write_from(key);
    entry->value.write(move value);
    entry->state = MapEntryState::Used;
    self.size += 1;
}

/**
 * Removes the value for the given key.
 *
 * @param key The key to remove the value for.
 * @return The result of the operation.
 */
fn Map<K, V>::remove(&self, key: const &K) -> Result<MapIndexError> {
    let entry = self.get_used_entry_mut(key);
    if (not entry)
        return Error(MapIndexError::NotFound);

    entry->key.drop();
    entry->value.drop();
    entry->state = MapEntryState::Tombstone;
    self.size -= 1;
    return Ok();
}

/**
 * Grows the capacity of the map to the next power of two.
 */
@private
fn Map<K, V>::grow(&self) {
    let old_capacity = self.capacity;
    let old_entries = self.entries;

    self.capacity = self.capacity ? 2 * self.capacity : 5;
    self.entries = malloc(self.capacity * @sizeof(MapEntry<K, V>)) as MapEntry<K, V>*;

    for (let i: u64 = 0; i < self.capacity; i += 1)
        self.entries[i].state = MapEntryState::Empty;

    for(let i: u64 = 0; i < old_capacity; i += 1) {
        if (old_entries[i].state == MapEntryState::Used) {
            let entry = self.get_entry(old_entries[i].key.get());
            entry->key.write(old_entries[i].key.take());
            entry->value.write(old_entries[i].value.take());
            entry->state = MapEntryState::Used;
            old_entries[i].state = MapEntryState::Empty;
        }
    }

    free(old_entries);
}

/**
 * Gets the iterator for the map.
 *
 * @return The iterator for the map.
 */
fn Map<K, V>::iterator(&self) -> MapIterator<K, V> {
    return MapIterator<K, V>({self.entries, self.capacity});
}

/**
 * Gets the const iterator for the map.
 *
 * @return The const iterator for the map.
 */
fn Map<K, V>::const_iterator(const &self) -> ConstMapIterator<K, V> {
    return ConstMapIterator<K, V>({self.entries, self.capacity});
}

/**
 * Initializes the iterator with the given entries.
 *
 * @param entries The entries to initialize the iterator with.
 */
fn MapIterator<K, V>::init(&self, entries: MapEntry<K, V>[]) {
    self = {entries, 0};
}

/**
 * Checks if the iterator has a next element.
 *
 * @return True if the iterator has a next element, false otherwise.
 */
fn MapIterator<K, V>::has_next(&self) -> bool {
    while (self.index < self.entries.length) {
        if (self.entries[self.index].state == MapEntryState::Used)
            return true;

        self.index += 1;
    }

    return false;
}

/**
 * Gets the next element from the iterator.
 *
 * @return The next element from the iterator.
 */
fn MapIterator<K, V>::next(&self) -> &KeyValuePair<K, V> {
    while (self.index < self.entries.length) {
        defer self.index += 1;
        
        if (self.entries[self.index].state == MapEntryState::Used)
            return self.entries[self.index] as KeyValuePair<K, V>;
    }

    panic("called {}::next() without calling {}::hash_next() before", @typename(self), @typename(self));
}

/**
 * Initializes the const iterator with the given entries.
 *
 * @param entries The entries to initialize the const iterator with.
 */
fn ConstMapIterator<K, V>::init(&self, entries: const MapEntry<K, V>[]) {
    self = {entries, 0};
}

/**
 * Checks if the const iterator has a next element.
 *
 * @return True if the const iterator has a next element, false otherwise.
 */
fn ConstMapIterator<K, V>::has_next(&self) -> bool {
    while (self.index < self.entries.length) {
        if (self.entries[self.index].state == MapEntryState::Used)
            return true;
        
        self.index += 1;
    }

    return false;
}

/**
 * Gets the next element from the const iterator.
 *
 * @return The next element from the const iterator.
 */
fn ConstMapIterator<K, V>::next(&self) -> const &KeyValuePair<K, V> {
    while (self.index < self.entries.length) {
        defer self.index += 1;

        if (self.entries[self.index].state == MapEntryState::Used)
            return self.entries[self.index] as const KeyValuePair<K, V>;
    }

    panic("called {}::next() without calling {}::hash_next() before", @typename(self), @typename(self));
}
