import { malloc, free } from stdlib;
import { panic } from std;

@private
struct QueueNode<T> {
    value: Slot<T>;
    next: QueueNode<T>* = null;
}

struct QueueIterator<T>: Iterator<T> {
    @private current: QueueNode<T>*; // next node to yield

    @private
    fn init(&self, current: QueueNode<T>*) {
        self.current = current;
    }

    /**
     * Check if the QueueIterator has a next element.
     *
     * @return True if the QueueIterator has a next element, false otherwise.
     */
    fn has_next(&self) -> bool {
        return self.current != null;
    }
    
    /**
     * Get the next element from the QueueIterator.
     *
     * @return The next element from the QueueIterator.
     */
    fn next(&self) -> &T {
        if (not self.current)
            panic("cannot advance an exhausted QueueIterator");
    
        let current = self.current;
        self.current = self.current->next;
        return current->value.get_mut();
    }
}

@private
struct ConstQueueCursor<T> {
    current: const QueueNode<T>*;
}

struct ConstQueueIterator<T>: ConstIterator<T> {
    @private cursor: ConstQueueCursor<T>; // replaced whole as the iterator advances

    @private
    fn init(&self, current: const QueueNode<T>*) {
        self.cursor = { current };
    }

    /**
     * Check if the ConstQueueIterator has a next element.
     *
     * @return True if the ConstQueueIterator has a next element, false otherwise.
     */
    fn has_next(const &self) -> bool {
        return self.cursor.current != null;
    }
    
    /**
     * Get the next element from the ConstQueueIterator.
     *
     * @return The next element from the ConstQueueIterator.
     */
    fn next(&self) -> const &T {
        if (not self.cursor.current)
            panic("cannot advance an exhausted ConstQueueIterator");
    
        let current = self.cursor.current;
        self.cursor = { current->next };
        return current->value.get();
    }
}

// Linked-list FIFO queue<T>. Values enqueue at the tail and dequeue at the
// head, both in O(1). Nodes are heap-allocated per push.
struct Queue<T>
    : Clone,
      Destroy,
      Iterable<T> {
    @private head: QueueNode<T>*;   // front: next to dequeue (oldest)
    @private tail: QueueNode<T>*;   // back: last enqueued (newest)
}

/**
 * Initialize the Queue.
 */
fn Queue<T>::init(&self) {
    self.head = null;
    self.tail = null;
}

/**
 * Destroy the Queue.
 */
fn Queue<T>::destroy(&self) {
    while (self.head) {
        let node = self.head;
        self.head = node->next;

        node->value.drop();
        free(node);
    }

    self.tail = null;
}

fn Queue<T>::clone(const &self) -> Queue<T> {
    let q = Queue<T>();
    foreach (v : self) {
        q.push_from(v);
    }
    return q;
}

/**
 * Push the given value to the Queue.
 *
 * @param value The value to push to the Queue.
 */
fn Queue<T>::push(&self, value: T) {
    let node = malloc(@sizeof(QueueNode<T>)) as QueueNode<T>*;
    node->next = null;
    node->value.write(move value);
    
    if (self.tail == null) {
        self.head = node;
    } else {
        self.tail->next = node;
    }
    
    self.tail = node;
}

/**
 * Copy the given borrowed value to the Queue.
 *
 * An owned value is cloned; a plain value is copied directly.
 *
 * @param value The borrowed value to copy to the Queue.
 */
fn Queue<T>::push_from(&self, value: const &T) {
    let node = malloc(@sizeof(QueueNode<T>)) as QueueNode<T>*;
    node->next = null;
    node->value.write_from(value);

    if (self.tail == null) {
        self.head = node;
    } else {
        self.tail->next = node;
    }

    self.tail = node;
}

/**
 * Pop the last element from the Queue.
 *
 * @return The last element from the Queue.
 */
fn Queue<T>::pop(&self) -> T {
    if (self.is_empty())
        panic("cannot pop an empty Queue");

    let node = self.head;
    self.head = node->next;
    
    if (self.head == null)
        self.tail = null;
    
    let value = node->value.take();
    free(node);

    return value;
}

/**
 * Get the last element from the Queue.
 *
 * @return The last element from the Queue.
 */
fn Queue<T>::peek(const &self) -> const &T {
    if (self.is_empty())
        panic("cannot peek an empty Queue");

    return self.head->value.get();
}

/**
 * Check if the Queue is empty.
 *
 * @return True if the Queue is empty, false otherwise.
 */
fn Queue<T>::is_empty(const &self) -> bool {
    return self.head == null;
}

/**
 * Get the iterator for the Queue.
 *
 * @return The iterator for the Queue.
 */
fn Queue<T>::iterator(&self) -> QueueIterator<T> {
    return QueueIterator<T>(self.head);
}

/**
 * Get the const iterator for the Queue.
 *
 * @return The const iterator for the Queue.
 */
fn Queue<T>::const_iterator(const &self) -> ConstQueueIterator<T> {
    return ConstQueueIterator<T>(self.head);
}
