import std.array;
import { List } from _list;
import { Formattable } from std.format;

@type String = List<char>;

@extend String
    : Add<String, !char*>,
      AddAssign<!char*>,
      Eq<!char*>,
      Formattable {
    /**
    * Initialize the String with the given array.
    *
    * @param arr The array to initialize the String with.
    */
    fn init(&self, arr: const !char*) {
        self.init();
        self.append(arr);
    }

    /**
    * Create a new String from the given null-terminated array.
    *
    * @param src The null-terminated array to create the String from.
    * @return The new String.
    */
    fn null_terminated(src: const !char*) -> String {
        return String(src).null_terminate();
    }

    /**
    * Create a new String from the given iterable.
    *
    * @param src The iterable to create the String from.
    * @return The new String.
    */
    fn null_terminated(src: const &Iterable<char>) -> String {
        return String(src).null_terminate();
    }

    /**
    * Null terminate the String.
    */
    fn null_terminate(&self) -> self {
        self.push('\0');
        self.pop();
    }

    /**
    * Add the given null-terminated array to the String.
    *
    * @param arr The array to add to the String.
    * @return The resulting String.
    */
    fn add(&self, arr: const !char*) -> String {
        let result = String(self);
        result.append(arr);
        return result;
    }

    /**
    * Add in place the given null-terminated array to the String.
    *
    * @param arr The array to add to the String.
    * @return The resulting String.
    */
    fn add_assign(&self, arr: const !char*) {
        self.append(arr);
    }

    fn split(const &self, div: char) -> List<String> {
        return self.as_const_array().split(div);
    }

    /**
    * Check if the String is equal to the given null-terminated pointer.
    *
    * @param arr The char pointer to check if the String is equal to.
    * @return True if the String is equal to the given array, false otherwise.
    */
    fn eq(const &self, arr: const !char*) -> bool {
        for (let i: u64 = 0; i < self.length; i += 1) {
            if (arr[i] == 0 or self.data[i].get() != arr[i])
                return false;
        }

        return arr[self.length] == 0;
    }

    /**
    * Append the given array to the String.
    *
    * @param arr The array to append to the String.
    */
    fn append(&self, arr: const !char*) {
        for (let i: u64 = 0; arr[i]; i += 1) {
            self.push(arr[i]);
        }
    }

    /**
    * Set the String to the given array.
    *
    * @param arr The array to set the String to.
    */
    fn assign(&self, arr: const !char*) {
        self.reset();
        self.append(arr);
    }

    /**
    * Convert the String to a byte array.
    *
    * @return The byte array.
    */
    @inline
    fn as_bytes(&self) -> u8[] {
        if (self.capacity == 0) return [];
        return {(self.data as u8*)!, self.length};
    }

    /**
    * Convert the String to a byte array.
    *
    * @return The byte array.
    */
    @inline
    fn as_const_bytes(const &self) -> const u8[] {
        if (self.capacity == 0) return [];
        return {(self.data as const u8*)!, self.length};
    }

    /**
    * Convert the String to a C string.
    *
    * @return The C string.
    */
    @inline
    fn c_str(&self) -> char* {
        self.null_terminate();
        return self.data as char*;
    }
}
