import { GObject, GType, G_TYPE_CHECK_INSTANCE_CAST, G_TYPE_CHECK_INSTANCE_TYPE } from gobject;
import { GtkWindow } from gtkwindow;
import { GList } from glib;

@macro GTK_TYPE_WINDOW_GROUP = gtk_window_group_get_type();
@macro GTK_WINDOW_GROUP(object) = G_TYPE_CHECK_INSTANCE_CAST<GtkWindowGroup>(object, GTK_TYPE_WINDOW_GROUP);
@macro GTK_IS_WINDOW_GROUP(object) = G_TYPE_CHECK_INSTANCE_TYPE(object, GTK_TYPE_WINDOW_GROUP);

struct GtkWindowGroup {
    parent_instance: GObject;
    priv: GtkWindowGroupPrivate*;
}

struct GtkWindowGroupPrivate;

@extern fn gtk_window_group_get_type() -> GType;
@extern fn gtk_window_group_new() -> GtkWindowGroup*;
@extern fn gtk_window_group_add_window(window_group: GtkWindowGroup*,
                                       window: GtkWindow*);
@extern fn gtk_window_group_remove_window(window_group: GtkWindowGroup*,
                                          window: GtkWindow*);
@extern fn gtk_window_group_list_windows(window_group: GtkWindowGroup*) -> GList*;
