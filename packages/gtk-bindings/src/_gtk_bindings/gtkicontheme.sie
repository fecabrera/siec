//                                           icon: GIcon*,
//                                           size: i32,
//                                           scale: i32,
//                                           direction: GtkTextDirection,
//                                           flags: GtkIconLookupFlags) -> GtkIconPaintable*;
@extern fn gtk_icon_theme_get_icon_names(theme: GtkIconTheme*) -> char**;
