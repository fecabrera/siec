import { GType, G_TYPE_CHECK_INSTANCE_CAST, G_TYPE_CHECK_INSTANCE_TYPE } from gobject;
import { GtkWidget } from gtkwidget;

@macro GTK_TYPE_WINDOW_HANDLE = gtk_window_handle_get_type();
@macro GTK_WINDOW_HANDLE(object) = G_TYPE_CHECK_INSTANCE_CAST<GtkWindowHandle>(object, GTK_TYPE_WINDOW_HANDLE);
@macro GTK_IS_WINDOW_HANDLE(object) = G_TYPE_CHECK_INSTANCE_TYPE(object, GTK_TYPE_WINDOW_HANDLE);

struct GtkWindowHandle {
    parent_instance: GtkWidget;
}

@extern fn gtk_window_handle_get_type() -> GType;
@extern fn gtk_window_handle_new() -> GtkWidget*;
@extern fn gtk_window_handle_get_child(self: GtkWindowHandle*) -> GtkWidget*;
@extern fn gtk_window_handle_set_child(self: GtkWindowHandle*,
                                       child: GtkWidget*);
