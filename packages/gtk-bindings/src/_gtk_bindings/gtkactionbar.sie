import { gboolean } from glib;
import { GType, G_TYPE_CHECK_INSTANCE_CAST, G_TYPE_CHECK_INSTANCE_TYPE } from gobject;
import { GtkWidget } from gtkwidget;

@macro GTK_TYPE_ACTION_BAR = gtk_action_bar_get_type();
@macro GTK_ACTION_BAR(obj) = G_TYPE_CHECK_INSTANCE_CAST<GtkActionBar>(obj, GTK_TYPE_ACTION_BAR);
@macro GTK_IS_ACTION_BAR(obj) = G_TYPE_CHECK_INSTANCE_TYPE(obj, GTK_TYPE_HEADER_BAR);

struct GtkActionBar {
    parent_instance: GtkWidget;
}

@extern fn gtk_action_bar_get_type() -> GType;
@extern fn gtk_action_bar_new() -> GtkWidget*;
@extern fn gtk_action_bar_get_center_widget(action_bar: GtkActionBar*) -> GtkWidget*;
@extern fn gtk_action_bar_set_center_widget(action_bar: GtkActionBar*,
                                            center_widget: GtkWidget*);
@extern fn gtk_action_bar_pack_start(action_bar: GtkActionBar*,
                                     child: GtkWidget*);
@extern fn gtk_action_bar_pack_end(action_bar: GtkActionBar*,
                                   child: GtkWidget*);
@extern fn gtk_action_bar_remove(action_bar: GtkActionBar*,
                                 child: GtkWidget*);
@extern fn gtk_action_bar_set_revealed(action_bar: GtkActionBar*,
                                       revealed: GtkWidget*);
@extern fn gtk_action_bar_get_revealed(action_bar: GtkActionBar*) -> GtkWidget*;
