import { GObject, GType, G_TYPE_CHECK_INSTANCE_CAST, G_TYPE_CHECK_INSTANCE_TYPE } from gobject;
import { GdkDisplay } from gdkdisplay;
import { GdkDevice } from gdkdevice;
import { GList } from glib;

@macro GDK_TYPE_SEAT = gdk_seat_get_type();
@macro GDK_SEAT(o) = G_TYPE_CHECK_INSTANCE_CAST<GdkSeat>(o, GDK_TYPE_SEAT);
@macro GDK_IS_SEAT(o) = G_TYPE_CHECK_INSTANCE_TYPE(o, GDK_TYPE_SEAT);

enum GdkSeatCapabilities {
    NONE          = 0,
    POINTER       = 1 << 0,
    TOUCH         = 1 << 1,
    TABLET_STYLUS = 1 << 2,
    KEYBOARD      = 1 << 3,
    TABLET_PAD    = 1 << 4,
    ALL_POINTING  = GdkSeatCapabilities::POINTER | GdkSeatCapabilities::TOUCH | GdkSeatCapabilities::TABLET_STYLUS,
    ALL           = GdkSeatCapabilities::ALL_POINTING | GdkSeatCapabilities::KEYBOARD | GdkSeatCapabilities::TABLET_PAD,
}

struct GdkSeat {
    parent_instance: GObject;
}

@extern fn gdk_clipboard_get_type() -> GType;
@extern fn gdk_seat_get_display(seat: GdkSeat*) -> GdkDisplay*;
@extern fn gdk_seat_get_capabilities(seat: GdkSeat*) -> GdkSeatCapabilities;
@extern fn gdk_seat_get_devices(seat: GdkSeat*,
                                capabilities: GdkSeatCapabilities) -> GList*;
@extern fn gdk_seat_get_tools(seat: GdkSeat*) -> GList*;
@extern fn gdk_seat_get_pointer(seat: GdkSeat*) -> GdkDevice*;
@extern fn gdk_seat_get_keyboard(seat: GdkSeat*) -> GdkDevice*;