enum GdkColorChannel {
    RED = 0,
    GREEN = 1,
    BLUE = 2,
    ALPHA = 3
}

enum GdkGLAPI { /*< underscore_name=GDK_GL_API >*/
    GL   = 1 << 0,
    GLES = 1 << 1,
}

enum GdkGravity {
    NORTH_WEST = 1,
    NORTH,
    NORTH_EAST,
    WEST,
    CENTER,
    EAST,
    SOUTH_WEST,
    SOUTH,
    SOUTH_EAST,
    STATIC,
}

enum GdkModifierType {
    NO_MODIFIER_MASK    = 0,
  
    SHIFT_MASK          = 1 << 0,
    LOCK_MASK           = 1 << 1,
    CONTROL_MASK        = 1 << 2,
    ALT_MASK            = 1 << 3,
  
    BUTTON1_MASK        = 1 << 8,
    BUTTON2_MASK        = 1 << 9,
    BUTTON3_MASK        = 1 << 10,
    BUTTON4_MASK        = 1 << 11,
    BUTTON5_MASK        = 1 << 12,
  
    SUPER_MASK          = 1 << 26,
    HYPER_MASK          = 1 << 27,
    META_MASK           = 1 << 28,
}

@macro GDK_MODIFIER_MASK = (GdkModifierType::SHIFT_MASK | GdkModifierType::LOCK_MASK |
                            GdkModifierType::CONTROL_MASK | GdkModifierType::ALT_MASK | 
                            GdkModifierType::SUPER_MASK | GdkModifierType::HYPER_MASK |
                            GdkModifierType::META_MASK | GdkModifierType::BUTTON1_MASK |
                            GdkModifierType::BUTTON2_MASK | GdkModifierType::BUTTON3_MASK |
                            GdkModifierType::BUTTON4_MASK | GdkModifierType::BUTTON5_MASK);

enum GdkDmabufError {
    NOT_AVAILABLE,
    UNSUPPORTED_FORMAT,
    CREATION_FAILED,
}

enum GdkGLError {
    NOT_AVAILABLE,
    UNSUPPORTED_FORMAT,
    UNSUPPORTED_PROFILE,
    COMPILATION_FAILED,
    LINK_FAILED
}

enum GdkVulkanError {
    UNSUPPORTED,
    NOT_AVAILABLE,
}

enum GdkAxisUse {
    IGNORE,
    X,
    Y,
    DELTA_X,
    DELTA_Y,
    PRESSURE,
    XTILT,
    YTILT,
    WHEEL,
    DISTANCE,
    ROTATION,
    SLIDER,
    LAST
}

enum GdkAxisFlags {
    X        = 1 << GdkAxisUse::X,
    Y        = 1 << GdkAxisUse::Y,
    DELTA_X  = 1 << GdkAxisUse::DELTA_X,
    DELTA_Y  = 1 << GdkAxisUse::DELTA_Y,
    PRESSURE = 1 << GdkAxisUse::PRESSURE,
    XTILT    = 1 << GdkAxisUse::XTILT,
    YTILT    = 1 << GdkAxisUse::YTILT,
    WHEEL    = 1 << GdkAxisUse::WHEEL,
    DISTANCE = 1 << GdkAxisUse::DISTANCE,
    ROTATION = 1 << GdkAxisUse::ROTATION,
    SLIDER   = 1 << GdkAxisUse::SLIDER,
}

enum GdkDragAction {
    NONE     = 0,
    COPY     = 1 << 0,
    MOVE     = 1 << 1,
    LINK     = 1 << 2,
    ASK      = 1 << 3,
    ALL      = GdkDragAction::COPY | GdkDragAction::MOVE | GdkDragAction::LINK,
}

enum GdkScrollRelativeDirection {
    IDENTICAL,
    INVERTED,
    UNKNOWN,
}

enum GdkMemoryFormat {
    B8G8R8A8_PREMULTIPLIED,
