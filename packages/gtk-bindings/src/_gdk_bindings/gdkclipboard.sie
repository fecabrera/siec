import { GValue, GType, G_TYPE_CHECK_INSTANCE_CAST, G_TYPE_CHECK_INSTANCE_TYPE } from gobject;
import { GError, gboolean, gpointer } from glib;
import { GdkDisplay } from gdkdisplay;
import { GdkTexture } from gdktexture;
import { GdkContentFormats } from gdkcontentformats;

@macro GDK_TYPE_CLIPBOARD = gdk_clipboard_get_type();
@macro GDK_CLIPBOARD(obj) = G_TYPE_CHECK_INSTANCE_CAST<GdkClipboard>(obj, GDK_TYPE_CLIPBOARD);
@macro GDK_IS_CLIPBOARD(obj) = G_TYPE_CHECK_INSTANCE_TYPE(obj, GDK_TYPE_CLIPBOARD);

struct GdkClipboard;

@extern fn gdk_clipboard_get_type() -> GType;
@extern fn gdk_clipboard_get_display(clipboard: GdkClipboard*) -> GdkDisplay*;
@extern fn gdk_clipboard_get_formats(clipboard: GdkClipboard*) -> GdkContentFormats*;
@extern fn gdk_clipboard_is_local(clipboard: GdkClipboard*) -> gboolean;
