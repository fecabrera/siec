import { GType, G_TYPE_CHECK_INSTANCE_CAST, G_TYPE_CHECK_INSTANCE_TYPE } from gobject;

@macro GDK_TYPE_CLIPBOARD = gdk_clipboard_get_type();
@macro GDK_CLIPBOARD(obj) = G_TYPE_CHECK_INSTANCE_CAST<GdkClipboard>(obj, GDK_TYPE_CLIPBOARD);
@macro GDK_IS_CLIPBOARD(obj) = G_TYPE_CHECK_INSTANCE_TYPE(obj, GDK_TYPE_CLIPBOARD);

struct GdkClipboard;

@extern fn gdk_clipboard_get_type() -> GType;