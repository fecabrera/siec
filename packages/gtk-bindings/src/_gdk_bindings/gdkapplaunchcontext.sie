import { GType, G_TYPE_CHECK_INSTANCE_CAST, G_TYPE_CHECK_INSTANCE_TYPE } from gobject;
import { GdkDisplay } from gdkdisplay;
import { GIcon } from gio;
import { guint32 } from glib;

@macro GDK_TYPE_APP_LAUNCH_CONTEXT = gdk_app_launch_context_get_type();
@macro GDK_APP_LAUNCH_CONTEXT(o) = G_TYPE_CHECK_INSTANCE_CAST<GdkAppLaunchContext>(o, GDK_TYPE_APP_LAUNCH_CONTEXT);
@macro GDK_IS_APP_LAUNCH_CONTEXT(o) = G_TYPE_CHECK_INSTANCE_TYPE(o, GDK_TYPE_APP_LAUNCH_CONTEXT);

struct GdkAppLaunchContext;

@extern fn gdk_app_launch_context_get_type() -> GType;
@extern fn gdk_app_launch_context_get_display(context: GdkAppLaunchContext*) -> GdkDisplay*;
@extern fn gdk_app_launch_context_set_desktop(context: GdkAppLaunchContext*,
                                              desktop: i32);
@extern fn gdk_app_launch_context_set_timestamp(context: GdkAppLaunchContext*,
                                                timestamp: guint32);
@extern fn gdk_app_launch_context_set_icon(context: GdkAppLaunchContext*,
                                           icon: GIcon*);
@extern fn gdk_app_launch_context_set_icon_name(context: GdkAppLaunchContext*,
                                                icon_name: const char*);