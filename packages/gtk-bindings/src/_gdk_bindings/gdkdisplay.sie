import { GType, G_TYPE_CHECK_INSTANCE_CAST, G_TYPE_CHECK_INSTANCE_TYPE } from gobject;
import { GError, GList, gboolean, guint } from glib;
import { GValue } from gobject;
import { GdkDevice } from gdkdevice;
import { GdkClipboard } from gdkclipboard;
import { GdkGLContext } from gdktypes;

@macro GDK_TYPE_DISPLAY = gdk_display_get_type();
@macro GDK_DISPLAY(object) = G_TYPE_CHECK_INSTANCE_CAST<GdkDisplay>(object, GDK_TYPE_DISPLAY);
@macro GDK_IS_DISPLAY(object) = G_TYPE_CHECK_INSTANCE_TYPE(object, GDK_TYPE_DISPLAY);

struct GdkDisplay;

@extern fn gdk_display_get_type() -> GType;
@extern fn gdk_display_open(display_name: const char*) -> GdkDisplay*;
@extern fn gdk_display_get_name(display: GdkDisplay*) -> const char*;
@extern fn gdk_display_device_is_grabbed(display: GdkDisplay*,
                                         device: GdkDevice*) -> gboolean;
@extern fn gdk_display_beep(display: GdkDisplay*);
@extern fn gdk_display_sync(display: GdkDisplay*);
@extern fn gdk_display_flush(display: GdkDisplay*);
@extern fn gdk_display_close(display: GdkDisplay*);
@extern fn gdk_display_is_closed(display: GdkDisplay*) -> gboolean;
@extern fn gdk_display_is_composited(display: GdkDisplay*) -> gboolean;
@extern fn gdk_display_is_rgba(display: GdkDisplay*) -> gboolean;
@extern fn gdk_display_supports_shadow_width(display: GdkDisplay*) -> gboolean;
@extern fn gdk_display_supports_input_shapes(display: GdkDisplay*) -> gboolean;
@extern fn gdk_display_prepare_gl(display: GdkDisplay*,
                                  error: GError**) -> gboolean;
@extern fn gdk_display_create_gl_context(display: GdkDisplay*,
                                         error: GError**) -> GdkGLContext*;
@extern fn gdk_display_get_default() -> GdkDisplay*;
@extern fn gdk_display_get_clipboard(display: GdkDisplay*) -> GdkClipboard*;
@extern fn gdk_display_get_primary_clipboard(display: GdkDisplay*) -> GdkClipboard*;
@deprecated("use gdk_toplevel_set_startup_id")
@extern fn gdk_display_notify_startup_complete(display: GdkDisplay*,
                                               startup_id: const char*);
@deprecated
@extern fn gdk_display_get_startup_notification_id(display: GdkDisplay*) -> const char*;
