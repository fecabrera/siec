import { GObject, G_TYPE_CHECK_INSTANCE_CAST, GType } from gobject;

@macro G_TYPE_APPLICATION = g_application_get_type();
@macro G_APPLICATION(instance) = G_TYPE_CHECK_INSTANCE_CAST<GApplication>(instance, G_TYPE_APPLICATION);

struct GApplication {
  /*< private >*/
  parent_instance: GObject;
  priv: GApplicationPrivate*;
}

struct GApplicationPrivate;

@extern
fn g_application_get_type() -> GType;

@extern
fn g_application_run(application: GApplication*, argc: i32, argv: char**) -> i32;
