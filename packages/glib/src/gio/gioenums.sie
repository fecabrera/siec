enum GApplicationFlags {
    DEFAULT_FLAGS           = 0,
    IS_SERVICE              = (1 << 0),
    IS_LAUNCHER             = (1 << 1),
    HANDLES_OPEN            = (1 << 2),
    HANDLES_COMMAND_LINE    = (1 << 3),
    SEND_ENVIRONMENT        = (1 << 4),
    NON_UNIQUE              = (1 << 5),
    CAN_OVERRIDE_APP_ID     = (1 << 6),
    ALLOW_REPLACEMENT       = (1 << 7),
    REPLACE                 = (1 << 8),
}
