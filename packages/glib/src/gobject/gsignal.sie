import { gchar, gpointer, gulong } from glib;
import { GCallback, GClosureNotify } from gclosure;

enum GConnectFlags {
    DEFAULT = 0,
    AFTER	= 1 << 0,
    SWAPPED	= 1 << 1
}

@macro g_signal_connect(instance, detailed_signal, c_handler, data) =
    g_signal_connect_data(instance, detailed_signal as const gchar*, c_handler, data, null, GConnectFlags::DEFAULT);

@macro g_signal_connect_swapped(instance, detailed_signal, c_handler, data) =
    g_signal_connect_data(instance, detailed_signal as const gchar*, c_handler, data, null, GConnectFlags::SWAPPED);

@extern
fn g_signal_connect_data(instance: gpointer,
					     detailed_signal: const gchar*,
					     c_handler: GCallback,
					     data: gpointer,
					     destroy_data: GClosureNotify,
                         connect_flags: GConnectFlags) -> gulong;
