import { GQuark, GData, guint, gpointer, gboolean, gint, } from glib;
import { GType, GTypeInstance } from gtype;
import { GValue } from gvalue;

enum GParamFlags {
    READABLE            = 1 << 0,
    WRITABLE            = 1 << 1,
    READWRITE           = GParamFlags::READABLE | GParamFlags::WRITABLE,
    CONSTRUCT	        = 1 << 2,
    CONSTRUCT_ONLY      = 1 << 3,
    LAX_VALIDATION      = 1 << 4,
    STATIC_NAME	        = 1 << 5,
    PRIVATE             = GParamFlags::STATIC_NAME,
    STATIC_NICK	        = 1 << 6,
    STATIC_BLURB	    = 1 << 7,
    /* User defined flags go here */
    EXPLICIT_NOTIFY     = 1 << 30,
    /* Avoid warning with -Wpedantic for gcc6 */
    DEPRECATED          = (1 << 31)
}

struct GParamSpec {
    g_type_instance:    GTypeInstance;
    name:               const char*;
    flags:              GParamFlags;
    value_type:         GType;
    owner_type:         GType;
    /*< private >*/
    _nick:              char*;
    _blurb:             char*;
    qdata:              GData*;
    ref_count:          guint;
    param_id:           guint;
}

struct GParamSpecClass;

struct GParameter {
    name: const char*;
    value: GValue;
}

@extern fn g_param_spec_ref(pspec: GParamSpec*) -> GParamSpec*;
@extern fn g_param_spec_unref(pspec: GParamSpec*);
@extern fn g_param_spec_sink(pspec: GParamSpec*);
@extern fn g_param_spec_ref_sink(pspec: GParamSpec*) -> GParamSpec*;
@extern fn g_param_spec_get_qdata(pspec: GParamSpec*,
                                  quark: GQuark) -> gpointer;
@extern fn g_param_spec_set_qdata(pspec: GParamSpec*,
                                  quark: GQuark,
                                  data: gpointer);
@extern fn g_param_spec_set_qdata_full(pspec: GParamSpec*,
                                       quark: GQuark,
                                       data: gpointer);
@extern fn g_param_spec_steal_qdata(pspec: GParamSpec*,
                                    quark: GQuark) -> gpointer;
@extern fn g_param_spec_get_redirect_target(pspec: GParamSpec*) -> GParamSpec*;
@extern fn g_param_value_set_default(pspec: GParamSpec*,
                                     value: GValue);
@extern fn g_param_value_defaults(pspec: GParamSpec*,
                                  value: const GValue*) -> gboolean;
@extern fn g_param_value_validate(pspec: GParamSpec*,
                                  value: GValue*) -> gboolean;
@extern fn g_param_value_is_valid(pspec: GParamSpec*,
                                  value: const GValue*) -> gboolean;
@extern fn g_param_value_convert(pspec: GParamSpec*,
                                 src_value: const GValue*,
                                 dest_value: GValue*,
                                 strict_validation: gboolean) -> gboolean;
@extern fn g_param_values_cmp(pspec: GParamSpec*,
                              value1: const GValue*,
                              value2: const GValue*) -> gint;
@extern fn g_param_spec_get_name(pspec: GParamSpec*) -> const char*;
@extern fn g_param_spec_get_nick(pspec: GParamSpec*) -> const char*;
@extern fn g_param_spec_get_blurb(pspec: GParamSpec*) -> const char*;
@extern fn g_value_set_param(value: GValue*,
                             param: GParamSpec*);
@extern fn g_value_get_param(value: const GValue*) -> GParamSpec*;
@extern fn g_value_dup_param(value: const GValue*) -> GParamSpec*;
@extern fn g_value_take_param(value: GValue*,
                              param: GParamSpec*);
@deprecated("use g_value_take_param()")
@extern fn g_value_set_param_take_ownership(value: GValue*,
                                            param: GParamSpec*);
@extern fn g_param_spec_get_default_value(pspec: GParamSpec*) -> const GValue*;
@extern fn g_param_spec_get_name_quark(pspec: GParamSpec*) -> GQuark;

struct GParamSpecPool;
