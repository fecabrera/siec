import {
    GDestroyNotify,
    GCompareFunc,
    GCompareDataFunc,
    GCopyFunc,
    GFunc,
    gpointer,
    gconstpointer,
    gint,
    guint,
} from gtypes;

struct GList {
    data: gpointer;
    next: GList*;
    prev: GList*;
}

@extern fn g_list_alloc() -> GList*;
@extern fn g_list_free(list: GList*);
@extern fn g_list_free_full(list: GList*,
                            free_func: GDestroyNotify*);
@extern fn g_list_append(list: GList*,
                         data: gpointer) -> GList*;
@extern fn g_list_prepend(list: GList*,
                         data: gpointer) -> GList*;
@extern fn g_list_insert(list: GList*,
                         data: gpointer,
                         position: gint) -> GList*;
@extern fn g_list_insert_sorted(list: GList*,
                                data: gpointer,
                                func: GCompareFunc) -> GList*;
@extern fn g_list_insert_sorted_with_data(list: GList*,
                                          data: gpointer,
                                          func: GCompareDataFunc,
                                          user_data: gpointer) -> GList*;
@extern fn g_list_insert_before(list: GList*,
                                sibling: GList*,
                                data: gpointer) -> GList*;
@extern fn g_list_insert_before_link(list: GList*,
                                     sibling: GList*,
                                     link_: GList*) -> GList*;
@extern fn g_list_concat(list1: GList*,
                         list2: GList*) -> GList*;
@extern fn g_list_remove(list: GList*,
                         data: gconstpointer) -> GList*;
@extern fn g_list_remove_all(list: GList*,
                             data: gconstpointer) -> GList*;
@extern fn g_list_remove_link(list: GList*,
                              llink: GList*) -> GList*;
@extern fn g_list_delete_link(list: GList*,
                              link_: GList*) -> GList*;
@extern fn g_list_reverse(list: GList*) -> GList*;
@extern fn g_list_copy(list: GList*) -> GList*;
@extern fn g_list_copy_deep(list: GList*,
                            func: GCopyFunc,
                            user_data: gpointer) -> GList*;
@extern fn g_list_nth(list: GList*,
                      n: guint) -> GList*;
@extern fn g_list_nth_prev(list: GList*,
                           n: guint) -> GList*;
@extern fn g_list_find(list: GList*,
                       data: gconstpointer) -> GList*;
@extern fn g_list_find_custom(list: GList*,
                              data: gconstpointer,
                              func: GCompareFunc) -> GList*;
@extern fn g_list_position(list: GList*,
                           llink: GList*) -> gint;
@extern fn g_list_index(list: GList*,
                        data: gconstpointer) -> gint;
@extern fn g_list_last(list: GList*) -> GList*;
@extern fn g_list_first(list: GList*) -> GList*;
@extern fn g_list_length(list: GList*) -> guint;
@extern fn g_list_foreach(list: GList*,
                          func: GFunc,
                          user_data: gpointer);
@extern fn g_list_sort(list: GList*,
                       compare_func: GCompareFunc) -> GList*;
@extern fn g_list_sort_with_data(list: GList*,
                                 compare_func: GCompareDataFunc,
                                 user_data: gpointer);
@extern fn g_list_nth_data(list: GList*,
                           n: guint) -> gpointer;
@extern fn g_clear_list(list_ptr: GList**,
                        destroy: GDestroyNotify);
