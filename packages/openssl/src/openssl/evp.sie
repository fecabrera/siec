import {
    EVP_MD, EVP_MD_CTX, EVP_CIPHER, EVP_CIPHER_CTX, EVP_ENCODE_CTX,
    EVP_PKEY, EVP_PKEY_CTX, ENGINE, OSSL_LIB_CTX, OSSL_PARAM, BIO_METHOD,
} from types;
import {
    NID_undef, NID_rsaEncryption, NID_rsassaPss, NID_dsa, NID_dhKeyAgreement,
    NID_X9_62_id_ecPublicKey, NID_sm2, NID_hmac, NID_poly1305,
    NID_X25519, NID_ED25519, NID_X448, NID_ED448,
} from obj_mac;

/*
 * The high-level interface: one set of calls that works for every digest and
 * every cipher, with the algorithm passed in as a value. Code written
 * against EVP does not change when the algorithm does, which is the whole
 * reason to prefer it over sha.sie's one-shots or anything lower.
 *
 * Two shapes recur. A digest or cipher is a stateless description
 * (EVP_MD, EVP_CIPHER) that the library owns and hands out by pointer; a
 * context (EVP_MD_CTX, EVP_CIPHER_CTX) is the running state of one
 * operation, which the caller allocates, feeds, and frees. Init, then
 * Update as many times as there is input, then Final.
 */

/* Longest values any built-in algorithm produces, for sizing buffers */
@const EVP_MAX_MD_SIZE = 64;         /* SHA-512 */
@const EVP_MAX_KEY_LENGTH = 64;
@const EVP_MAX_IV_LENGTH = 16;
@const EVP_MAX_BLOCK_LENGTH = 32;
@const EVP_MAX_AEAD_TAG_LENGTH = 16;

/* Key types, spelled as the NIDs of their algorithms */
@const EVP_PKEY_NONE = NID_undef;
@const EVP_PKEY_RSA = NID_rsaEncryption;
@const EVP_PKEY_RSA_PSS = NID_rsassaPss;
@const EVP_PKEY_DSA = NID_dsa;
@const EVP_PKEY_DH = NID_dhKeyAgreement;
@const EVP_PKEY_EC = NID_X9_62_id_ecPublicKey;
@const EVP_PKEY_SM2 = NID_sm2;
@const EVP_PKEY_HMAC = NID_hmac;
@const EVP_PKEY_POLY1305 = NID_poly1305;
@const EVP_PKEY_X25519 = NID_X25519;
@const EVP_PKEY_ED25519 = NID_ED25519;
@const EVP_PKEY_X448 = NID_X448;
@const EVP_PKEY_ED448 = NID_ED448;

/* Cipher modes, as reported by EVP_CIPHER_get_mode() */
@const EVP_CIPH_STREAM_CIPHER = 0x0;
@const EVP_CIPH_ECB_MODE = 0x1;
@const EVP_CIPH_CBC_MODE = 0x2;
@const EVP_CIPH_CFB_MODE = 0x3;
@const EVP_CIPH_OFB_MODE = 0x4;
@const EVP_CIPH_CTR_MODE = 0x5;
@const EVP_CIPH_GCM_MODE = 0x6;
@const EVP_CIPH_CCM_MODE = 0x7;
@const EVP_CIPH_XTS_MODE = 0x10001;
@const EVP_CIPH_WRAP_MODE = 0x10002;
@const EVP_CIPH_OCB_MODE = 0x10003;
@const EVP_CIPH_SIV_MODE = 0x10004;
@const EVP_CIPH_GCM_SIV_MODE = 0x10005;
@const EVP_CIPH_MODE = 0xF0007;

@const EVP_CIPH_VARIABLE_LENGTH = 0x8;
@const EVP_CIPH_CUSTOM_IV = 0x10;
@const EVP_CIPH_ALWAYS_CALL_INIT = 0x20;
@const EVP_CIPH_CTRL_INIT = 0x40;
@const EVP_CIPH_CUSTOM_KEY_LENGTH = 0x80;
@const EVP_CIPH_NO_PADDING = 0x100;
@const EVP_CIPH_RAND_KEY = 0x200;
@const EVP_CIPH_CUSTOM_COPY = 0x400;
@const EVP_CIPH_CUSTOM_IV_LENGTH = 0x800;
@const EVP_CIPH_FLAG_CTS = 0x4000;
@const EVP_CIPH_FLAG_CUSTOM_CIPHER = 0x100000;
@const EVP_CIPH_FLAG_AEAD_CIPHER = 0x200000;

/* Commands for EVP_CIPHER_CTX_ctrl(). The AEAD group is how an
   authentication tag gets in and out of GCM, CCM, and Poly1305. */
@const EVP_CTRL_INIT = 0x0;
@const EVP_CTRL_SET_KEY_LENGTH = 0x1;
@const EVP_CTRL_GET_RC2_KEY_BITS = 0x2;
@const EVP_CTRL_SET_RC2_KEY_BITS = 0x3;
@const EVP_CTRL_GET_RC5_ROUNDS = 0x4;
@const EVP_CTRL_SET_RC5_ROUNDS = 0x5;
@const EVP_CTRL_RAND_KEY = 0x6;
@const EVP_CTRL_PBE_PRF_NID = 0x7;
@const EVP_CTRL_COPY = 0x8;
@const EVP_CTRL_AEAD_SET_IVLEN = 0x9;
@const EVP_CTRL_AEAD_GET_TAG = 0x10;
@const EVP_CTRL_AEAD_SET_TAG = 0x11;
@const EVP_CTRL_AEAD_SET_IV_FIXED = 0x12;
@const EVP_CTRL_GCM_SET_IVLEN = EVP_CTRL_AEAD_SET_IVLEN;
@const EVP_CTRL_GCM_GET_TAG = EVP_CTRL_AEAD_GET_TAG;
@const EVP_CTRL_GCM_SET_TAG = EVP_CTRL_AEAD_SET_TAG;
@const EVP_CTRL_GCM_SET_IV_FIXED = EVP_CTRL_AEAD_SET_IV_FIXED;
@const EVP_CTRL_GCM_IV_GEN = 0x13;
@const EVP_CTRL_CCM_SET_IVLEN = EVP_CTRL_AEAD_SET_IVLEN;
@const EVP_CTRL_CCM_GET_TAG = EVP_CTRL_AEAD_GET_TAG;
@const EVP_CTRL_CCM_SET_TAG = EVP_CTRL_AEAD_SET_TAG;
@const EVP_CTRL_CCM_SET_L = 0x14;
@const EVP_CTRL_CCM_SET_MSGLEN = 0x15;
@const EVP_CTRL_AEAD_TLS1_AAD = 0x16;
@const EVP_CTRL_AEAD_SET_MAC_KEY = 0x17;
@const EVP_CTRL_GCM_SET_IV_INV = 0x18;

@const EVP_MD_CTX_FLAG_ONESHOT = 0x0001;
@const EVP_MD_CTX_FLAG_NO_INIT = 0x0100;
@const EVP_MD_CTX_FLAG_FINALISE = 0x0200;

/*
 * Digests
 */

/** Looks a digest up by name at runtime ("SHA256", "SHA3-512"), taking the
    provider's properties into account, and answers a reference the caller
    frees with EVP_MD_free(). The EVP_sha256()-style getters below are the
    same algorithms without the reference counting. */
@extern fn EVP_MD_fetch(ctx: OSSL_LIB_CTX*, algorithm: const char*,
    properties: const char*) -> EVP_MD*;
@extern fn EVP_MD_up_ref(md: EVP_MD*) -> i32;
@extern fn EVP_MD_free(md: EVP_MD*);

/** Looks a digest up in the table of built-in names. Answers null when the
    name is unknown, so the result is worth checking. */
@extern fn EVP_get_digestbyname(name: const char*) -> const EVP_MD*;

@extern fn EVP_MD_get_type(md: const EVP_MD*) -> i32;
@extern fn EVP_MD_get0_name(md: const EVP_MD*) -> const char*;
@extern fn EVP_MD_get0_description(md: const EVP_MD*) -> const char*;
@extern fn EVP_MD_is_a(md: const EVP_MD*, name: const char*) -> i32;
@extern fn EVP_MD_get_pkey_type(md: const EVP_MD*) -> i32;

/** How many bytes the digest produces: 32 for SHA-256. */
@extern fn EVP_MD_get_size(md: const EVP_MD*) -> i32;

/** The block size it compresses at: 64 for SHA-256, 128 for SHA-512. */
@extern fn EVP_MD_get_block_size(md: const EVP_MD*) -> i32;

@extern fn EVP_MD_get_flags(md: const EVP_MD*) -> u64;
@extern fn EVP_MD_xof(md: const EVP_MD*) -> i32;

@extern fn EVP_MD_CTX_new() -> EVP_MD_CTX*;
@extern fn EVP_MD_CTX_free(ctx: EVP_MD_CTX*);
@extern fn EVP_MD_CTX_reset(ctx: EVP_MD_CTX*) -> i32;
@extern fn EVP_MD_CTX_dup(in: const EVP_MD_CTX*) -> EVP_MD_CTX*;
@extern fn EVP_MD_CTX_copy(out: EVP_MD_CTX*, in: const EVP_MD_CTX*) -> i32;

/** Copies a running digest, so a common prefix can be hashed once and then
    finished several ways. Unlike EVP_MD_CTX_copy it does not reset `out`. */
@extern fn EVP_MD_CTX_copy_ex(out: EVP_MD_CTX*, in: const EVP_MD_CTX*) -> i32;

@extern fn EVP_MD_CTX_get0_md(ctx: const EVP_MD_CTX*) -> const EVP_MD*;
@extern fn EVP_MD_CTX_get1_md(ctx: EVP_MD_CTX*) -> EVP_MD*;
@extern fn EVP_MD_CTX_get_size_ex(ctx: const EVP_MD_CTX*) -> i32;
@extern fn EVP_MD_CTX_set_flags(ctx: EVP_MD_CTX*, flags: i32);
@extern fn EVP_MD_CTX_clear_flags(ctx: EVP_MD_CTX*, flags: i32);
@extern fn EVP_MD_CTX_test_flags(ctx: const EVP_MD_CTX*, flags: i32) -> i32;
@extern fn EVP_MD_CTX_get_pkey_ctx(ctx: const EVP_MD_CTX*) -> EVP_PKEY_CTX*;
@extern fn EVP_MD_CTX_set_pkey_ctx(ctx: EVP_MD_CTX*, pctx: EVP_PKEY_CTX*);

@macro EVP_MD_CTX_get0_name(e) = EVP_MD_get0_name(EVP_MD_CTX_get0_md(e));
@macro EVP_MD_CTX_get_size(e) = EVP_MD_CTX_get_size_ex(e);
@macro EVP_MD_CTX_get_block_size(e) = EVP_MD_get_block_size(EVP_MD_CTX_get0_md(e));
@macro EVP_MD_CTX_get_type(e) = EVP_MD_get_type(EVP_MD_CTX_get0_md(e));

/** Points a context at a digest and starts it. */
@extern fn EVP_DigestInit(ctx: EVP_MD_CTX*, type: const EVP_MD*) -> i32;
@extern fn EVP_DigestInit_ex(ctx: EVP_MD_CTX*, type: const EVP_MD*, impl: ENGINE*) -> i32;
@extern fn EVP_DigestInit_ex2(ctx: EVP_MD_CTX*, type: const EVP_MD*,
    params: const OSSL_PARAM*) -> i32;

/** Feeds `cnt` more bytes in. Calling it n times over consecutive chunks
    gives the same digest as one call over the whole input, which is what
    lets a file be hashed without being read into memory. */
@extern fn EVP_DigestUpdate(ctx: EVP_MD_CTX*, d: const opaque*, cnt: u64) -> i32;

/** Writes the digest into `md`, which must hold EVP_MD_get_size() bytes
    (EVP_MAX_MD_SIZE always suffices), and puts the length in `s`. The _ex
    form leaves the context usable after an EVP_DigestInit; the plain one
    cleans it up. */
@extern fn EVP_DigestFinal(ctx: EVP_MD_CTX*, md: u8*, s: u32*) -> i32;
@extern fn EVP_DigestFinal_ex(ctx: EVP_MD_CTX*, md: u8*, s: u32*) -> i32;

/* Extendable-output functions (SHAKE) produce as much as is asked for */
@extern fn EVP_DigestFinalXOF(ctx: EVP_MD_CTX*, out: u8*, outlen: u64) -> i32;
@extern fn EVP_DigestSqueeze(ctx: EVP_MD_CTX*, out: u8*, outlen: u64) -> i32;

/** Init, Update, and Final in one call, for input already in memory. */
@extern fn EVP_Digest(data: const opaque*, count: u64, md: u8*, size: u32*,
    type: const EVP_MD*, impl: ENGINE*) -> i32;

/** The same, naming the digest instead of holding one. */
@extern fn EVP_Q_digest(libctx: OSSL_LIB_CTX*, name: const char*, propq: const char*,
    data: const opaque*, datalen: u64, md: u8*, mdlen: u64*) -> i32;

/* The built-in digests. Each answers a pointer the library owns, so there is
   nothing to free. */
@extern fn EVP_md_null() -> const EVP_MD*;
@extern fn EVP_md5() -> const EVP_MD*;
@extern fn EVP_md5_sha1() -> const EVP_MD*;
@extern fn EVP_sha1() -> const EVP_MD*;
@extern fn EVP_sha224() -> const EVP_MD*;
@extern fn EVP_sha256() -> const EVP_MD*;
@extern fn EVP_sha384() -> const EVP_MD*;
@extern fn EVP_sha512() -> const EVP_MD*;
@extern fn EVP_sha512_224() -> const EVP_MD*;
@extern fn EVP_sha512_256() -> const EVP_MD*;
@extern fn EVP_sha3_224() -> const EVP_MD*;
@extern fn EVP_sha3_256() -> const EVP_MD*;
@extern fn EVP_sha3_384() -> const EVP_MD*;
@extern fn EVP_sha3_512() -> const EVP_MD*;
@extern fn EVP_shake128() -> const EVP_MD*;
@extern fn EVP_shake256() -> const EVP_MD*;
@extern fn EVP_blake2b512() -> const EVP_MD*;
@extern fn EVP_blake2s256() -> const EVP_MD*;
@extern fn EVP_ripemd160() -> const EVP_MD*;
@extern fn EVP_sm3() -> const EVP_MD*;

/*
 * Ciphers
 */

@extern fn EVP_CIPHER_fetch(ctx: OSSL_LIB_CTX*, algorithm: const char*,
    properties: const char*) -> EVP_CIPHER*;
@extern fn EVP_CIPHER_up_ref(cipher: EVP_CIPHER*) -> i32;
@extern fn EVP_CIPHER_free(cipher: EVP_CIPHER*);
@extern fn EVP_get_cipherbyname(name: const char*) -> const EVP_CIPHER*;

@extern fn EVP_CIPHER_get_nid(cipher: const EVP_CIPHER*) -> i32;
@extern fn EVP_CIPHER_get_type(cipher: const EVP_CIPHER*) -> i32;
@extern fn EVP_CIPHER_get0_name(cipher: const EVP_CIPHER*) -> const char*;
@extern fn EVP_CIPHER_get0_description(cipher: const EVP_CIPHER*) -> const char*;
@extern fn EVP_CIPHER_is_a(cipher: const EVP_CIPHER*, name: const char*) -> i32;
@extern fn EVP_CIPHER_get_block_size(cipher: const EVP_CIPHER*) -> i32;
@extern fn EVP_CIPHER_get_key_length(cipher: const EVP_CIPHER*) -> i32;
@extern fn EVP_CIPHER_get_iv_length(cipher: const EVP_CIPHER*) -> i32;
@extern fn EVP_CIPHER_get_flags(cipher: const EVP_CIPHER*) -> u64;
@extern fn EVP_CIPHER_get_mode(cipher: const EVP_CIPHER*) -> i32;

@extern fn EVP_CIPHER_CTX_new() -> EVP_CIPHER_CTX*;
@extern fn EVP_CIPHER_CTX_free(c: EVP_CIPHER_CTX*);
@extern fn EVP_CIPHER_CTX_reset(c: EVP_CIPHER_CTX*) -> i32;
@extern fn EVP_CIPHER_CTX_dup(in: const EVP_CIPHER_CTX*) -> EVP_CIPHER_CTX*;
@extern fn EVP_CIPHER_CTX_copy(out: EVP_CIPHER_CTX*, in: const EVP_CIPHER_CTX*) -> i32;
@extern fn EVP_CIPHER_CTX_get0_cipher(ctx: const EVP_CIPHER_CTX*) -> const EVP_CIPHER*;
@extern fn EVP_CIPHER_CTX_get_nid(ctx: const EVP_CIPHER_CTX*) -> i32;
@extern fn EVP_CIPHER_CTX_get_block_size(ctx: const EVP_CIPHER_CTX*) -> i32;
@extern fn EVP_CIPHER_CTX_get_key_length(ctx: const EVP_CIPHER_CTX*) -> i32;
@extern fn EVP_CIPHER_CTX_get_iv_length(ctx: const EVP_CIPHER_CTX*) -> i32;
@extern fn EVP_CIPHER_CTX_get_tag_length(ctx: const EVP_CIPHER_CTX*) -> i32;
@extern fn EVP_CIPHER_CTX_get_num(ctx: const EVP_CIPHER_CTX*) -> i32;
@extern fn EVP_CIPHER_CTX_set_key_length(x: EVP_CIPHER_CTX*, keylen: i32) -> i32;
@extern fn EVP_CIPHER_CTX_set_flags(ctx: EVP_CIPHER_CTX*, flags: i32);
@extern fn EVP_CIPHER_CTX_clear_flags(ctx: EVP_CIPHER_CTX*, flags: i32);
@extern fn EVP_CIPHER_CTX_test_flags(ctx: const EVP_CIPHER_CTX*, flags: i32) -> i32;

/** Turns PKCS#7 padding off (`pad` = 0). Then the input length must be a
    whole number of blocks, and Final produces nothing. */
@extern fn EVP_CIPHER_CTX_set_padding(c: EVP_CIPHER_CTX*, pad: i32) -> i32;

/** The catch-all for what a particular mode needs: the IV length and the
    authentication tag for AEAD modes, the round count for RC5, and so on.
    See the EVP_CTRL_* commands above. */
@extern fn EVP_CIPHER_CTX_ctrl(ctx: EVP_CIPHER_CTX*, type: i32, arg: i32, ptr: opaque*) -> i32;

@macro EVP_CIPHER_CTX_get0_name(c) = EVP_CIPHER_get0_name(EVP_CIPHER_CTX_get0_cipher(c));
@macro EVP_CIPHER_CTX_get_type(c) = EVP_CIPHER_get_type(EVP_CIPHER_CTX_get0_cipher(c));
@macro EVP_CIPHER_CTX_get_mode(c) = EVP_CIPHER_get_mode(EVP_CIPHER_CTX_get0_cipher(c));

/** Starts an encryption. `key` must be EVP_CIPHER_get_key_length() bytes and
    `iv` EVP_CIPHER_get_iv_length(); either may be null to keep what a
    previous Init set, which is how a mode whose IV length is being changed
    gets configured between two calls. */
@extern fn EVP_EncryptInit(ctx: EVP_CIPHER_CTX*, cipher: const EVP_CIPHER*,
    key: const u8*, iv: const u8*) -> i32;
@extern fn EVP_EncryptInit_ex(ctx: EVP_CIPHER_CTX*, cipher: const EVP_CIPHER*,
    impl: ENGINE*, key: const u8*, iv: const u8*) -> i32;
@extern fn EVP_EncryptInit_ex2(ctx: EVP_CIPHER_CTX*, cipher: const EVP_CIPHER*,
    key: const u8*, iv: const u8*, params: const OSSL_PARAM*) -> i32;

/** Encrypts `inl` bytes. Output lags input by up to a block, so `out` needs
    room for inl + EVP_CIPHER_get_block_size() - 1 bytes and `outl` says how
    many were actually written. With `out` null the input is taken as
    additional authenticated data instead, for an AEAD mode. */
@extern fn EVP_EncryptUpdate(ctx: EVP_CIPHER_CTX*, out: u8*, outl: i32*,
    in: const u8*, inl: i32) -> i32;

/** Writes the padded last block, up to one block of output. For an AEAD
    mode the tag becomes readable through EVP_CTRL_AEAD_GET_TAG afterwards. */
@extern fn EVP_EncryptFinal(ctx: EVP_CIPHER_CTX*, out: u8*, outl: i32*) -> i32;
@extern fn EVP_EncryptFinal_ex(ctx: EVP_CIPHER_CTX*, out: u8*, outl: i32*) -> i32;

@extern fn EVP_DecryptInit(ctx: EVP_CIPHER_CTX*, cipher: const EVP_CIPHER*,
    key: const u8*, iv: const u8*) -> i32;
@extern fn EVP_DecryptInit_ex(ctx: EVP_CIPHER_CTX*, cipher: const EVP_CIPHER*,
    impl: ENGINE*, key: const u8*, iv: const u8*) -> i32;
@extern fn EVP_DecryptInit_ex2(ctx: EVP_CIPHER_CTX*, cipher: const EVP_CIPHER*,
    key: const u8*, iv: const u8*, params: const OSSL_PARAM*) -> i32;
@extern fn EVP_DecryptUpdate(ctx: EVP_CIPHER_CTX*, out: u8*, outl: i32*,
    in: const u8*, inl: i32) -> i32;

/** Checks the padding and, for an AEAD mode, the tag that was handed over
    with EVP_CTRL_AEAD_SET_TAG. A 0 here is the ciphertext failing to
    authenticate, and the plaintext already written must be discarded. */
@extern fn EVP_DecryptFinal(ctx: EVP_CIPHER_CTX*, outm: u8*, outl: i32*) -> i32;
@extern fn EVP_DecryptFinal_ex(ctx: EVP_CIPHER_CTX*, outm: u8*, outl: i32*) -> i32;

/* The same three steps with the direction as an argument: `enc` is 1 to
   encrypt, 0 to decrypt, and -1 to keep whatever the last Init set. */
@extern fn EVP_CipherInit(ctx: EVP_CIPHER_CTX*, cipher: const EVP_CIPHER*,
    key: const u8*, iv: const u8*, enc: i32) -> i32;
@extern fn EVP_CipherInit_ex(ctx: EVP_CIPHER_CTX*, cipher: const EVP_CIPHER*,
    impl: ENGINE*, key: const u8*, iv: const u8*, enc: i32) -> i32;
@extern fn EVP_CipherInit_ex2(ctx: EVP_CIPHER_CTX*, cipher: const EVP_CIPHER*,
    key: const u8*, iv: const u8*, enc: i32, params: const OSSL_PARAM*) -> i32;
@extern fn EVP_CipherUpdate(ctx: EVP_CIPHER_CTX*, out: u8*, outl: i32*,
    in: const u8*, inl: i32) -> i32;
@extern fn EVP_CipherFinal(ctx: EVP_CIPHER_CTX*, outm: u8*, outl: i32*) -> i32;
@extern fn EVP_CipherFinal_ex(ctx: EVP_CIPHER_CTX*, outm: u8*, outl: i32*) -> i32;
@extern fn EVP_Cipher(c: EVP_CIPHER_CTX*, out: u8*, in: const u8*, inl: u32) -> i32;

/* The built-in ciphers */
@extern fn EVP_enc_null() -> const EVP_CIPHER*;

@extern fn EVP_aes_128_ecb() -> const EVP_CIPHER*;
@extern fn EVP_aes_128_cbc() -> const EVP_CIPHER*;
@extern fn EVP_aes_128_cfb1() -> const EVP_CIPHER*;
@extern fn EVP_aes_128_cfb8() -> const EVP_CIPHER*;
@extern fn EVP_aes_128_cfb128() -> const EVP_CIPHER*;
@extern fn EVP_aes_128_ofb() -> const EVP_CIPHER*;
@extern fn EVP_aes_128_ctr() -> const EVP_CIPHER*;
@extern fn EVP_aes_128_ccm() -> const EVP_CIPHER*;
@extern fn EVP_aes_128_gcm() -> const EVP_CIPHER*;
@extern fn EVP_aes_128_xts() -> const EVP_CIPHER*;
@extern fn EVP_aes_128_ocb() -> const EVP_CIPHER*;
@extern fn EVP_aes_128_wrap() -> const EVP_CIPHER*;

@extern fn EVP_aes_192_ecb() -> const EVP_CIPHER*;
@extern fn EVP_aes_192_cbc() -> const EVP_CIPHER*;
@extern fn EVP_aes_192_cfb1() -> const EVP_CIPHER*;
@extern fn EVP_aes_192_cfb8() -> const EVP_CIPHER*;
@extern fn EVP_aes_192_cfb128() -> const EVP_CIPHER*;
@extern fn EVP_aes_192_ofb() -> const EVP_CIPHER*;
@extern fn EVP_aes_192_ctr() -> const EVP_CIPHER*;
@extern fn EVP_aes_192_ccm() -> const EVP_CIPHER*;
@extern fn EVP_aes_192_gcm() -> const EVP_CIPHER*;
@extern fn EVP_aes_192_ocb() -> const EVP_CIPHER*;
@extern fn EVP_aes_192_wrap() -> const EVP_CIPHER*;

@extern fn EVP_aes_256_ecb() -> const EVP_CIPHER*;
@extern fn EVP_aes_256_cbc() -> const EVP_CIPHER*;
@extern fn EVP_aes_256_cfb1() -> const EVP_CIPHER*;
@extern fn EVP_aes_256_cfb8() -> const EVP_CIPHER*;
@extern fn EVP_aes_256_cfb128() -> const EVP_CIPHER*;
@extern fn EVP_aes_256_ofb() -> const EVP_CIPHER*;
@extern fn EVP_aes_256_ctr() -> const EVP_CIPHER*;
@extern fn EVP_aes_256_ccm() -> const EVP_CIPHER*;
@extern fn EVP_aes_256_gcm() -> const EVP_CIPHER*;
@extern fn EVP_aes_256_xts() -> const EVP_CIPHER*;
@extern fn EVP_aes_256_ocb() -> const EVP_CIPHER*;
@extern fn EVP_aes_256_wrap() -> const EVP_CIPHER*;

@extern fn EVP_chacha20() -> const EVP_CIPHER*;
@extern fn EVP_chacha20_poly1305() -> const EVP_CIPHER*;

@extern fn EVP_des_ede3_cbc() -> const EVP_CIPHER*;
@extern fn EVP_rc4() -> const EVP_CIPHER*;

/* `EVP_aes_128_cfb` and friends name the 128-bit feedback variant */
@macro EVP_aes_128_cfb() = EVP_aes_128_cfb128();
@macro EVP_aes_192_cfb() = EVP_aes_192_cfb128();
@macro EVP_aes_256_cfb() = EVP_aes_256_cfb128();

/*
 * Key derivation
 */

/** PBKDF2: stretches a password into `keylen` bytes of key by running HMAC
    `iter` times, so guessing the password costs `iter` times as much. The
    salt must be random and stored with the result. Modern guidance is a
    six-figure iteration count for a password a human typed. */
@extern fn PKCS5_PBKDF2_HMAC(pass: const char*, passlen: i32, salt: const u8*,
    saltlen: i32, iter: i32, digest: const EVP_MD*, keylen: i32, out: u8*) -> i32;
@extern fn PKCS5_PBKDF2_HMAC_SHA1(pass: const char*, passlen: i32, salt: const u8*,
    saltlen: i32, iter: i32, keylen: i32, out: u8*) -> i32;

/** The old OpenSSL password-to-key rule. It is here because files written by
    `openssl enc` need it to be read back; nothing new should use it. */
@extern fn EVP_BytesToKey(type: const EVP_CIPHER*, md: const EVP_MD*, salt: const u8*,
    data: const u8*, datal: i32, count: i32, key: u8*, iv: u8*) -> i32;

/*
 * Base64
 */

/** Encodes 3 bytes into 4 characters, writing a trailing NUL, and answers
    the length without it. `t` needs 4 * ((n + 2) / 3) + 1 bytes. */
@extern fn EVP_EncodeBlock(t: u8*, f: const u8*, n: i32) -> i32;

/** Decodes 4 characters into 3 bytes and answers the length, or -1 on
    anything that is not base64. Padding is included in the count, so the
    caller trims by the number of '=' at the end. */
@extern fn EVP_DecodeBlock(t: u8*, f: const u8*, n: i32) -> i32;

/* The streaming forms, which insert and accept the line breaks PEM uses */
@extern fn EVP_ENCODE_CTX_new() -> EVP_ENCODE_CTX*;
@extern fn EVP_ENCODE_CTX_free(ctx: EVP_ENCODE_CTX*);
@extern fn EVP_EncodeInit(ctx: EVP_ENCODE_CTX*);
@extern fn EVP_EncodeUpdate(ctx: EVP_ENCODE_CTX*, out: u8*, outl: i32*,
    in: const u8*, inl: i32) -> i32;
@extern fn EVP_EncodeFinal(ctx: EVP_ENCODE_CTX*, out: u8*, outl: i32*);
@extern fn EVP_DecodeInit(ctx: EVP_ENCODE_CTX*);
@extern fn EVP_DecodeUpdate(ctx: EVP_ENCODE_CTX*, out: u8*, outl: i32*,
    in: const u8*, inl: i32) -> i32;
@extern fn EVP_DecodeFinal(ctx: EVP_ENCODE_CTX*, out: u8*, outl: i32*) -> i32;

/* Filter BIOs that run these transforms over whatever is chained below */
@extern fn BIO_f_base64() -> const BIO_METHOD*;
@extern fn BIO_f_md() -> const BIO_METHOD*;
@extern fn BIO_f_cipher() -> const BIO_METHOD*;

/*
 * Keys, signing, and verification
 */

@extern fn EVP_PKEY_new() -> EVP_PKEY*;
@extern fn EVP_PKEY_up_ref(pkey: EVP_PKEY*) -> i32;
@extern fn EVP_PKEY_free(pkey: EVP_PKEY*);
@extern fn EVP_PKEY_get_id(pkey: const EVP_PKEY*) -> i32;
@extern fn EVP_PKEY_get0_type_name(key: const EVP_PKEY*) -> const char*;
@extern fn EVP_PKEY_is_a(pkey: const EVP_PKEY*, name: const char*) -> i32;

/** The key's size in bits: the modulus for RSA, the curve for EC. */
@extern fn EVP_PKEY_get_bits(pkey: const EVP_PKEY*) -> i32;

/** How much of that is actual security, which for RSA is far less. */
@extern fn EVP_PKEY_get_security_bits(pkey: const EVP_PKEY*) -> i32;

/** The largest signature the key can produce, for sizing a buffer. */
@extern fn EVP_PKEY_get_size(pkey: const EVP_PKEY*) -> i32;

/* Keys that are just bytes: Ed25519, X25519, and HMAC among them */
@extern fn EVP_PKEY_new_raw_private_key(type: i32, e: ENGINE*, priv: const u8*,
    len: u64) -> EVP_PKEY*;
@extern fn EVP_PKEY_new_raw_public_key(type: i32, e: ENGINE*, pub: const u8*,
    len: u64) -> EVP_PKEY*;
@extern fn EVP_PKEY_get_raw_private_key(pkey: const EVP_PKEY*, priv: u8*, len: u64*) -> i32;
@extern fn EVP_PKEY_get_raw_public_key(pkey: const EVP_PKEY*, pub: u8*, len: u64*) -> i32;

/** Signing runs a digest and then the key over its result, through the same
    context type. Pass `type` as null for Ed25519, which hashes internally
    and only works with the one-shot EVP_DigestSign. */
@extern fn EVP_DigestSignInit(ctx: EVP_MD_CTX*, pctx: EVP_PKEY_CTX**,
    type: const EVP_MD*, e: ENGINE*, pkey: EVP_PKEY*) -> i32;
@extern fn EVP_DigestSignUpdate(ctx: EVP_MD_CTX*, data: const opaque*, dsize: u64) -> i32;

/** With `sigret` null this writes only the length into `siglen`, which is
    how the caller learns what to allocate. */
@extern fn EVP_DigestSignFinal(ctx: EVP_MD_CTX*, sigret: u8*, siglen: u64*) -> i32;
@extern fn EVP_DigestSign(ctx: EVP_MD_CTX*, sigret: u8*, siglen: u64*,
    tbs: const u8*, tbslen: u64) -> i32;

@extern fn EVP_DigestVerifyInit(ctx: EVP_MD_CTX*, pctx: EVP_PKEY_CTX**,
    type: const EVP_MD*, e: ENGINE*, pkey: EVP_PKEY*) -> i32;
@extern fn EVP_DigestVerifyUpdate(ctx: EVP_MD_CTX*, data: const opaque*, dsize: u64) -> i32;

/** Answers 1 when the signature is the key's, 0 when it is not, and a
    negative number when the check could not be made at all. The three are
    worth telling apart. */
@extern fn EVP_DigestVerifyFinal(ctx: EVP_MD_CTX*, sig: const u8*, siglen: u64) -> i32;
@extern fn EVP_DigestVerify(ctx: EVP_MD_CTX*, sigret: const u8*, siglen: u64,
    tbs: const u8*, tbslen: u64) -> i32;
