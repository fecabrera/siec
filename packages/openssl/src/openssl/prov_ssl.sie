/*
 * The protocol version numbers, as they appear on the wire: a major and a
 * minor byte. TLS 1.0 kept SSL 3.0's numbering and counted from there, which
 * is why TLS 1.2 is 0x0303 rather than anything with a 2 in it, and why
 * TLS 1.3 kept 0x0303 in the record header and moved the real version into
 * an extension. DTLS counts backwards from 0xFFFF.
 *
 * These are what SSL_CTX_set_min_proto_version() and its neighbours take.
 */

@const SSL3_VERSION = 0x0300;
@const TLS1_VERSION = 0x0301;
@const TLS1_1_VERSION = 0x0302;
@const TLS1_2_VERSION = 0x0303;
@const TLS1_3_VERSION = 0x0304;
@const DTLS1_VERSION = 0xFEFF;
@const DTLS1_2_VERSION = 0xFEFD;
@const DTLS1_BAD_VER = 0x0100;
