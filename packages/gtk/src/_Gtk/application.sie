import {
    G_APPLICATION,
    GApplication,
    GApplicationFlags,
    g_application_run,
} from gio;
import {
    GtkApplication,
    GtkWindow,
    gtk_application_new,
    gtk_application_add_window,
    gtk_application_remove_window,
} from gtk_bindings;
import { Handler } from handler;
import {
    G_CALLBACK,
    g_signal_connect,
    g_object_unref,
} from gobject;

struct Application: Handler<GtkApplication>, Destroy {
    @private handle: GtkApplication*;
    
    fn init(&self, id: const char[], flags: GApplicationFlags = GApplicationFlags::DEFAULT_FLAGS) {
        self.handle = gtk_application_new(id, flags);
    }

    fn destroy(&self) {
        g_object_unref(self.handle);
    }

    fn get_handle(&self) -> GtkApplication* {
        return self.handle;
    }

    fn get_const_handle(const &self) -> const GtkApplication* {
        return self.handle;
    }

    @private
    fn as_g_application(&self) -> GApplication* {
        return G_APPLICATION(self.handle);
    }

    fn add_window(&self, obj: &Handler<GtkWindow>) {
        gtk_application_add_window(self.handle, obj.get_handle());
    }

    fn remove_window(&self, obj: &Handler<GtkWindow>) {
        gtk_application_remove_window(self.handle, obj.get_handle());
    }

    fn connect_activate(&self, callback: closure fn()) {
        g_signal_connect(self.handle, "activate", G_CALLBACK<fn(GtkApplication*, opaque*)>(callback), callback.env);
    }

    fn run(&self, argc: i32, argv: char**) -> i32 {
        return g_application_run(self.as_g_application(), argc, argv);
    }
}
