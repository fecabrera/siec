import { Handler } from handler;
import { Application } from application;
import {
    GTK_APPLICATION_WINDOW,
    GTK_WINDOW,
    GtkApplication,
    GtkApplicationWindow,
    GtkWindow,
    GtkWidget,
    gtk_application_window_new,
    gtk_window_set_title,
    gtk_window_get_default_size,
    gtk_window_set_default_size,
    gtk_window_get_titlebar,
    gtk_window_set_titlebar,
    gtk_window_set_child,
    gtk_window_present,
    gtk_window_minimize,
    gtk_window_unminimize,
    gtk_window_maximize,
    gtk_window_unmaximize,
    gtk_window_fullscreen,
    gtk_window_unfullscreen,
    gtk_window_close,
} from _gtk._bindings;


struct ApplicationWindow: Handler<GtkWidget> {
    @private handle: GtkWidget*;

    fn init(&self, app: &Application) {
        self.handle = gtk_application_window_new(app.get_handle());
    }

    fn get_handle(&self) -> GtkWidget* {
        return self.handle;
    }

    fn get_const_handle(const &self) -> const GtkWidget* {
        return self.handle;
    }

    fn as_gtk_application_window(&self) -> GtkApplicationWindow* {
        return GTK_APPLICATION_WINDOW(self.handle);
    }

    fn as_gtk_window(&self) -> GtkWindow* {
        return GTK_WINDOW(self.handle);
    }

    fn set_titlebar(&self, obj: &Handler<GtkWidget>) {
        gtk_window_set_titlebar(self.as_gtk_window(), obj.get_handle());
    }

    fn get_titlebar<T: Handler<GtkWidget>>(&self) -> T {
        return { gtk_window_get_titlebar(self.as_gtk_window()) };
    }

    fn set_title(&self, title: const &char[]) {
        gtk_window_set_title(self.as_gtk_window(), title);
    }

    fn set_default_size(&self, x: i32, y: i32) {
        gtk_window_set_default_size(self.as_gtk_window(), x, y);
    }

    fn get_default_size(&self) -> Tuple<i32, i32> {
        let size: Tuple<i32, i32>;
        gtk_window_get_default_size(self.as_gtk_window(), &size[0], &size[1]);
        return size;
    }

    fn set_child(&self, obj: &Handler<GtkWidget>) {
        gtk_window_set_child(self.as_gtk_window(), obj.get_handle());
    }

    fn present(&self) {
        gtk_window_present(self.as_gtk_window());
    }

    fn minimize(&self) {
        gtk_window_minimize(self.as_gtk_window());
    }

    fn unminimize(&self) {
        gtk_window_unminimize(self.as_gtk_window());
    }

    fn maximize(&self) {
        gtk_window_maximize(self.as_gtk_window());
    }
    
    fn unmaximize(&self) {
        gtk_window_unmaximize(self.as_gtk_window());
    }

    fn fullscreen(&self) {
        gtk_window_fullscreen(self.as_gtk_window());
    }

    fn unfullscreen(&self) {
        gtk_window_unfullscreen(self.as_gtk_window());
    }

    fn close(&self) {
        gtk_window_close(self.as_gtk_window());
    }
}