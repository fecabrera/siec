import {
    GTK_WINDOW,
    GtkApplication,
    GtkWidget,
    Application,
    Handler,
    gtk_application_window_new,
    gtk_window_set_title,
    gtk_window_set_default_size,
    gtk_window_set_child,
    gtk_window_present,
    gtk_window_close,
} from gtk;

struct Window: Handler<GtkWidget> {
    handle: GtkWidget*;

    fn init(&self, app: &Application) {
        self.handle = gtk_application_window_new(app.handle);
    }

    fn set_title(&self, title: const &char[]) {
        gtk_window_set_title(GTK_WINDOW(self.handle), title);
    }

    fn set_default_size(&self, x: i32, y: i32) {
        gtk_window_set_default_size(GTK_WINDOW(self.handle), x, y);
    }

    fn set_child(&self, obj: &Handler<GtkWidget>) {
        gtk_window_set_child(GTK_WINDOW(self.handle), obj.handle);
    }

    fn present(&self) {
        gtk_window_present(GTK_WINDOW(self.handle));
    }

    fn close(&self) {
        gtk_window_close(GTK_WINDOW(self.handle));
    }
}
