import { gboolean } from glib;
import { Handler } from handler;
import {
    GtkWidget,
    GtkHeaderBar,
    GTK_HEADER_BAR,
    gtk_header_bar_new,
    gtk_header_bar_get_title_widget,
    gtk_header_bar_set_title_widget,
    gtk_header_bar_pack_start,
    gtk_header_bar_pack_end,
    gtk_header_bar_get_show_title_buttons,
    gtk_header_bar_set_show_title_buttons,
    gtk_header_bar_get_use_native_controls,
    gtk_header_bar_set_use_native_controls,
} from gtk;

struct HeaderBar: Handler<GtkWidget> {
    @private handle: GtkWidget*;
    
    fn init(&self) {
        self.handle = gtk_header_bar_new();
    }

    fn get_handle(&self) -> GtkWidget* {
        return self.handle;
    }

    fn get_const_handle(const &self) -> const GtkWidget* {
        return self.handle;
    }

    fn get_title_widget<T: Handler<GtkWidget>>(&self) -> T {
        return { gtk_header_bar_get_title_widget(GTK_HEADER_BAR(self.handle)) };
    }

    fn set_title_widget(&self, obj: &Handler<GtkWidget>) {
        gtk_header_bar_set_title_widget(GTK_HEADER_BAR(self.handle), obj.get_handle());
    }

    fn pack_start(&self, obj: &Handler<GtkWidget>) {
        gtk_header_bar_pack_start(GTK_HEADER_BAR(self.handle), obj.get_handle());
    }

    fn pack_end(&self, obj: &Handler<GtkWidget>) {
        gtk_header_bar_pack_end(GTK_HEADER_BAR(self.handle), obj.get_handle());
    }

    fn get_show_title_buttons(&self) -> bool {
        return gtk_header_bar_get_show_title_buttons(GTK_HEADER_BAR(self.handle)) as bool;
    }

    fn set_show_title_buttons(&self, value: bool) {
        gtk_header_bar_set_show_title_buttons(GTK_HEADER_BAR(self.handle), value as gboolean);
    }
    
    fn get_use_native_controls(&self) -> bool {
        return gtk_header_bar_get_use_native_controls(GTK_HEADER_BAR(self.handle)) as bool;
    }

    fn set_use_native_controls(&self, value: bool) {
        gtk_header_bar_set_use_native_controls(GTK_HEADER_BAR(self.handle), value as gboolean);
    }
}
