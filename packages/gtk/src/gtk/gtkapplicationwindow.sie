import { gboolean, guint } from glib;
import { G_TYPE_CHECK_INSTANCE_CAST, G_TYPE_CHECK_CLASS_CAST, GType } from gobject;
import { GtkApplication } from gtkapplication;
import { GtkWidget } from gtkwidget;
import { GtkWindow } from gtkwindow;

@macro GTK_TYPE_APPLICATION_WINDOW = gtk_application_window_get_type();
@macro GTK_APPLICATION_WINDOW(obj) = G_TYPE_CHECK_INSTANCE_CAST<GtkApplicationWindow>(obj, GTK_TYPE_APPLICATION_WINDOW);
@macro GTK_APPLICATION_WINDOW_CLASS(klass) = G_TYPE_CHECK_CLASS_CAST<GtkApplicationWindowClass>(klass, GTK_TYPE_APPLICATION_WINDOW);

struct GtkApplicationWindow {
    parent_instance: GtkWindow;
}

struct GtkApplicationWindowClass;

@extern fn gtk_application_window_get_type() -> GType;
@extern fn gtk_application_window_new(application: GtkApplication*) -> GtkWidget*;
@extern fn gtk_application_window_set_show_menubar(window: GtkApplicationWindow*, show_menubar: gboolean);
@extern fn gtk_application_window_get_show_menubar(window: GtkApplicationWindow*) -> gboolean;
@extern fn gtk_application_window_get_id(window: GtkApplicationWindow*) -> guint;