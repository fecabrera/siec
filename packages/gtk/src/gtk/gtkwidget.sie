import { guint, gboolean } from glib;
import {
    G_TYPE_CHECK_INSTANCE_CAST,
    G_TYPE_CHECK_CLASS_CAST,
    G_TYPE_CHECK_INSTANCE_TYPE,
    G_TYPE_CHECK_CLASS_TYPE,
    G_TYPE_INSTANCE_GET_CLASS,
    GType,
    GInitiallyUnowned,
} from gobject;
import { GtkAlign } from gtkenums;

@macro GTK_TYPE_WIDGET = gtk_widget_get_type();
@macro GTK_WIDGET(widget) = G_TYPE_CHECK_INSTANCE_CAST<GtkWidget>(widget, GTK_TYPE_WIDGET);
@macro GTK_WIDGET_CLASS(klass) = G_TYPE_CHECK_CLASS_CAST<GtkWidgetClass>(klass, GTK_TYPE_WIDGET);
@macro GTK_IS_WIDGET(widget) = G_TYPE_CHECK_INSTANCE_TYPE(widget, GTK_TYPE_WIDGET);
@macro GTK_IS_WIDGET_CLASS(klass) = G_TYPE_CHECK_CLASS_TYPE(klass, GTK_TYPE_WIDGET);
@macro GTK_WIDGET_GET_CLASS(obj) = G_TYPE_INSTANCE_GET_CLASS<GtkWidgetClass>(obj, GTK_TYPE_WIDGET); 

struct GtkRequisition {
    width: i32;
    height: i32;
}

struct GtkWidget {
    priv: GtkWidgetPrivate*;    
}

struct GtkWidgetPrivate;
struct GtkWidgetClass;
struct GtkWidgetClassPrivate;

@extern fn gtk_widget_get_type() -> GType;
