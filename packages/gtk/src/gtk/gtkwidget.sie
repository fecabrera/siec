@extern fn gtk_widget_set_margin_start(widget: GtkWidget*, margin: i32);
@extern fn gtk_widget_get_margin_end(widget: GtkWidget*) -> i32;
@extern fn gtk_widget_set_margin_end(widget: GtkWidget*, margin: i32);
@extern fn gtk_widget_get_margin_top(widget: GtkWidget*) -> i32;
@extern fn gtk_widget_set_margin_top(widget: GtkWidget*, margin: i32);
