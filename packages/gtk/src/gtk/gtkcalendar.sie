import { GtkWidget } from gtkwidget;
import { GType, G_TYPE_CHECK_INSTANCE_CAST, G_TYPE_CHECK_INSTANCE_TYPE } from gobject;
import { GDateTime, gboolean, guint } from glib;

@macro GTK_TYPE_CALENDAR = gtk_calendar_get_type();
@macro GTK_CALENDAR(obj) = G_TYPE_CHECK_INSTANCE_CAST<GtkCalendar>(obj, GTK_TYPE_CALENDAR);
@macro GTK_IS_CALENDAR(obj) = G_TYPE_CHECK_INSTANCE_TYPE(obj, GTK_TYPE_CALENDAR);

struct GtkCalendar;

@extern fn gtk_calendar_get_type() -> GType;
@extern fn gtk_calendar_new() -> GtkWidget*;
@deprecated("use gtk_calendar_set_date()")
@extern fn gtk_calendar_select_day(calendar: GtkCalendar*,
                                   date: GDateTime*);
@extern fn gtk_calendar_mark_day(calendar: GtkCalendar*,
                                 day: guint);
@extern fn gtk_calendar_unmark_day(calendar: GtkCalendar*,
                                   day: guint);
@extern fn gtk_calendar_clear_marks(calendar: GtkCalendar*);
@extern fn gtk_calendar_set_show_week_numbers(calendar: GtkCalendar*,
                                              value: gboolean);
@extern fn gtk_calendar_get_show_week_numbers(calendar: GtkCalendar*) -> gboolean;
@extern fn gtk_calendar_set_show_heading(calendar: GtkCalendar*,
                                         value: gboolean);
@extern fn gtk_calendar_get_show_heading(calendar: GtkCalendar*) -> gboolean;
@extern fn gtk_calendar_set_show_day_names(calendar: GtkCalendar*,
                                           value: gboolean);
@extern fn gtk_calendar_get_show_day_names(calendar: GtkCalendar*) -> gboolean;
@extern fn gtk_calendar_set_day(calendar: GtkCalendar*,
                                day: i32);
@extern fn gtk_calendar_get_day(calendar: GtkCalendar*) -> i32;
@extern fn gtk_calendar_set_month(calendar: GtkCalendar*,
                                  month: i32);
@extern fn gtk_calendar_get_month(calendar: GtkCalendar*) -> i32;
@extern fn gtk_calendar_set_year(calendar: GtkCalendar*,
                                 year: i32);
@extern fn gtk_calendar_get_year(calendar: GtkCalendar*) -> i32;
@extern fn gtk_calendar_set_date(calendar: GtkCalendar*,
                                 date: GDateTime*);
@extern fn gtk_calendar_get_date(calendar: GtkCalendar*) -> GDateTime*;
@extern fn gtk_calendar_get_day_is_marked(calendar: GtkCalendar*,
                                          day: guint) -> gboolean;
