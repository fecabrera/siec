import { GtkApplication, GtkWidget } from gtk;
import { GType, G_TYPE_CHECK_INSTANCE_CAST, G_TYPE_CHECK_INSTANCE_TYPE } from gobject;
import { gboolean } from glib;

@macro ADW_TYPE_APPLICATION_WINDOW = adw_application_window_get_type();
@macro ADW_APPLICATION_WINDOW(obj) = G_TYPE_CHECK_INSTANCE_CAST<AdwApplicationWindow>(obj, ADW_TYPE_APPLICATION_WINDOW);
@macro ADW_IS_APPLICATION_WINDOW(obj) = G_TYPE_CHECK_INSTANCE_TYPE(obj, ADW_TYPE_APPLICATION_WINDOW);

struct AdwApplicationWindow;

@extern fn adw_application_window_get_type() -> GType;
@extern fn adw_application_window_new(app: GtkApplication*) -> GtkWidget*;
@extern fn adw_application_window_set_content(window: AdwApplicationWindow*,
                                              content: GtkWidget*);
@extern fn adw_application_window_get_content(window: AdwApplicationWindow*) -> GtkWidget*;
@extern fn adw_application_window_get_adaptive_preview(window: AdwApplicationWindow*) -> gboolean;
@extern fn adw_application_window_set_adaptive_preview(window: AdwApplicationWindow*,
                                                       adaptive_preview: gboolean);
