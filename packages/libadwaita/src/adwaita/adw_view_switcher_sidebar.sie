import { GType, G_TYPE_CHECK_INSTANCE_CAST } from gobject;
import { GtkWidget, GtkFilter } from gtk;
import { AdwViewStack } from adw_view_stack;
import { AdwSidebarMode } from adw_sidebar;

@macro ADW_TYPE_VIEW_SWITCHER_SIDEBAR = adw_view_switcher_sidebar_get_type();
@macro ADW_VIEW_SWITCHER_SIDEBAR(obj) = G_TYPE_CHECK_INSTANCE_CAST<AdwViewSwitcherSidebar>(obj, ADW_TYPE_VIEW_SWITCHER_SIDEBAR);
@macro ADW_IS_VIEW_SWITCHER_SIDEBAR(obj) = G_TYPE_CHECK_INSTANCE_TYPE(obj, ADW_TYPE_VIEW_SWITCHER_SIDEBAR);

struct AdwViewSwitcherSidebar {
    parent_instance: GtkWidget;
}

@extern fn adw_view_switcher_sidebar_get_type() -> GType;
@extern fn adw_view_switcher_sidebar_new() -> GtkWidget*;
@extern fn adw_view_switcher_sidebar_get_stack(view_switcher_sidebar: AdwViewSwitcherSidebar*) -> AdwViewStack*;
@extern fn adw_view_switcher_sidebar_set_stack(view_switcher_sidebar: AdwViewSwitcherSidebar*,
                                               stack: AdwViewStack*);
@extern fn adw_view_switcher_sidebar_get_mode(view_switcher_sidebar: AdwViewSwitcherSidebar*) -> AdwSidebarMode;
@extern fn adw_view_switcher_sidebar_set_mode(view_switcher_sidebar: AdwViewSwitcherSidebar*,
                                              mode: AdwSidebarMode);
@extern fn adw_view_switcher_sidebar_get_filter(view_switcher_sidebar: AdwViewSwitcherSidebar*) -> GtkFilter*;
@extern fn adw_view_switcher_sidebar_set_filter(view_switcher_sidebar: AdwViewSwitcherSidebar*,
                                                filter: GtkFilter*);
@extern fn adw_view_switcher_sidebar_get_placeholder(view_switcher_sidebar: AdwViewSwitcherSidebar*) -> GtkWidget*;
@extern fn adw_view_switcher_sidebar_set_placeholder(view_switcher_sidebar: AdwViewSwitcherSidebar*,
                                                     placeholder: GtkWidget*);
