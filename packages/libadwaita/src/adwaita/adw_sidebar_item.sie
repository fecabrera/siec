import { GtkWidget } from gtk;
import { gboolean, guint } from glib;
import { GObject, GType, G_TYPE_CHECK_INSTANCE_CAST, G_TYPE_CHECK_INSTANCE_TYPE } from gobject;

@macro ADW_TYPE_SIDEBAR_ITEM = adw_sidebar_item_get_type();
@macro ADW_SIDEBAR_ITEM(obj) = G_TYPE_CHECK_INSTANCE_CAST<AdwSidebarItem>(obj, ADW_TYPE_SIDEBAR_ITEM);
@macro ADW_IS_SIDEBAR_ITEM(obj) = G_TYPE_CHECK_INSTANCE_TYPE(obj, ADW_TYPE_SIDEBAR_ITEM);

struct AdwSidebarItem {
    parent_instance: GObject;
}

@extern fn adw_sidebar_item_get_type() -> GType;
@extern fn adw_sidebar_item_new(title: const char*) -> AdwSidebarItem*;
@extern fn adw_sidebar_item_get_title(sidebar_item: AdwSidebarItem*) -> const char*;
@extern fn adw_sidebar_item_set_title(sidebar_item: AdwSidebarItem*,
                                      title: const char*);
@extern fn adw_sidebar_item_get_subtitle(sidebar_item: AdwSidebarItem*) -> const char*;
@extern fn adw_sidebar_item_set_subtitle(sidebar_item: AdwSidebarItem*,
                                         subtitle: const char*);
@extern fn adw_sidebar_item_get_use_underline(sidebar_item: AdwSidebarItem*) -> gboolean;
@extern fn adw_sidebar_item_set_use_underline(sidebar_item: AdwSidebarItem*,
                                              use_underline: gboolean);
@extern fn adw_sidebar_item_get_icon_name(sidebar_item: AdwSidebarItem*) -> const char*;
@extern fn adw_sidebar_item_set_icon_name(sidebar_item: AdwSidebarItem*,
                                          icon_name: const char*);

@extern fn adw_sidebar_item_get_tooltip(sidebar_item: AdwSidebarItem*) -> const char*;
@extern fn adw_sidebar_item_set_tooltip(sidebar_item: AdwSidebarItem*,
                                        tooltip: const char*);
@extern fn adw_sidebar_item_get_suffix(sidebar_item: AdwSidebarItem*) -> GtkWidget*;
@extern fn adw_sidebar_item_set_suffix(sidebar_item: AdwSidebarItem*,
                                       suffix: GtkWidget*);
@extern fn adw_sidebar_item_get_visible(sidebar_item: AdwSidebarItem*) -> gboolean;
@extern fn adw_sidebar_item_set_visible(sidebar_item: AdwSidebarItem*,
                                        visible: gboolean);
@extern fn adw_sidebar_item_get_enabled(sidebar_item: AdwSidebarItem*) -> gboolean;
@extern fn adw_sidebar_item_set_enabled(sidebar_item: AdwSidebarItem*,
                                        enable: gboolean);
@extern fn adw_sidebar_item_get_drag_motion_activate(sidebar_item: AdwSidebarItem*) -> gboolean;
@extern fn adw_sidebar_item_set_drag_motion_activate(sidebar_item: AdwSidebarItem*,
                                                     drag_motion_activate: gboolean);

@extern fn adw_sidebar_item_get_index(sidebar_item: AdwSidebarItem*) -> guint;
@extern fn adw_sidebar_item_get_section_index(sidebar_item: AdwSidebarItem*) -> guint;
