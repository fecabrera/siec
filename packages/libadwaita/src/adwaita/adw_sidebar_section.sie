import { GtkWidget } from gtk;
import { gboolean, guint } from glib;
import { GType, G_TYPE_CHECK_INSTANCE_CAST, G_TYPE_CHECK_INSTANCE_TYPE } from gobject;
import { GMenuModel } from gio;
import { AdwSidebarItem } from adw_sidebar_item;
import { AdwSidebar } from adw_sidebar;

@macro ADW_TYPE_SIDEBAR_SECTION = adw_sidebar_section_get_type();
@macro ADW_SIDEBAR_SECTION(obj) = G_TYPE_CHECK_INSTANCE_CAST<AdwSidebarSection>(obj, ADW_TYPE_SIDEBAR_SECTION);
@macro ADW_IS_SIDEBAR_SECTION(obj) = G_TYPE_CHECK_INSTANCE_TYPE(obj, ADW_TYPE_SIDEBAR_SECTION);

struct AdwSidebarSection;

@extern fn adw_sidebar_section_get_type() -> GType;
@extern fn adw_sidebar_section_new() -> AdwSidebarSection*;
@extern fn adw_sidebar_section_get_title(section: AdwSidebarSection*) -> const char*;
@extern fn adw_sidebar_section_set_title(section: AdwSidebarSection*,
                                         title: const char*);
@extern fn adw_sidebar_section_get_menu_model(section: AdwSidebarSection*) -> GMenuModel*;
@extern fn adw_sidebar_section_set_menu_model(section: AdwSidebarSection*,
                                              menu_mode: GMenuModel*);

@extern fn adw_sidebar_section_append(section: AdwSidebarSection*,
                                      item: AdwSidebarItem*);
@extern fn adw_sidebar_section_prepend(section: AdwSidebarSection*,
                                       item: AdwSidebarItem*);
@extern fn adw_sidebar_section_insert(section: AdwSidebarSection*,
                                      item: AdwSidebarItem*,
                                      position: i32);
@extern fn adw_sidebar_section_remove(section: AdwSidebarSection*,
                                      item: AdwSidebarItem*);
@extern fn adw_sidebar_section_remove_all(section: AdwSidebarSection*);

@extern fn adw_sidebar_section_get_sidebar(section: AdwSidebarSection*) -> AdwSidebar*;
