import { gboolean } from glib;
import { Handler } from gtk;
import {
    AdwTabPage,
    adw_tab_page_set_title,
    adw_tab_page_set_tooltip,
    adw_tab_page_get_loading,
    adw_tab_page_set_loading,
} from adwaita;

struct TabPage: Handler<AdwTabPage> {
    @private handle: AdwTabPage*;

    fn init(&self, handle: AdwTabPage*) {
        self.handle = handle;
    }

    fn get_handle(&self) -> AdwTabPage* {
        return self.handle;
    }

    fn get_const_handle(const &self) -> const AdwTabPage* {
        return self.handle;
    }

    fn set_title(&self, title: const &char[]) {
        adw_tab_page_set_title(self.handle, title);
    }

    fn set_tooltip(&self, tooltip: const &char[]) {
        adw_tab_page_set_tooltip(self.handle, tooltip);
    }
    
    fn get_loading(&self) -> bool {
        return adw_tab_page_get_loading(self.handle) as bool;
    }
    
    fn set_loading(&self, loading: bool) {
        adw_tab_page_set_loading(self.handle, loading as gboolean);
    }
}