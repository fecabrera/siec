import { GtkWidget, Handler } from gtk;
import {
    ADW_VIEW_SWITCHER,
    AdwViewSwitcher,
    AdwViewSwitcherPolicy,
    adw_view_switcher_new,
    adw_view_switcher_get_policy,
    adw_view_switcher_set_policy,
} from adwaita;

struct ViewSwitcher: Handler<GtkWidget> {
    @private handle: GtkWidget*;

    fn init(&self) {
        self.handle = adw_view_switcher_new();
    }

    fn init(&self, handle: GtkWidget*) {
        self.handle = handle;
    }

    fn get_handle(&self) -> GtkWidget* {
        return self.handle;
    }

    fn get_const_handle(const &self) -> const GtkWidget* {
        return self.handle;
    }

    @private
    fn as_adw_view_switcher(&self) -> AdwViewSwitcher* {
        return ADW_VIEW_SWITCHER(self.handle);
    }

    fn get_policy(&self) -> AdwViewSwitcherPolicy {
        return adw_view_switcher_get_policy(self.as_adw_view_switcher());
    }

    fn set_policy(&self, policy: AdwViewSwitcherPolicy) {
        adw_view_switcher_set_policy(self.as_adw_view_switcher(), policy);
    }
}
