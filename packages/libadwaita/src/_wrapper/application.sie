import {
    G_APPLICATION,
    GApplicationFlags,
    g_application_run,
} from gio;
import {
    GTK_APPLICATION,
    GtkApplication,
    GtkWindow,
    Handler,
    gtk_application_new,
    gtk_application_add_window,
    gtk_application_remove_window,
} from gtk;
import {
    G_CALLBACK,
    g_signal_connect,
    g_object_unref,
} from gobject;
import { AdwApplication, adw_application_new } from adwaita;

struct Application: Handler<AdwApplication> {
    @private handle: AdwApplication*;

    fn init(&self, id: const char[], flags: GApplicationFlags = GApplicationFlags::DEFAULT_FLAGS) {
        self.handle = adw_application_new(id, flags);
    }

    fn destroy(&self) {
        g_object_unref(self.handle);
    }

    fn get_handle(&self) -> AdwApplication* {
        return self.handle;
    }

    fn get_const_handle(const &self) -> const AdwApplication* {
        return self.handle;
    }

    fn add_window(&self, obj: &Handler<GtkWindow*>) {
        gtk_application_add_window(GTK_APPLICATION(self.handle), obj.get_handle());
    }

    fn remove_window(&self, obj: &Handler<GtkWindow*>) {
        gtk_application_remove_window(GTK_APPLICATION(self.handle), obj.get_handle());
    }

    fn connect_activate(&self, callback: closure fn()) {
        g_signal_connect(GTK_APPLICATION(self.handle), "activate", G_CALLBACK<fn(GtkApplication*, opaque*)>(callback), callback.env);
    }

    fn run(&self, argc: i32, argv: char**) -> i32 {
        return g_application_run(G_APPLICATION(self.handle), argc, argv);
    }
}