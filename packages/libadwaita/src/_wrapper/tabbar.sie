import { gboolean } from glib;
import { GtkWidget, Handler } from gtk;
import {
    ADW_TAB_BAR,
    AdwTabBar,
    adw_tab_bar_new,
    adw_tab_bar_set_view,
    adw_tab_bar_get_autohide,
    adw_tab_bar_set_autohide,
} from adwaita;
import { TabView } from tabview;

struct TabBar: Handler<AdwTabBar> {
    @private handle: AdwTabBar*;

    fn init(&self) {
        self.handle = adw_tab_bar_new();
    }

    fn init(&self, handle: AdwTabBar*) {
        self.handle = handle;
    }

    fn get_handle(&self) -> AdwTabBar* {
        return self.handle;
    }

    fn get_const_handle(const &self) -> const AdwTabBar* {
        return self.handle;
    }

    fn set_view(&self, view: &TabView) {
        adw_tab_bar_set_view(self.handle, view.get_handle());
    }
    
    fn get_autohide(&self) -> bool {
        return adw_tab_bar_get_autohide(self.handle) as bool;
    }
    
    fn set_autohide(&self, autohide: bool) {
        adw_tab_bar_set_autohide(self.handle, autohide as gboolean);
    }
}