import { GType, G_TYPE_CHECK_INSTANCE_CAST, G_TYPE_CHECK_INSTANCE_TYPE } from gobject;
import { GtkWidget } from gtk_bindings;
import { AdwToast } from adw_toast;

@macro ADW_TYPE_TOAST_OVERLAY = adw_toast_overlay_get_type();
@macro ADW_TOAST_OVERLAY(obj) = G_TYPE_CHECK_INSTANCE_CAST<AdwToastOverlay>(obj, ADW_TYPE_TOAST_OVERLAY);
@macro ADW_IS_TOAST_OVERLAY(obj) = G_TYPE_CHECK_INSTANCE_TYPE(obj, ADW_TYPE_TOAST_OVERLAY);

struct AdwToastOverlay {
    parent_instance: GtkWidget;
}

@extern fn adw_toast_overlay_get_type() -> GType;
@extern fn adw_toast_overlay_new() -> GtkWidget*;
@extern fn adw_toast_overlay_get_child(overlay: AdwToastOverlay*) -> GtkWidget*;
@extern fn adw_toast_overlay_set_child(overlay: AdwToastOverlay*,
                                       child: GtkWidget*);
@extern fn adw_toast_overlay_add_toast(overlay: AdwToastOverlay*,
                                       toast: AdwToast*);
@extern fn adw_toast_overlay_dismiss_all(overlay: AdwToastOverlay*);
