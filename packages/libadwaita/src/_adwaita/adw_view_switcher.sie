import { GType, G_TYPE_CHECK_INSTANCE_CAST } from gobject;
import { GtkWidget } from gtk_bindings;
import { AdwViewStack } from adw_view_stack;

@macro ADW_TYPE_VIEW_SWITCHER = adw_view_switcher_get_type();
@macro ADW_VIEW_SWITCHER(obj) = G_TYPE_CHECK_INSTANCE_CAST<AdwViewSwitcher>(obj, ADW_TYPE_VIEW_SWITCHER);
@macro ADW_IS_VIEW_SWITCHER(obj) = G_TYPE_CHECK_INSTANCE_TYPE(obj, ADW_TYPE_VIEW_SWITCHER);

struct AdwViewSwitcher {
    parent_instance: GtkWidget;
}

enum AdwViewSwitcherPolicy {
    NARROW,
    WIDE,
}

@extern fn adw_view_switcher_get_type() -> GType;
@extern fn adw_view_switcher_new() -> GtkWidget*;
@extern fn adw_view_switcher_get_policy(view_switcher: AdwViewSwitcher*) -> AdwViewSwitcherPolicy;
@extern fn adw_view_switcher_set_policy(view_switcher: AdwViewSwitcher*,
                                        policy: AdwViewSwitcherPolicy);
@extern fn adw_view_switcher_get_stack(view_switcher: AdwViewSwitcher*) -> AdwViewStack*;
@extern fn adw_view_switcher_set_stack(view_switcher: AdwViewSwitcher*,
                                       stack: AdwViewStack*);
