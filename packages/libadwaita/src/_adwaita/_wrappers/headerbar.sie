import { gboolean } from glib;
import { GtkWidget, Handler } from gtk;
import {
    ADW_HEADER_BAR,
    AdwHeaderBar,
    AdwCenteringPolicy,
    adw_header_bar_new,
    adw_header_bar_pack_start,
    adw_header_bar_pack_end,
    adw_header_bar_remove,
    adw_header_bar_set_title_widget,
    adw_header_bar_get_show_start_title_buttons,
    adw_header_bar_set_show_start_title_buttons,
    adw_header_bar_get_show_end_title_buttons,
    adw_header_bar_set_show_end_title_buttons,
    adw_header_bar_get_show_back_button,
    adw_header_bar_set_show_back_button,
    adw_header_bar_set_decoration_layout,
    adw_header_bar_get_centering_policy,
    adw_header_bar_set_centering_policy,
    adw_header_bar_get_show_title,
    adw_header_bar_set_show_title,
} from _adwaita._bindings;

@type CenteringPolicy = AdwCenteringPolicy;

struct HeaderBar: Handler<GtkWidget> {
    @private handle: GtkWidget*;

    fn init(&self) {
        self.handle = adw_header_bar_new();
    }

    fn init(&self, handle: GtkWidget*) {
        self.handle = handle;
    }

    fn get_handle(&self) -> GtkWidget* {
        return self.handle;
    }

    fn get_const_handle(const &self) -> const GtkWidget* {
        return self.handle;
    }

    @private
    fn get_adw_header(&self) -> AdwHeaderBar* {
        return ADW_HEADER_BAR(self.handle);
    }
    
    fn pack_start(&self, child: &Handler<GtkWidget>) {
        adw_header_bar_pack_start(self.get_adw_header(), child.get_handle());
    }
    
    fn pack_end(&self, child: &Handler<GtkWidget>) {
        adw_header_bar_pack_end(self.get_adw_header(), child.get_handle());
    }
    
    fn remove(&self, child: &Handler<GtkWidget>) {
        adw_header_bar_remove(self.get_adw_header(), child.get_handle());
    }
    
    fn set_title_widget(&self, widget: &Handler<GtkWidget>) {
        adw_header_bar_set_title_widget(self.get_adw_header(), widget.get_handle());
    }
    
    fn get_show_start_title_buttons(&self) -> bool {
        return adw_header_bar_get_show_start_title_buttons(self.get_adw_header()) as bool;
    }
    
    fn set_show_start_title_buttons(&self, show_start_title_buttons: bool) {
        adw_header_bar_set_show_start_title_buttons(self.get_adw_header(), show_start_title_buttons as gboolean);
    }
    
    fn get_show_end_title_buttons(&self) -> bool {
        return adw_header_bar_get_show_end_title_buttons(self.get_adw_header()) as bool;
    }
    
    fn set_show_end_title_buttons(&self, show_end_title_buttons: bool) {
        adw_header_bar_set_show_end_title_buttons(self.get_adw_header(), show_end_title_buttons as gboolean);
    }
    
    fn get_show_back_button(&self) -> bool {
        return adw_header_bar_get_show_back_button(self.get_adw_header()) as bool;
    }
    
    fn set_show_back_button(&self, show_back_button: bool) {
        adw_header_bar_set_show_back_button(self.get_adw_header(), show_back_button as gboolean);
    }
    
    fn set_decoration_layout(&self, layout: const &char[]) {
        adw_header_bar_set_decoration_layout(self.get_adw_header(), layout);
    }

    fn get_centering_policy(&self) -> CenteringPolicy {
        return adw_header_bar_get_centering_policy(self.get_adw_header());
    }

    fn set_centering_policy(&self, centering_policy: CenteringPolicy) {
        adw_header_bar_set_centering_policy(self.get_adw_header(), centering_policy);
    }

    fn get_show_title(&self) -> bool {
        return adw_header_bar_get_show_title(self.get_adw_header()) as bool;
    }
    fn set_show_title(&self, show_title: bool) {
        adw_header_bar_set_show_title(self.get_adw_header(), show_title as gboolean);
    }
}
