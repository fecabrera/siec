import { GtkWidget, Handler } from gtk;
import {
    ADW_TOAST_OVERLAY,
    AdwToastOverlay,
    adw_toast_overlay_new,
    adw_toast_overlay_set_child,
    adw_toast_overlay_add_toast,
    adw_toast_overlay_dismiss_all,
} from _adwaita._bindings;

struct ToastOverlay: Handler<GtkWidget> {
    @private handle: GtkWidget*;

    fn init(&self) {
        self.handle = adw_toast_overlay_new();
    }

    fn init(&self, handle: GtkWidget*) {
        self.handle = handle;
    }

    fn get_handle(&self) -> GtkWidget* {
        return self.handle;
    }

    fn get_const_handle(const &self) -> const GtkWidget* {
        return self.handle;
    }

    fn get_adw_toast_overlay(&self) -> AdwToastOverlay* {
        return ADW_TOAST_OVERLAY(self.handle);
    }

    fn set_child(&self, child: &Handler<GtkWidget>) {
        adw_toast_overlay_set_child(self.get_adw_toast_overlay(), child.get_handle());
    }

    fn dismiss_all(&self) {
        adw_toast_overlay_dismiss_all(self.get_adw_toast_overlay());
    }
}