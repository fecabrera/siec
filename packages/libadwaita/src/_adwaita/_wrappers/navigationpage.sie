import { GtkWidget, Handler } from gtk;
import {
    AdwNavigationPage,
    ADW_NAVIGATION_PAGE,
    adw_navigation_page_new,
    adw_navigation_page_new_with_tag,
    adw_navigation_page_set_child,
    adw_navigation_page_set_tag,
    adw_navigation_page_set_title,
} from _adwaita._bindings;

struct NavigationPage: Handler<AdwNavigationPage> {
    @private handle: AdwNavigationPage*;

    fn init(&self, handle: AdwNavigationPage*) {
        self.handle = handle;
    }

    fn init(&self, child: &Handler<GtkWidget>, title: const &char[]) {
        self.handle = adw_navigation_page_new(child.get_handle(), title);
    }

    fn init(&self, child: &Handler<GtkWidget>, title: const &char[], tag: const &char[]) {
        self.handle = adw_navigation_page_new_with_tag(child.get_handle(), title, tag);
    }

    fn get_handle(&self) -> AdwNavigationPage* {
        return self.handle;
    }

    fn get_const_handle(const &self) -> const AdwNavigationPage* {
        return self.handle;
    }

    fn set_child(&self, child: &Handler<GtkWidget>) {
        adw_navigation_page_set_child(self.handle, child.get_handle());
    }

    fn set_tag(&self, tag: const &char[]) {
        adw_navigation_page_set_tag(self.handle, tag);
    }

    fn set_title(&self, title: const &char[]) {
        adw_navigation_page_set_title(self.handle, title);
    }
}