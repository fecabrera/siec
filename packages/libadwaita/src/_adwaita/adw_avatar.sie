import { gboolean } from glib;
import { GtkWidget } from gtk_bindings;
import { GType, G_TYPE_CHECK_INSTANCE_CAST, G_TYPE_CHECK_INSTANCE_TYPE } from gobject;

@macro ADW_TYPE_AVATAR = adw_avatar_get_type();
@macro ADW_AVATAR(obj) = G_TYPE_CHECK_INSTANCE_CAST<AdwAvatar>(obj, ADW_TYPE_AVATAR);
@macro ADW_IS_AVATAR(obj) = G_TYPE_CHECK_INSTANCE_TYPE(obj, ADW_TYPE_AVATAR);

struct AdwAvatar {
    parent_instance: GtkWidget;
}

@extern fn adw_avatar_get_type() -> GType;
@extern fn adw_avatar_new(size: i32,
                          text: const char*,
                          show_initials: gboolean) -> GtkWidget*;
@extern fn adw_avatar_get_icon_name(avatar: AdwAvatar*) -> const char*;
@extern fn adw_avatar_set_icon_name(avatar: AdwAvatar*,
                                    icon_name: const char *);
@extern fn adw_avatar_get_text(avatar: AdwAvatar*) -> const char*;
@extern fn adw_avatar_set_text(avatar: AdwAvatar*,
                               text: const char*);
@extern fn adw_avatar_get_show_initials(avatar: AdwAvatar*) -> gboolean;
@extern fn adw_avatar_set_show_initials(avatar: AdwAvatar*,
                                        show_initials: gboolean);
// @extern fn adw_avatar_get_custom_image(avatar: AdwAvatar*) -> GdkPaintable*;
// @extern fn adw_avatar_set_custom_image(avatar: AdwAvatar*,
//                                        custom_image: GdkPaintable*);
@extern fn adw_avatar_get_size(avatar: AdwAvatar*) -> i32;
@extern fn adw_avatar_set_size(avatar: AdwAvatar*,
                               size: i32);
// @extern fn adw_avatar_draw_to_texture(avatar: AdwAvatar*,
//                                       scale_factor: i32) -> GdkTexture*;
