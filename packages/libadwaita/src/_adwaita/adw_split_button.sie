import { GtkWidget, GtkPopover, GtkArrowType } from gtk_bindings;
import { gboolean } from glib;
import { GType, G_TYPE_CHECK_INSTANCE_CAST, G_TYPE_CHECK_INSTANCE_TYPE } from gobject;
import { GMenuModel } from gio;

@macro ADW_TYPE_SPLIT_BUTTON = adw_split_button_get_type();
@macro ADW_SPLIT_BUTTON(obj) = G_TYPE_CHECK_INSTANCE_CAST<AdwSplitButton>(obj, ADW_TYPE_SPLIT_BUTTON);
@macro ADW_IS_SPLIT_BUTTON(obj) = G_TYPE_CHECK_INSTANCE_TYPE(obj, ADW_TYPE_SPLIT_BUTTON);

struct AdwSplitButton {
    parent_instance: GtkWidget;
}

@extern fn adw_split_button_get_type() -> GType;
@extern fn adw_split_button_new() -> GtkWidget*;
@extern fn adw_split_button_get_label(split_button: AdwSplitButton*) -> const char*;
@extern fn adw_split_button_set_label(split_button: AdwSplitButton*,
                                      label: const char*);
@extern fn adw_split_button_get_use_underline(split_button: AdwSplitButton*) -> gboolean;
@extern fn adw_split_button_set_use_underline(split_button: AdwSplitButton*,
                                              use_underline: gboolean);
@extern fn adw_split_button_get_icon_name(split_button: AdwSplitButton*) -> const char*;
@extern fn adw_split_button_set_icon_name(split_button: AdwSplitButton*,
                                          icon_name: const char*);
@extern fn adw_split_button_get_child(split_button: AdwSplitButton*) -> GtkWidget*;
@extern fn adw_split_button_set_child(split_button: AdwSplitButton*,
                                      child: GtkWidget*);
@extern fn adw_split_button_get_can_shrink(split_button: AdwSplitButton*) -> gboolean;
@extern fn adw_split_button_set_can_shrink(split_button: AdwSplitButton*,
                                           can_shrink: gboolean);
@extern fn adw_split_button_get_menu_model(split_button: AdwSplitButton*) -> GMenuModel*;
@extern fn adw_split_button_set_menu_model(split_button: AdwSplitButton*,
                                           menu_model: GMenuModel*);
@extern fn adw_split_button_get_popover(split_button: AdwSplitButton*) -> GtkPopover*;
@extern fn adw_split_button_set_popover(split_button: AdwSplitButton*,
                                        popover: GtkPopover*);
@extern fn adw_split_button_get_direction(split_button: AdwSplitButton*) -> GtkArrowType;
@extern fn adw_split_button_set_direction(split_button: AdwSplitButton*,
                                          direction: GtkArrowType);
@extern fn adw_split_button_get_dropdown_tooltip(split_button: AdwSplitButton*) -> const char*;
@extern fn adw_split_button_set_dropdown_tooltip(split_button: AdwSplitButton*,
                                                 tooltip: const char*);
@extern fn adw_split_button_popup(split_button: AdwSplitButton*);
@extern fn adw_split_button_popdown(split_button: AdwSplitButton*);