import { GtkWidget } from gtk_bindings;
import { GType, G_TYPE_CHECK_INSTANCE_CAST, G_TYPE_CHECK_INSTANCE_TYPE } from gobject;
import { gboolean } from glib;

@macro ADW_TYPE_WINDOW = adw_window_get_type();
@macro ADW_WINDOW(obj) = G_TYPE_CHECK_INSTANCE_CAST<AdwWindow>(obj, ADW_TYPE_WINDOW);
@macro ADW_IS_WINDOW(obj) = G_TYPE_CHECK_INSTANCE_TYPE(obj, ADW_TYPE_WINDOW);

struct AdwWindow {
    parent_instance: GtkWidget;
}

@extern fn adw_window_get_type() -> GType;
@extern fn adw_window_new() -> GtkWidget*;

@extern fn adw_window_get_content(window: AdwWindow*) -> GtkWidget*;
@extern fn adw_window_set_content(window: AdwWindow*,
                                  content: GtkWidget*);

@extern fn adw_window_get_adaptive_preview(window: AdwWindow*) -> gboolean;
@extern fn adw_window_set_adaptive_preview(window: AdwWindow*,
                                           adpative_preview: gboolean);
