import { GtkWidget, GtkSelectionModel } from gtk;
import { gboolean } from glib;
import { GObject } from gobject;
import { GIcon, GMenuModel } from gio;
import { GType, G_TYPE_CHECK_INSTANCE_CAST, G_TYPE_CHECK_INSTANCE_TYPE } from gobject;

@macro ADW_TYPE_TAB_PAGE = adw_tab_page_get_type();
@macro ADW_TAB_PAGE(obj) = G_TYPE_CHECK_INSTANCE_CAST<AdwTabPage>(obj, ADW_TYPE_TAB_PAGE);
@macro ADW_IS_TAB_PAGE(obj) = G_TYPE_CHECK_INSTANCE_TYPE(obj, ADW_TYPE_TAB_PAGE);

enum AdwTabViewShortcuts {
    NONE                    = 0,
    CONTROL_TAB             = 1 << 0,
    CONTROL_SHIFT_TAB       = 1 << 1,
    CONTROL_PAGE_UP         = 1 << 2,
    CONTROL_PAGE_DOWN       = 1 << 3,
    CONTROL_HOME            = 1 << 4,
    CONTROL_END             = 1 << 5,
    CONTROL_SHIFT_PAGE_UP   = 1 << 6,
    CONTROL_SHIFT_PAGE_DOWN = 1 << 7,
    CONTROL_SHIFT_HOME      = 1 << 8,
    CONTROL_SHIFT_END       = 1 << 9,
    ALT_DIGITS              = 1 << 10,
    ALT_ZERO                = 1 << 11,
    ALL_SHORTCUTS           = 0xFFF,
}

struct AdwTabPage {
    parent_instance: GObject;
}

@extern fn adw_tab_page_get_type() -> GType;
@extern fn adw_tab_page_get_child(tab_page: AdwTabPage*) -> GtkWidget*;
@extern fn adw_tab_page_get_parent(tab_page: AdwTabPage*) -> AdwTabPage*;
@extern fn adw_tab_page_get_selected(tab_page: AdwTabPage*) -> gboolean;
@extern fn adw_tab_page_get_pinned(tab_page: AdwTabPage*) -> gboolean;
@extern fn adw_tab_page_get_title(tab_page: AdwTabPage*) -> const char*;
@extern fn adw_tab_page_set_title(tab_page: AdwTabPage*,
                                  title: const char*);
@extern fn adw_tab_page_get_tooltip(tab_page: AdwTabPage*) -> const char*;
@extern fn adw_tab_page_set_tooltip(tab_page: AdwTabPage*,
                                    tooltip: const char*);
@extern fn adw_tab_page_get_icon(tab_page: AdwTabPage*) -> GIcon*;
@extern fn adw_tab_page_set_icon(tab_page: AdwTabPage*,
                                 icon: GIcon*);
@extern fn adw_tab_page_get_loading(tab_page: AdwTabPage*) -> gboolean;
@extern fn adw_tab_page_set_loading(tab_page: AdwTabPage*,
                                    loading: gboolean);
@extern fn adw_tab_page_get_indicator_icon(tab_page: AdwTabPage*) -> GIcon*;
@extern fn adw_tab_page_set_indicator_icon(tab_page: AdwTabPage*,
                                           indicator_icon: GIcon*);
@extern fn adw_tab_page_get_indicator_tooltip(tab_page: AdwTabPage*) -> const char*;
@extern fn adw_tab_page_set_indicator_tooltip(tab_page: AdwTabPage*,
                                              tooltip: const char*);
@extern fn adw_tab_page_get_indicator_activatable(tab_page: AdwTabPage*) -> gboolean;
@extern fn adw_tab_page_set_indicator_activatable(tab_page: AdwTabPage*,
                                                  activatable: gboolean);
@extern fn adw_tab_page_get_needs_attention(tab_page: AdwTabPage*) -> gboolean;
@extern fn adw_tab_page_set_needs_attention(tab_page: AdwTabPage*,
                                            needs_attention: gboolean);
@extern fn adw_tab_page_get_keyword(tab_page: AdwTabPage*) -> const char *;
@extern fn adw_tab_page_set_keyword(tab_page: AdwTabPage*,
                                    keyword: const char*);
@extern fn adw_tab_page_get_thumbnail_xalign(tab_page: AdwTabPage*) -> f32;
@extern fn adw_tab_page_set_thumbnail_xalign(tab_page: AdwTabPage*,
                                             xalign: f32);
@extern fn adw_tab_page_get_thumbnail_yalign(tab_page: AdwTabPage*) -> f32;
@extern fn adw_tab_page_set_thumbnail_yalign(tab_page: AdwTabPage*,
                                             yalign: f32);
@extern fn adw_tab_page_get_live_thumbnail(tab_page: AdwTabPage*) -> gboolean;
@extern fn adw_tab_page_set_live_thumbnail(tab_page: AdwTabPage*,
                                           live_thumbnail: gboolean);
@extern fn adw_tab_page_invalidate_thumbnail(tab_page: AdwTabPage*);

@macro ADW_TYPE_TAB_VIEW = adw_tab_view_get_type();
@macro ADW_TAB_VIEW(obj) = G_TYPE_CHECK_INSTANCE_CAST<AdwTabView>(obj, ADW_TYPE_TAB_VIEW);
@macro ADW_IS_TAB_VIEW(obj) = G_TYPE_CHECK_INSTANCE_TYPE(obj, ADW_TYPE_TAB_VIEW);

struct AdwTabView {
    parent_instance: GtkWidget;
}

@extern fn adw_tab_page_get_type() -> GType;
@extern fn adw_tab_view_new() -> AdwTabView*;
@extern fn adw_tab_view_get_n_pages(tab_view: AdwTabView*) -> i32;
@extern fn adw_tab_view_get_n_pinned_pages(tab_view: AdwTabView*) -> i32;
@extern fn adw_tab_view_get_is_transferring_page(tab_view: AdwTabView*) -> gboolean;
@extern fn adw_tab_view_get_selected_page(tab_view: AdwTabView*) -> AdwTabPage*;
@extern fn adw_tab_view_set_selected_page(tab_view: AdwTabView*,
                                          selected_page: AdwTabPage*);
@extern fn adw_tab_view_select_previous_page(tab_view: AdwTabView*) -> gboolean;
@extern fn adw_tab_view_select_next_page(tab_view: AdwTabView*) -> gboolean;
@extern fn adw_tab_view_get_default_icon(tab_view: AdwTabView*) -> GIcon*;
@extern fn adw_tab_view_set_default_icon(tab_view: AdwTabView*,
                                         default_icon: GIcon*);
@extern fn adw_tab_view_get_menu_model(tab_view: AdwTabView*) -> GMenuModel*;
@extern fn adw_tab_view_set_menu_model(tab_view: AdwTabView*,
                                       menu_model: GMenuModel*);
@extern fn adw_tab_view_get_shortcuts(tab_view: AdwTabView*) -> AdwTabViewShortcuts;
@extern fn adw_tab_view_set_shortcuts(tab_view: AdwTabView*,
                                      shortcuts: AdwTabViewShortcuts);
@extern fn adw_tab_view_add_shortcuts(tab_view: AdwTabView*,
                                      shortcuts: AdwTabViewShortcuts);
@extern fn adw_tab_view_remove_shortcuts(tab_view: AdwTabView*,
                                         shortcuts: AdwTabViewShortcuts);
@extern fn adw_tab_view_set_page_pinned(tab_view: AdwTabView*,
                                        page: AdwTabPage*,
                                        pinned: gboolean);
@extern fn adw_tab_view_get_page(tab_view: AdwTabView*,
                                 child: GtkWidget*) -> AdwTabPage*;
@extern fn adw_tab_view_get_nth_page(tab_view: AdwTabView*,
                                     position: i32) -> AdwTabPage*;
@extern fn adw_tab_view_get_page_position(tab_view: AdwTabView*,
                                          page: AdwTabPage*) -> i32;
@extern fn adw_tab_view_add_page(tab_view: AdwTabView*,
                                 child: GtkWidget*,
                                 parent: AdwTabPage*) -> AdwTabPage*;
@extern fn adw_tab_view_insert(tab_view: AdwTabView*,
                               child: GtkWidget*,
                               position: i32) -> AdwTabPage*;
@extern fn adw_tab_view_prepend(tab_view: AdwTabView*,
                                child: GtkWidget*) -> AdwTabPage*;
@extern fn adw_tab_view_append(tab_view: AdwTabView*,
                               child: GtkWidget*) -> AdwTabPage*;
@extern fn adw_tab_view_insert_pinned(tab_view: AdwTabView*,
                                      child: GtkWidget*,
                                      position: i32) -> AdwTabPage*;
@extern fn adw_tab_view_prepend_pinned(tab_view: AdwTabView*,
                                       child: GtkWidget*) -> AdwTabPage*;
@extern fn adw_tab_view_append_pinned(tab_view: AdwTabView*,
                                      child: GtkWidget*) -> AdwTabPage*;
@extern fn adw_tab_view_close_page(tab_view: AdwTabView*,
                                   page: AdwTabPage*);
@extern fn adw_tab_view_close_page_finish(tab_view: AdwTabView*,
                                          page: AdwTabPage*,
                                          confirm: gboolean);
@extern fn adw_tab_view_close_other_pages(tab_view: AdwTabView*,
                                          page: AdwTabPage*);
@extern fn adw_tab_view_close_pages_before(tab_view: AdwTabView*,
                                           page: AdwTabPage*);
@extern fn adw_tab_view_close_pages_after(tab_view: AdwTabView*,
                                          page: AdwTabPage*);
@extern fn adw_tab_view_reorder_page(tab_view: AdwTabView*,
                                     page: AdwTabPage*,
                                     position: i32) -> gboolean;
@extern fn adw_tab_view_reorder_backward(tab_view: AdwTabView*,
                                         page: AdwTabPage*) -> gboolean;
@extern fn adw_tab_view_reorder_forward(tab_view: AdwTabView*,
                                        page: AdwTabPage*) -> gboolean;
@extern fn adw_tab_view_reorder_first(tab_view: AdwTabView*,
                                      page: AdwTabPage*) -> gboolean;
@extern fn adw_tab_view_reorder_last(tab_view: AdwTabView*,
                                     page: AdwTabPage*) -> gboolean;
@extern fn adw_tab_view_transfer_page(tab_view: AdwTabView*,
                                      page: AdwTabPage*,
                                      other_view: AdwTabView*,
                                      position: i32);
@extern fn adw_tab_view_get_pages(tab_view: AdwTabView*) -> GtkSelectionModel*;
@extern fn adw_tab_view_invalidate_thumbnails(tab_view: AdwTabView*);