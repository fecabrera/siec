import { GtkWidget } from gtk;
import { GType, G_TYPE_CHECK_INSTANCE_CAST, G_TYPE_CHECK_INSTANCE_TYPE } from gobject;

@macro ADW_TYPE_WINDOW_TITLE = adw_window_title_get_type();
@macro ADW_WINDOW_TITLE(obj) = G_TYPE_CHECK_INSTANCE_CAST<AdwWindowTitle>(obj, ADW_TYPE_WINDOW_TITLE);
@macro ADW_IS_WINDOW_TITLE(obj) = G_TYPE_CHECK_INSTANCE_TYPE(obj, ADW_TYPE_WINDOW_TITLE);

struct AdwWindowTitle {
    parent_instance: GtkWidget;
}

@extern fn adw_window_title_get_type() -> GType;
@extern fn adw_window_title_new(title: const char*,
                                subtitle: const char*) -> GtkWidget*;
@extern fn adw_window_title_get_title(window_title: AdwWindowTitle*) -> const char*;
@extern fn adw_window_title_set_title(window_title: AdwWindowTitle*,
                                      title: const char*);
@extern fn adw_window_title_get_subtitle(window_title: AdwWindowTitle*) -> const char*;
@extern fn adw_window_title_set_subtitle(window_title: AdwWindowTitle*,
                                         subtitle: const char*);
