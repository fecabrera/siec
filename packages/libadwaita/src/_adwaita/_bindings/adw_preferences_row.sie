import { GtkWidget } from gtk;
import { gboolean } from glib;
import { GType, G_TYPE_CHECK_INSTANCE_CAST, G_TYPE_CHECK_INSTANCE_TYPE } from gobject;

@macro ADW_TYPE_PREFERENCES_ROW = adw_preferences_row_get_type();
@macro ADW_PREFERENCES_ROW(obj) = G_TYPE_CHECK_INSTANCE_CAST<AdwSplitButton>(obj, ADW_TYPE_PREFERENCES_ROW);
@macro ADW_IS_PREFERENCES_ROW(obj) = G_TYPE_CHECK_INSTANCE_TYPE(obj, ADW_TYPE_PREFERENCES_ROW);

struct AdwPreferencesRow;

@extern fn adw_preferences_row_get_type() -> GType;
@extern fn adw_preferences_row_new() -> GtkWidget*;
@extern fn adw_preferences_row_get_title(row: AdwPreferencesRow*) -> const char*;
@extern fn adw_preferences_row_set_title(row: AdwPreferencesRow*,
                                         title: const char*);
@extern fn adw_preferences_row_get_use_underline(row: AdwPreferencesRow*) -> gboolean;
@extern fn adw_preferences_row_set_use_underline(row: AdwPreferencesRow*,
                                                 use_underline: gboolean);
@extern fn adw_preferences_row_get_title_selectable(row: AdwPreferencesRow*) -> gboolean;
@extern fn adw_preferences_row_set_title_selectable(row: AdwPreferencesRow*,
                                                    title_selectable: gboolean);
@extern fn adw_preferences_row_get_use_markup(row: AdwPreferencesRow*) -> gboolean;
@extern fn adw_preferences_row_set_use_markup(row: AdwPreferencesRow*,
                                              use_markup: gboolean);