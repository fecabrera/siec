import { GtkWidget } from gtk;
import { gboolean } from glib;
import { GType, G_TYPE_CHECK_INSTANCE_CAST, G_TYPE_CHECK_INSTANCE_TYPE } from gobject;

@macro ADW_TYPE_BUTTON_ROW = adw_button_row_get_type();
@macro ADW_BUTTON_ROW(obj) = G_TYPE_CHECK_INSTANCE_CAST<AdwButtonRow>(obj, ADW_TYPE_BUTTON_ROW);
@macro ADW_IS_BUTTON_ROW(obj) = G_TYPE_CHECK_INSTANCE_TYPE(obj, ADW_TYPE_BUTTON_ROW);

struct AdwButtonRow;

@extern fn adw_button_row_get_type() -> GType;
@extern fn adw_button_row_new() -> GtkWidget*;
@extern fn adw_button_row_get_start_icon_name(button_row: AdwButtonRow*) -> const char*;
@extern fn adw_button_row_set_start_icon_name(button_row: AdwButtonRow*,
                                              icon_name: const char*);
@extern fn adw_button_row_get_end_icon_name(button_row: AdwButtonRow*) -> const char*;
@extern fn adw_button_row_set_end_icon_name(button_row: AdwButtonRow*,
                                            icon_name: const char*);