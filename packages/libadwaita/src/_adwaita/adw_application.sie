import { GtkApplication } from gtk_bindings;
import { GApplicationFlags } from gio;
import { GType, G_TYPE_CHECK_INSTANCE_CAST, G_TYPE_CHECK_INSTANCE_TYPE } from gobject;

@macro ADW_TYPE_APPLICATION = adw_application_get_type();
@macro ADW_APPLICATION(obj) = G_TYPE_CHECK_INSTANCE_CAST<AdwApplication>(obj, ADW_TYPE_APPLICATION);
@macro ADW_IS_APPLICATION(obj) = G_TYPE_CHECK_INSTANCE_TYPE(obj, ADW_TYPE_APPLICATION);

struct AdwApplication {
    parent_instance: GtkApplication;
}

@extern fn adw_application_get_type() -> GType;
@extern fn adw_application_new(application_id: const char*,
                               flags: GApplicationFlags) -> AdwApplication*;